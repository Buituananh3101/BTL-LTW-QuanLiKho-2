flowchart LR
    subgraph Client ["1. Thủ kho / Giao diện người dùng (Client UI)"]
        direction TB
        A1([Bắt đầu: Lập phiếu nhập]) --> A2["Mở form 'Tạo phiếu nhập hàng'"]
        A2 --> A3["Chọn Nhà cung cấp & Chi nhánh kho đích"]
        A3 --> A4["F3 Tìm kiếm hàng hóa, nhập SL & Đơn giá"]
        A4 --> A5["Bấm nút 'Hoàn thành'"]
        A7["Hiển thị thông báo thành công<br>& Điều hướng về danh sách chứng từ"] --> A8([Kết thúc: Nhập hàng thành công])
    end

    subgraph Server ["2. Web App & CSDL (Backend Logic & Database)"]
        direction TB
        B1["Nhận Request POST Create"] --> B2{"Kiểm tra tính hợp lệ?<br>(Có NCC, Chi tiết >= 1 dòng, SL > 0)"}
        B2 -- Không hợp lệ --> B3["Trả về thông báo lỗi Validation"]
        B2 -- Hợp lệ --> B4["Mở Transaction CSDL<br>(BeginTransactionAsync)"]
        B4 --> B5["Tính lại Giá vốn bình quân MAC:<br>GiaVonMoi = (TonCu*GiaCu + SL*GiaNhap) / (TonCu + SL)"]
        
        subgraph DB ["Ghi nhận dữ liệu & Tồn kho trong Transaction"]
            direction TB
            C1[("Master-Detail: Lưu PhieuNhap<br>& ChiTietPhieuNhap (DA_XAC_NHAN)")]
            C2[("Cập nhật Giá vốn mới<br>vào bảng HangHoa")]
            C3[("Tăng số lượng tồn kho<br>ghi nhận qua View vw_TonKhoHienTai")]
            C4[("Cập nhật Công nợ phải trả<br>bảng DonViCapHang")]
            C5[("Ghi Nhật ký thao tác kiểm toán<br>vào bảng NhatKyThaoTac")]
            C1 --> C2 --> C3 --> C4 --> C5
        end
        
        B5 --> DB
        DB --> B6["Commit Transaction & Khóa chứng từ vĩnh viễn"]
    end

    %% Luồng liên kết giữa Thủ kho và Backend
    A5 --> B1
    B3 --> A4
    B6 --> A7
