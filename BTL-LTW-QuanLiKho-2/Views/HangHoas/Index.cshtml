@model IEnumerable<BTL_LTW_QuanLiKho_2.Models.HangHoa>
@{ ViewData["Title"] = "Hàng hóa"; }
<main class="goods-page container-fluid px-4">
    <div class="goods-heading"><div><div class="goods-eyebrow">DANH MỤC / HÀNG HÓA</div><h1>Quản lý hàng hóa</h1><p>Tra cứu và quản lý danh mục hàng hóa của chi nhánh.</p></div><a class="btn btn-primary" asp-action="Create">+ Thêm hàng hóa</a></div>
    <div class="goods-stats"><div><span>Tổng mặt hàng</span><strong>@ViewBag.Total</strong></div><div><span>Đang bán</span><strong class="text-success">@ViewBag.Active</strong></div><div><span>Kết quả tìm kiếm</span><strong class="text-primary">@ViewBag.Count</strong></div></div>
    @if (TempData["Success"] is string message) { <div class="alert alert-success" role="status">@message</div> }
    <section class="card goods-card">
        <div class="card-header">Danh sách hàng hóa</div>
        <form method="get" asp-action="Index" class="goods-filters">
            <div class="goods-search"><label for="q">Tìm hàng hóa</label><input id="q" name="q" value="@ViewBag.Q" class="form-control" placeholder="Nhập mã hoặc tên hàng…" /></div>
            <div><label for="nhom">Nhóm hàng</label><select id="nhom" name="nhom" class="form-select"><option value="">Tất cả nhóm</option>@foreach (var x in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.NhomHang) { <option value="@x.Value" selected="@(x.Value == Convert.ToString(ViewBag.Nhom))">@x.Text</option> }</select></div>
            <div><label for="trangThai">Trạng thái</label><select id="trangThai" name="trangThai" class="form-select"><option value="">Tất cả trạng thái</option>@foreach (var x in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.States) { <option value="@x.Value" selected="@(x.Value == (string?)ViewBag.TrangThai)">@x.Text</option> }</select></div>
            <button class="btn btn-primary" type="submit">Lọc</button><a class="btn btn-outline-secondary" asp-action="Index">Đặt lại</a>
        </form>
        <div class="table-responsive"><table class="table goods-table align-middle mb-0"><thead><tr><th>Mã hàng</th><th>Hàng hóa</th><th>Nhóm hàng</th><th>Đơn vị</th><th class="text-end">Giá tham khảo</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
        @foreach (var item in Model) {
            <tr><td><span class="goods-code">@item.MaHangNoiBo</span></td><td><a class="goods-name" asp-action="Details" asp-route-id="@item.MaHang">@item.TenHang</a><small class="d-block text-muted">@(string.IsNullOrWhiteSpace(item.QuyCach) ? "—" : item.QuyCach)</small></td><td>@item.MaNhomNavigation?.TenNhom</td><td>@item.MaDvtNavigation?.TenDvt</td><td class="text-end text-nowrap">@item.GiaBanThamKhao.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</td><td><span class="goods-status @(item.TrangThai == "DANG_BAN" ? "is-active" : "is-inactive")">@(item.TrangThai == "DANG_BAN" ? "Đang bán" : item.TrangThai == "NGUNG_BAN" ? "Ngừng bán" : item.TrangThai)</span></td><td><div class="goods-actions"><a asp-action="Details" asp-route-id="@item.MaHang" class="btn btn-sm btn-outline-secondary">Xem</a><a asp-action="Edit" asp-route-id="@item.MaHang" class="btn btn-sm btn-outline-primary">Sửa</a><a asp-action="Delete" asp-route-id="@item.MaHang" class="btn btn-sm btn-outline-danger">Xóa</a></div></td></tr>
        }
        @if (!Model.Any()) { <tr><td colspan="7" class="text-center py-5 text-muted">Không tìm thấy hàng hóa. Thử đổi bộ lọc hoặc thêm hàng hóa mới.</td></tr> }
        </tbody></table></div>
        <div class="goods-pagination"><span>@ViewBag.Count kết quả · Trang @ViewBag.Page / @ViewBag.Pages</span><div>
        @if (ViewBag.Page > 1) { <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-page="@(ViewBag.Page - 1)" asp-route-q="@ViewBag.Q" asp-route-nhom="@ViewBag.Nhom" asp-route-trangThai="@ViewBag.TrangThai">← Trước</a> }
        @if (ViewBag.Page < ViewBag.Pages) { <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-page="@(ViewBag.Page + 1)" asp-route-q="@ViewBag.Q" asp-route-nhom="@ViewBag.Nhom" asp-route-trangThai="@ViewBag.TrangThai">Sau →</a> }
        </div></div>
    </section>
</main>
