@model BTL_LTW_QuanLiKho_2.ViewModels.HangHoaIndexVM

<table class="tbl" id="productTable">
    <thead>
        <tr>
            <th style="width: 34px;" class="text-center">
                <input class="form-check-input" type="checkbox" id="selectAllRows" />
            </th>
            <th style="width: 30px;" class="text-center text-muted">☆</th>
            <th style="width: 44px;" class="text-center">Ảnh</th>
            <th style="width: 130px;">Mã hàng</th>
            <th>Tên hàng</th>
            <th class="num" style="width: 110px;">Giá bán</th>
            <th class="num" style="width: 110px;">Giá vốn</th>
            <th class="num" style="width: 90px;">Tồn kho</th>
            <th class="num" style="width: 90px;">Khách đặt</th>
            <th style="width: 135px;">Thời gian tạo</th>
            <th style="width: 120px;">Dự kiến hết hàng</th>
        </tr>
        <!-- Dòng tổng hợp (Summary row) chuẩn như ảnh KiotViet -->
        <tr class="summary-row">
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td class="num"></td>
            <td class="num"></td>
            <td class="num fw-bold text-dark">@Model.TotalStockSum.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</td>
            <td class="num fw-bold text-dark">@Model.TotalKhachDatSum</td>
            <td class="text-muted">---</td>
            <td class="text-muted">---</td>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Any())
        {
            @foreach (var item in Model.Items)
            {
                <tr data-id="@item.MaHang">
                    <td class="text-center">
                        <input class="form-check-input row-select" type="checkbox" value="@item.MaHang" />
                    </td>
                    <td class="text-center text-muted" style="cursor: pointer;">☆</td>
                    <td class="text-center p-1">
                        <div class="product-img-wrapper" title="@item.TenHang">
                            <img src="/HangHoas/GetImage/@item.MaHang" class="product-thumb-img" alt="@item.TenHang" />
                            @if (item.HasImage)
                            {
                                <div class="product-img-popover">
                                    <img src="/HangHoas/GetImage/@item.MaHang" alt="@item.TenHang" />
                                </div>
                            }
                        </div>
                    </td>
                    <td>
                        <a href="javascript:void(0)" class="fw-semibold text-primary text-decoration-none btn-edit-product" data-id="@item.MaHang">
                            @item.MaHangNoiBo
                        </a>
                    </td>
                    <td>
                        <div class="fw-semibold text-dark">@item.TenHang</div>
                        @if (!string.IsNullOrWhiteSpace(item.QuyCach))
                        {
                            <small class="text-muted d-block">@item.QuyCach</small>
                        }
                    </td>
                    <td class="num text-dark">
                        @item.GiaBan.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))
                    </td>
                    <td class="num text-muted">
                        @item.GiaVon.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))
                    </td>
                    <td class="num">
                        @if (item.TonKho <= 0)
                        {
                            <span class="text-danger fw-bold">0</span>
                        }
                        else if (item.TonToiThieu.HasValue && item.TonKho < item.TonToiThieu.Value)
                        {
                            <span class="text-danger fw-bold" title="Dưới định mức tồn">
                                @item.TonKho.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ⚠️
                            </span>
                        }
                        else
                        {
                            <span>@item.TonKho.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</span>
                        }
                    </td>
                    <td class="num text-muted">
                        @item.KhachDat
                    </td>
                    <td class="text-muted small">
                        @(item.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "---")
                    </td>
                    <td class="text-muted small">
                        @item.DuKienHetHang
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="11" class="p-0">
                    <div class="empty d-block">
                        <div class="ico"><i class="bi bi-box-seam"></i></div>
                        <h5>Không tìm thấy hàng hóa</h5>
                        <p class="text-muted mb-0">Không tìm thấy hàng hóa nào phù hợp với bộ lọc hiện tại.<br />Thử thay đổi từ khóa hoặc bộ lọc nhóm hàng.</p>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Phân trang đáy bảng -->
<div class="d-flex justify-content-between align-items-center p-3 border-top bg-light">
    <div class="text-muted small">
        Hiển thị <strong>@Model.Items.Count</strong> / <strong>@Model.TotalCount</strong> hàng hóa · Trang <strong>@Model.Page</strong> / <strong>@Model.TotalPages</strong>
    </div>

    @if (Model.TotalPages > 1)
    {
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link page-ajax" href="javascript:void(0)" data-page="@(Model.Page - 1)">« Trước</a>
            </li>

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                if (p == 1 || p == Model.TotalPages || (p >= Model.Page - 2 && p <= Model.Page + 2))
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link page-ajax" href="javascript:void(0)" data-page="@p">@p</a>
                    </li>
                }
                else if (p == Model.Page - 3 || p == Model.Page + 3)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link page-ajax" href="javascript:void(0)" data-page="@(Model.Page + 1)">Sau »</a>
            </li>
        </ul>
    }
</div>
