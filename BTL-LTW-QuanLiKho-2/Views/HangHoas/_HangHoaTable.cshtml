@model BTL_LTW_QuanLiKho_2.ViewModels.HangHoaIndexVM

<table class="tbl" id="productTable">
    <thead>
        <tr>
            <th style="width: 36px;" class="text-center">
                <input class="form-check-input" type="checkbox" id="selectAllRows" />
            </th>
            <th style="width: 34px;" class="text-center">☆</th>
            <th style="width: 120px;">Mã hàng</th>
            <th>Tên hàng</th>
            <th class="num" style="width: 120px;">Giá bán</th>
            <th class="num" style="width: 120px;">Giá vốn</th>
            <th class="num" style="width: 100px;">Tồn kho</th>
            <th style="width: 90px;">ĐVT</th>
            <th style="width: 140px;">Nhóm hàng</th>
            <th style="width: 110px;">Trạng thái</th>
            <th style="width: 100px;" class="text-end">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Any())
        {
            @foreach (var item in Model.Items)
            {
                <tr data-id="@item.MaHang">
                    <td class="text-center">
                        <input class="form-check-input row-select" type="checkbox" value="@item.MaHang" />
                    </td>
                    <td class="text-center text-muted" style="cursor: pointer;">☆</td>
                    <td>
                        <a href="javascript:void(0)" class="fw-bold text-decoration-none btn-edit-product" data-id="@item.MaHang">
                            @item.MaHangNoiBo
                        </a>
                    </td>
                    <td>
                        <div class="fw-semibold text-dark">@item.TenHang</div>
                        @if (!string.IsNullOrWhiteSpace(item.QuyCach))
                        {
                            <small class="text-muted d-block">@item.QuyCach</small>
                        }
                    </td>
                    <td class="num fw-semibold text-dark">
                        @item.GiaBan.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ
                    </td>
                    <td class="num text-muted">
                        @item.GiaVon.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ
                    </td>
                    <td class="num">
                        @if (item.TonKho <= 0)
                        {
                            <span class="badge-soft b-danger fw-bold">0</span>
                        }
                        else if (item.TonToiThieu.HasValue && item.TonKho < item.TonToiThieu.Value)
                        {
                            <span class="badge-soft b-danger fw-bold" title="Dưới định mức tối thiểu (@item.TonToiThieu)">
                                @item.TonKho.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ⚠️
                            </span>
                        }
                        else
                        {
                            <span class="fw-bold text-primary">
                                @item.TonKho.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))
                            </span>
                        }
                    </td>
                    <td>@item.TenDvt</td>
                    <td><span class="badge bg-light text-dark border">@item.TenNhom</span></td>
                    <td>
                        @if (item.TrangThai == "DANG_BAN")
                        {
                            <span class="badge-soft b-ok">Đang bán</span>
                        }
                        else
                        {
                            <span class="badge-soft b-draft">Ngừng bán</span>
                        }
                    </td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 btn-edit-product" data-id="@item.MaHang" title="Sửa">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 btn-delete-product" data-id="@item.MaHang" data-name="@item.TenHang" title="Xóa">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }

            <!-- Dòng tổng kết -->
            <tr class="summary-row">
                <td colspan="4" class="fw-bold text-end">Tổng cộng (@Model.TotalCount mặt hàng):</td>
                <td class="num fw-bold">---</td>
                <td class="num fw-bold">---</td>
                <td class="num fw-bold text-primary">@Model.TotalStockSum.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</td>
                <td colspan="4"></td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="11" class="p-0">
                    <div class="empty d-block">
                        <div class="ico"><i class="bi bi-box-seam"></i></div>
                        <h5>Không tìm thấy hàng hóa</h5>
                        <p class="text-muted mb-0">Không tìm thấy hàng hóa nào phù hợp với bộ lọc hiện tại.<br />Thử thay đổi từ khóa hoặc bộ lọc nhóm hàng.</p>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Phân trang -->
<div class="d-flex justify-content-between align-items-center p-3 border-top bg-light">
    <div class="text-muted small">
        Hiển thị <strong>@Model.Items.Count</strong> / <strong>@Model.TotalCount</strong> hàng hóa · Trang <strong>@Model.Page</strong> / <strong>@Model.TotalPages</strong>
    </div>

    @if (Model.TotalPages > 1)
    {
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link page-ajax" href="javascript:void(0)" data-page="@(Model.Page - 1)">« Trước</a>
            </li>

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                if (p == 1 || p == Model.TotalPages || (p >= Model.Page - 2 && p <= Model.Page + 2))
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link page-ajax" href="javascript:void(0)" data-page="@p">@p</a>
                    </li>
                }
                else if (p == Model.Page - 3 || p == Model.Page + 3)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link page-ajax" href="javascript:void(0)" data-page="@(Model.Page + 1)">Sau »</a>
            </li>
        </ul>
    }
</div>
