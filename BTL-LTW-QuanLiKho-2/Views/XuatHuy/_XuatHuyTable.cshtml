@model BTL_LTW_QuanLiKho_2.ViewModels.XuatHuyIndexVM
@using System.Globalization
@{
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
}

<div class="kiot-table-scroll-body">
    <table class="tbl" id="xuatHuyTable" style="width: max-content; min-width: 1100px;">
        <thead>
            <tr>
                <th style="width: 36px;" class="text-center th-checkbox">
                    <input class="form-check-input" type="checkbox" id="selectAllRows" @(!Model.Items.Any() ? "disabled" : "") />
                </th>
                <th style="width: 36px; cursor: pointer;" class="text-center th-star" onclick="toggleStarHeaderFilter(event)">
                    <span class="star-btn star-header-filter @(Model.DaDanhDauFilter ? "starred" : "")" id="starHeaderFilter" title="@(Model.DaDanhDauFilter ? "Bỏ lọc sao (Hiển thị tất cả)" : "Lọc danh sách phiếu được đánh dấu sao")">
                        <i class="bi @(Model.DaDanhDauFilter ? "bi-star-fill" : "bi-star")"></i>
                    </span>
                </th>
                <th data-col="ma" style="width: 140px;" class="sortable-th @(Model.SortBy == "ma" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Mã xuất hủy">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Mã xuất hủy</span>
                            @if (Model.SortBy == "ma" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "ma" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="gt" style="width: 150px;" class="num r text-end sortable-th @(Model.SortBy == "gt" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Tổng giá trị hủy">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Tổng giá trị hủy</span>
                            @if (Model.SortBy == "gt" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "gt" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tg" style="width: 150px;" class="sortable-th @(Model.SortBy == "tg" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Thời gian">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Thời gian</span>
                            @if (Model.SortBy == "tg" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "tg" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tgt" style="width: 150px; display: none;" class="sortable-th @(Model.SortBy == "tgt" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Thời gian tạo">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Thời gian tạo</span>
                            @if (Model.SortBy == "tgt" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "tgt" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="kho" style="width: 160px;" class="sortable-th @(Model.SortBy == "kho" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Chi nhánh">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Chi nhánh</span>
                            @if (Model.SortBy == "kho" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "kho" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="nxh" style="width: 150px; display: none;" class="sortable-th @(Model.SortBy == "nxh" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Người xuất hủy">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Người xuất hủy</span>
                            @if (Model.SortBy == "nxh" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "nxh" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="nt" style="width: 150px; display: none;" class="sortable-th @(Model.SortBy == "nt" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Người tạo">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Người tạo</span>
                            @if (Model.SortBy == "nt" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "nt" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="ghi" style="width: 200px;" class="sortable-th @(Model.SortBy == "ghi" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Ghi chú">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Ghi chú</span>
                            @if (Model.SortBy == "ghi" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "ghi" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="st" style="width: 130px;" class="sortable-th @(Model.SortBy == "st" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Trạng thái">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Trạng thái</span>
                            @if (Model.SortBy == "st" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "st" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
            </tr>
        </thead>
        <tbody>
            <!-- Dòng tổng hợp (Summary row) cuộn tự nhiên cùng nội dung bảng -->
            <tr class="summary-row">
                <td class="text-center"></td>
                <td class="text-center"></td>
                <td data-col="ma"></td>
                <td data-col="gt" class="num fw-bold text-dark text-end">
                    @Model.Items.Sum(x => x.TongGiaTriHuy).ToString("N0", viCulture)
                </td>
                <td data-col="tg"></td>
                <td data-col="tgt" style="display: none;"></td>
                <td data-col="kho"></td>
                <td data-col="nxh" style="display: none;"></td>
                <td data-col="nt" style="display: none;"></td>
                <td data-col="ghi"></td>
                <td data-col="st"></td>
            </tr>

            @if (!Model.Items.Any())
            {
                <tr class="empty-row">
                    <td colspan="11" class="p-0">
                        <div class="empty d-block py-5 text-center">
                            <div class="ico mb-3"><i class="bi bi-trash fs-1 text-primary"></i></div>
                            <h5 class="fw-bold">Không tìm thấy phiếu xuất hủy</h5>
                            <p class="text-muted mb-0 small">Không tìm thấy giao dịch nào phù hợp với bộ lọc hiện tại.<br />Nhấn <a href="javascript:void(0)" id="resetF" class="text-primary text-decoration-none fw-semibold">vào đây</a> để xóa bộ lọc và tiếp tục tìm kiếm.</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    <tr class="product-row tbl-row" data-id="@item.MaPhieuXuat" title="Nhấn để xem chi tiết phiếu xuất hủy">
                        <td class="w-chk text-center cell-checkbox" onclick="event.stopPropagation();">
                            <input class="form-check-input row-select" type="checkbox" value="@item.MaPhieuXuat" data-sel="@item.MaPhieuXuat">
                        </td>
                        <td class="w-star text-center cell-star" style="cursor: pointer;" onclick="toggleFavoriteXuatHuy(event, @item.MaPhieuXuat, this)">
                            <span class="star-btn @(item.DaDanhDau ? "starred" : "")" data-id="@item.MaPhieuXuat" title="@(item.DaDanhDau ? "Bỏ đánh dấu sao" : "Đánh dấu sao")">
                                <i class="bi @(item.DaDanhDau ? "bi-star-fill" : "bi-star")"></i>
                            </span>
                        </td>
                        <td data-col="ma"><span class="text-break">@item.MaPhieuHienThi</span></td>
                        <td data-col="gt" class="r text-end">@item.TongGiaTriHuy.ToString("N0", viCulture)</td>
                        <td data-col="tg">@item.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-col="tgt" style="display: none;">@item.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-col="kho">@item.TenKho</td>
                        <td data-col="nxh" style="display: none;">@(string.IsNullOrEmpty(item.TenNguoiXacNhan) ? item.TenNguoiLap : item.TenNguoiXacNhan)</td>
                        <td data-col="nt" style="display: none;">@item.TenNguoiLap</td>
                        <td data-col="ghi" class="note text-truncate" title="@item.GhiChu">@item.GhiChu</td>
                        <td data-col="st">
                            @if (item.TrangThai == "DA_XAC_NHAN")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Hoàn thành</span>
                            }
                            else if (item.TrangThai == "HUY")
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Đã hủy</span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Phiếu tạm</span>
                            }
                        </td>
                    </tr>

                    <!-- Khối chi tiết bung ra (Inline Drawer / Accordion) khớp chuẩn Nhà cung cấp & KiotViet -->
                    <tr class="product-detail-row dtl" id="detail-@item.MaPhieuXuat" style="display: none;">
                        <td colspan="11" class="p-0">
                            <div class="product-detail-panel-wrap" style="display: none;">
                                <div class="product-detail-panel dp shadow-sm" data-d="@item.MaPhieuXuat">
                                    <div class="dp-tabs"><span class="dp-tab active">Thông tin</span></div>
                                    <h2 class="d-flex align-items-center gap-2">
                                        <span class="fw-bold" style="font-size: 18px; color: #1e293b;">@item.MaPhieuHienThi</span>
                                        @if (item.TrangThai == "DA_XAC_NHAN")
                                        {
                                            <span class="badge bg-success-subtle text-success border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Hoàn thành</span>
                                        }
                                        else if (item.TrangThai == "HUY")
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Phiếu tạm</span>
                                        }
                                    </h2>
                                    <div class="meta text-muted small mt-2">
                                        <span>Người tạo: <strong class="text-dark">@item.TenNguoiLap</strong></span>
                                        <span>Người xuất hủy: <strong class="text-dark">@(string.IsNullOrEmpty(item.TenNguoiXacNhan) ? item.TenNguoiLap : item.TenNguoiXacNhan)</strong></span>
                                        <span>Ngày xuất hủy: <strong class="text-dark">@item.NgayLap.ToString("dd/MM/yyyy HH:mm")</strong></span>
                                        <span>Chi nhánh: <strong class="text-dark">@item.TenKho</strong></span>
                                    </div>

                                    <table class="dtl-tbl table table-sm table-bordered mt-3 mb-0" style="background: #fff;">
                                        <thead style="background: #f8fafc;">
                                            <tr>
                                                <th style="width: 200px; font-weight: 600; font-size: 13px; color: #334155;">Mã hàng</th>
                                                <th style="font-weight: 600; font-size: 13px; color: #334155;">Tên hàng</th>
                                                <th class="r text-end" style="width: 120px; font-weight: 600; font-size: 13px; color: #334155;">SL hủy</th>
                                                <th class="r text-end" style="width: 130px; font-weight: 600; font-size: 13px; color: #334155;">Giá vốn</th>
                                                <th class="r text-end" style="width: 140px; font-weight: 600; font-size: 13px; color: #334155;">Giá trị hủy</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr class="fin">
                                                <td><input class="form-control form-control-sm dtl-search-code" placeholder="Tìm mã hàng" style="border-radius: 4px; border: 1px solid #d1d5db; height: 28px; font-size: 12.5px;"></td>
                                                <td><input class="form-control form-control-sm dtl-search-name" placeholder="Tìm tên hàng" style="border-radius: 4px; border: 1px solid #d1d5db; height: 28px; font-size: 12.5px;"></td>
                                                <td colspan="3" class="bg-transparent border-0"></td>
                                            </tr>
                                        </tbody>
                                        <tbody class="dl">
                                            @if (item.Lines.Any())
                                            {
                                                foreach (var l in item.Lines)
                                                {
                                                    <tr class="dtl-line-row" data-code="@l.MaHangNoiBo.ToLower()" data-name="@l.TenHang.ToLower()">
                                                        <td><span class="text-primary fw-medium text-break">@l.MaHangNoiBo</span></td>
                                                        <td>@l.TenHang</td>
                                                        <td class="r text-end">@l.SoLuongXuat.ToString("N0", viCulture)</td>
                                                        <td class="r text-end">@l.DonGiaXuat.ToString("N0", viCulture)</td>
                                                        <td class="r text-end">@l.ThanhTien.ToString("N0", viCulture)</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="5" class="text-muted text-center py-3">Không có hàng nào trong phiếu xuất hủy này.</td></tr>
                                            }
                                        </tbody>
                                    </table>

                                    <!-- Khối Ghi chú + Tổng kết số liệu bên phải -->
                                    <div class="dp-bottom d-flex gap-4 align-items-start mt-3">
                                        <div class="flex-grow-1" style="min-width: 250px;">
                                            <textarea class="form-control dp-note" style="height: 105px; resize: none; border: 1px solid #d1d5db; border-radius: 6px; font-size: 13.5px;" @(item.TrangThai == "HUY" ? "disabled" : "") placeholder="Chưa có">@item.GhiChu</textarea>
                                        </div>
                                        <div class="sums" style="flex: 0 0 280px; width: 280px;">
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="text-muted" style="font-size: 13.5px;">Tổng số lượng hủy</span>
                                                <span class="text-dark fw-medium" style="font-size: 13.5px;">@item.TongSoLuong.ToString("N0", viCulture)</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="text-muted" style="font-size: 13.5px;">Tổng giá trị hủy</span>
                                                <span class="text-dark fw-medium" style="font-size: 13.5px;">@item.TongGiaTriHuy.ToString("N0", viCulture)</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Hàng nút hành động chuẩn KiotViet Screenshot 1 -->
                                    <div class="dp-actions d-flex align-items-center gap-2 mt-3 pt-3 border-top">
                                        @if (item.TrangThai != "HUY")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-cancel-doc" data-id="@item.MaPhieuXuat" data-code="@item.MaPhieuHienThi" data-status="@item.TrangThai">
                                                <i class="bi bi-trash me-1"></i>Hủy
                                            </button>
                                        }
                                        <a href="@Url.Action("Create", "XuatHuy", new { copyFromId = item.MaPhieuXuat })" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-copy me-1"></i>Sao chép
                                        </a>
                                        <a href="@Url.Action("Export", "XuatHuy", new { type = "detail", id = item.MaPhieuXuat })" class="btn btn-sm btn-outline-secondary" target="_blank">
                                            <i class="bi bi-box-arrow-up me-1"></i>Xuất file
                                        </a>
                                        <span class="ms-auto"></span>
                                        @if (item.TrangThai != "HUY")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-save-note" data-id="@item.MaPhieuXuat">
                                                <i class="bi bi-floppy me-1"></i>Lưu
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print();">
                                            <i class="bi bi-printer me-1"></i>In
                                        </button>
                                        @if (item.TrangThai == "NHAP")
                                        {
                                            <a href="@Url.Action("Edit", "XuatHuy", new { id = item.MaPhieuXuat })" class="btn btn-sm btn-primary">
                                                <i class="bi bi-pencil-square me-1"></i>Mở phiếu
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Phân trang chuẩn KiotViet LEGO -->
@await Html.PartialAsync("_Pagination", Model.PagedData, new ViewDataDictionary(ViewData) { { "ItemLabel", "phiếu xuất hủy" } })
