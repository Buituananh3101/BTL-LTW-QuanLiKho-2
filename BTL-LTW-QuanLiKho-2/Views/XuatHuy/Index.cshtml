@model BTL_LTW_QuanLiKho_2.ViewModels.XuatHuyIndexVM
@{
    ViewData["Title"] = "Xuất hủy";
}

<link href="~/css/kiem-kho.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/xuat-huy.css" rel="stylesheet" asp-append-version="true" />

<div class="kp-container position-relative" id="kpContainer"
     data-filter-url="@Url.Action("Filter", "XuatHuy")"
     data-cancel-url="@Url.Action("Cancel", "XuatHuy")"
     data-note-url="@Url.Action("UpdateNote", "XuatHuy")"
     data-export-url="@Url.Action("Export", "XuatHuy")"
     data-toggle-star-url="@Url.Action("ToggleFavorite", "XuatHuy")"
     data-is-starred="@(Model.DaDanhDauFilter ? "true" : "false")"
     data-warehouse-id="@Model.CurrentWarehouseId"
     data-sort-by="@Model.SortBy"
     data-sort-dir="@Model.SortDir">

    <!-- 1. CỘT BÊN TRÁI: TIÊU ĐỀ + BỘ LỌC chuyên nghiệp (PARTIAL VIEW) -->
    <partial name="_XuatHuyFilterSidebar" model="Model" />

    <!-- Backdrop che mờ khi mở bộ lọc trên mobile/zoom in -->
    <div class="kp-sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Nút tròn thu gọn / mở rộng ở ranh giới giữa sidebar và bảng (Phím tắt F4) -->
    <button type="button" class="kp-sidebar-toggle-btn d-none d-lg-flex" id="btnToggleSidebar" title="Thu gọn bộ lọc (F4)">
        <i class="bi bi-chevron-left" id="sidebarToggleIcon"></i>
    </button>

    <!-- 2. CỘT BÊN PHẢI: THANH TÌM KIẾM + TOOLBAR + BẢNG XUẤT HỦY -->
    <main class="kp-main-col">
        <!-- Toolbar trên cùng: Thanh tìm kiếm thẳng hàng với bảng bên dưới -->
        <div class="kp-toolbar-row">
            <!-- Tiêu đề + Nút phễu bộ lọc trên mobile / zoom in -->
            <div class="kp-mobile-title-wrap d-lg-none d-flex align-items-center gap-2">
                <span class="kp-mobile-title fw-bold fs-6 text-dark">Xuất hủy</span>
                <button type="button" class="btn btn-sm btn-outline-primary kp-btn-funnel" id="btnMobileFilter" title="Mở bộ lọc xuất hủy">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>

            <!-- Ô tìm kiếm theo mã xuất hủy (F3) -->
            <div class="kp-search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="keywordSearch" class="form-control" placeholder="Theo mã xuất hủy (F3)" value="@Model.Filter.Q" autocomplete="off" />
            </div>

            <!-- Nhóm nút hành động chuyên nghiệp -->
            <div class="kp-actions-group">
                <!-- Nút + Xuất hủy -->
                <a href="@Url.Action("Create", "XuatHuy")" class="btn btn-primary d-inline-flex align-items-center" id="btnNew" title="Lập phiếu xuất hủy mới">
                    <i class="bi bi-plus-lg me-1"></i><span>Xuất hủy</span>
                </a>

                <!-- Dropdown Xuất file -->
                <div class="dropdown">
                    <button class="btn btn-tool dropdown-toggle" type="button" id="btnExportDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Xuất danh sách xuất hủy ra Excel">
                        <i class="bi bi-box-arrow-up me-1 text-success"></i>
                        <span class="d-none d-sm-inline">Xuất file</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="btnExportDropdown">
                        <li>
                            <a class="dropdown-item py-2" href="javascript:void(0)" id="btnExpList" data-x="list">
                                <i class="bi bi-file-earmark-spreadsheet me-2 text-success"></i>Xuất danh sách xuất hủy
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" href="javascript:void(0)" id="btnExpDetail" data-x="detail">
                                <i class="bi bi-file-earmark-text me-2 text-primary"></i>Xuất chi tiết (từng dòng hàng)
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Dropdown Tùy chọn hiển thị cột -->
                <div class="dropdown">
                    <button class="btn btn-tool" type="button" id="btnColsDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Tùy chọn hiển thị cột">
                        <i class="bi bi-view-list"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow p-3" id="colMenu" style="min-width: 210px;">
                        <h6 class="dropdown-header px-0 pt-0 text-dark fw-bold">Hiển thị cột</h6>
                        <div class="d-flex flex-column gap-2 small">
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="ma" checked> Mã xuất hủy</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="gt" checked> Tổng giá trị hủy</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="tg" checked> Thời gian</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="tgt"> Thời gian tạo</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="kho" checked> Chi nhánh</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="nxh"> Người xuất hủy</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="nt"> Người tạo</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="ghi" checked> Ghi chú</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="st" checked> Trạng thái</label>
                        </div>
                    </div>
                </div>

                <!-- Tải lại bảng -->
                <button type="button" class="btn btn-tool d-none d-sm-inline-flex" title="Tải lại bảng" id="btnReloadTable">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <!-- Trợ giúp (F1) -->
                <button type="button" class="btn btn-tool btn-help" id="btnHelp" title="Hướng dẫn sử dụng (F1)">
                    <i class="bi bi-question-circle"></i>
                </button>
            </div>
        </div>

        <!-- Bảng danh sách phiếu xuất hủy (Load AJAX qua Partial View) -->
        <section id="content">
            <div id="tableWrapper" class="kp-table-wrapper">
                <partial name="_XuatHuyTable" model="Model" />
            </div>
        </section>
    </main>
</div>

<!-- Modal xác nhận xóa / hủy chứng từ dùng chung AppConfirm -->
<div class="kp-confirm-ov" id="kpConfirmOv">
    <div class="kp-confirm-modal">
        <div class="kp-confirm-header">
            <h5 class="kp-confirm-title" id="kpConfirmTitle">Xác nhận</h5>
            <button type="button" class="btn-close" id="kpConfirmCloseBtn" aria-label="Close"></button>
        </div>
        <div class="kp-confirm-body" id="kpConfirmMsg">Bạn có chắc chắn muốn thực hiện thao tác này?</div>
        <div class="kp-confirm-footer">
            <button type="button" class="btn btn-secondary kp-btn-cancel" id="kpConfirmCancelBtn">Bỏ qua</button>
            <button type="button" class="btn btn-danger kp-btn-ok" id="kpConfirmOkBtn">Đồng ý</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/app-filter.js" asp-append-version="true"></script>
    <script src="~/js/xuat-huy-index.js" asp-append-version="true"></script>
}
