@model BTL_LTW_QuanLiKho_2.ViewModels.TheKhoIndexVM
@{
    ViewData["Title"] = "Báo cáo Thẻ kho";
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/the-kho.css" asp-append-version="true" />

<!-- Cấu hình dữ liệu ban đầu cho JavaScript -->
<div id="theKhoConfig"
     data-ma-hang="@(Model.TongHop?.MaHang ?? Model.Filter.MaHang ?? 0)"
     data-ma-kho="@(Model.Filter.MaKho ?? 0)"
     data-date-range="@(Model.Filter.DateRange ?? "THIS_MONTH")"
     data-tu-ngay="@(Model.Filter.TuNgay?.ToString("yyyy-MM-dd") ?? "")"
     data-den-ngay="@(Model.Filter.DenNgay?.ToString("yyyy-MM-dd") ?? "")"
     data-page="@Model.Filter.Page"
     data-page-size="@Model.Filter.PageSize"
     style="display:none;"></div>

<div class="kp-container position-relative" id="kpContainer">
    <!-- 1. CỘT BÊN TRÁI: TIÊU ĐỀ + BỘ LỌC chuyên nghiệp (PARTIAL VIEW) -->
    <partial name="_TheKhoFilterSidebar" model="Model" />

    <!-- Backdrop che mờ khi mở bộ lọc trên mobile/zoom in -->
    <div class="kp-sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Nút tròn thu gọn / mở rộng ở ranh giới giữa sidebar và bảng (Phím tắt F4) -->
    <button type="button" class="kp-sidebar-toggle-btn d-none d-lg-flex" id="btnToggleSidebar" title="Thu gọn bộ lọc (F4)">
        <i class="bi bi-chevron-left" id="sidebarToggleIcon"></i>
    </button>

    <!-- 2. CỘT BÊN PHẢI: TOOLBAR + SUMMARY CARDS + BẢNG THẺ KHO -->
    <main class="kp-main-col">
        <!-- Toolbar trên cùng: Thanh tìm kiếm F3 + Xuất file + In thẻ kho -->
        <div class="kp-toolbar-row mb-3">
            <div class="kp-mobile-title-wrap d-lg-none d-flex align-items-center gap-2">
                <span class="kp-mobile-title fw-bold fs-6 text-dark">Thẻ kho</span>
                <button type="button" class="btn btn-sm btn-outline-primary kp-btn-funnel" id="btnMobileFilter" title="Mở bộ lọc">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>

            <!-- Ô tìm kiếm giao dịch trên bảng thẻ kho -->
            <div class="kp-search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="keywordSearch" class="form-control"
                       placeholder="Theo mã chứng từ, đối tác, ghi chú"
                       value="@Model.Filter.TuKhoa" autocomplete="off" />
            </div>

            <div class="kp-actions-group ms-auto d-flex align-items-center gap-2">
                <!-- Nút Xuất file Excel -->
                <button type="button" class="btn btn-tool" id="btnExportTheKho" title="Xuất thẻ kho ra Excel">
                    <i class="bi bi-box-arrow-up me-1 text-success"></i>
                    <span class="d-none d-sm-inline">Xuất file</span>
                </button>

                <!-- Nút In thẻ kho -->
                <button type="button" class="btn btn-tool" id="btnPrintTheKho" title="In thẻ kho">
                    <i class="bi bi-printer me-1 text-secondary"></i>
                    <span class="d-none d-sm-inline">In</span>
                </button>

                <!-- Nút tải lại bảng -->
                <button type="button" class="btn btn-tool" title="Tải lại bảng" id="btnReloadTable">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <!-- Trợ giúp (F1) -->
                <button type="button" class="btn btn-tool btn-help" id="btnHelp" title="Hướng dẫn sử dụng (F1)">
                    <i class="bi bi-question-circle"></i>
                </button>
            </div>
        </div>

        <!-- Khối nội dung chính (Summary KPI + Bảng dữ liệu) nạp AJAX đồng bộ -->
        <div id="theKhoMainContent">
            <partial name="_TheKhoContent" model="Model" />
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/app-filter.js" asp-append-version="true"></script>
    <script src="~/js/the-kho-index.js" asp-append-version="true"></script>
}
