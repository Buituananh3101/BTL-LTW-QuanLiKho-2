@model BTL_LTW_QuanLiKho_2.ViewModels.BaoCaoTonKhoIndexVM
@{
    ViewData["Title"] = "Báo cáo Tồn kho theo kho";
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<style>
/* Nổi bật hover và dòng đang mở chi tiết */
.tbl tr.row-tonkho:hover {
    background-color: #f8fafc;
}
.tbl tr.row-tonkho.selected {
    background-color: #eff6ff !important;
}
.row-expand-chevron {
    transition: transform 0.2s ease;
    display: inline-block;
}
.tbl tr.row-tonkho.selected .row-expand-chevron {
    transform: rotate(90deg);
    color: var(--bs-primary) !important;
}
</style>

<!-- Cấu hình dữ liệu ban đầu cho JavaScript -->
<div id="tonKhoConfig"
     data-page="@Model.Filter.Page"
     data-page-size="@Model.Filter.PageSize"
     data-sort-by="@(Model.Filter.SortBy ?? "tenHang")"
     data-sort-dir="@(Model.Filter.SortDir ?? "asc")"
     data-tinh-trang="@(Model.Filter.TinhTrangTon ?? "ALL")"
     data-trang-thai-hang="@(Model.Filter.TrangThaiHang ?? "DANG_BAN")"
     data-ma-nhom="@(Model.Filter.MaNhom ?? 0)"
     data-selected-khos='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedKhoIds))'
     style="display:none;"></div>

<div class="kp-container position-relative" id="kpContainer">
    <!-- 1. CỘT BÊN TRÁI: TIÊU ĐỀ + BỘ LỌC chuyên nghiệp (PARTIAL VIEW) -->
    <partial name="_TonKhoFilterSidebar" model="Model" />

    <!-- Backdrop che mờ khi mở bộ lọc trên mobile/zoom in -->
    <div class="kp-sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Nút tròn thu gọn / mở rộng ở ranh giới giữa sidebar và bảng (Phím tắt F4) -->
    <button type="button" class="kp-sidebar-toggle-btn d-none d-lg-flex" id="btnToggleSidebar" title="Thu gọn bộ lọc (F4)">
        <i class="bi bi-chevron-left" id="sidebarToggleIcon"></i>
    </button>

    <!-- 2. CỘT BÊN PHẢI: THANH TÌM KIẾM + TOOLBAR + BẢNG PIVOT CHUẨN DANH SÁCH HÀNG HÓA -->
    <main class="kp-main-col">
        <!-- Toolbar trên cùng: Thanh tìm kiếm F3 + Ẩn hiện cột + Xuất file + In báo cáo + Tải lại bảng -->
        <div class="kp-toolbar-row mb-3">
            <div class="kp-mobile-title-wrap d-lg-none d-flex align-items-center gap-2">
                <span class="kp-mobile-title fw-bold fs-6 text-dark">Báo cáo tồn kho</span>
                <button type="button" class="btn btn-sm btn-outline-primary kp-btn-funnel" id="btnMobileFilter" title="Mở bộ lọc">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>

            <div class="kp-search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="keywordSearch" class="form-control" placeholder="Theo mã, tên hàng, vị trí (F3)" value="@Model.Filter.Q" autocomplete="off" />
            </div>

            <div class="kp-actions-group ms-auto d-flex align-items-center gap-2">
                <!-- Dropdown tùy chọn hiển thị cột chuẩn Danh sách Hàng hóa -->
                <div class="dropdown">
                    <button class="btn btn-tool" type="button" id="btnColsDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Tùy chọn hiển thị cột">
                        <i class="bi bi-view-list"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow p-3" id="colMenu" style="min-width: 360px;">
                        <h6 class="dropdown-header px-0 pt-0 text-dark fw-bold mb-2">Hiển thị cột</h6>
                        <div class="row g-3">
                            <div class="col-6 d-flex flex-column gap-2 small">
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="stt" checked> Số thứ tự</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="mahang" checked> Mã hàng</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="tenhang" checked> Tên hàng</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="dvt" checked> Đơn vị tính</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="nhomhang" checked> Nhóm hàng</label>
                            </div>
                            <div class="col-6 d-flex flex-column gap-2 small">
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="giavon" checked> Giá vốn</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="giatriton" checked> Giá trị tồn</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="khos" checked> Tồn chi nhánh</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="tongton" checked> Tổng tồn</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Nút Tải lại bảng -->
                <button type="button" class="btn btn-tool d-none d-sm-inline-flex" title="Tải lại bảng" id="btnReloadTable">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>

                <!-- Nút Xuất file Excel -->
                <button type="button" class="btn btn-tool" id="btnExportExcel" title="Xuất báo cáo tồn kho ra Excel">
                    <i class="bi bi-box-arrow-up me-1 text-success"></i>
                    <span class="d-none d-sm-inline">Xuất file</span>
                </button>

                <!-- Nút In báo cáo -->
                <button type="button" class="btn btn-tool" id="btnPrintReport" title="In báo cáo">
                    <i class="bi bi-printer me-1 text-secondary"></i>
                    <span class="d-none d-sm-inline">In</span>
                </button>

                <!-- Trợ giúp (F1) -->
                <button type="button" class="btn btn-tool btn-help" id="btnHelp" title="Hướng dẫn sử dụng (F1)">
                    <i class="bi bi-question-circle"></i>
                </button>
            </div>
        </div>

        <!-- Bảng Pivot Tồn kho cuộn tự nhiên kèm Summary Row & Inline Accordion Subrow (Partial View AJAX) -->
        <section id="content">
            <div id="tableWrapper" class="kp-table-wrapper">
                <partial name="_TonKhoTable" model="Model" />
            </div>
        </section>
    </main>
</div>

@section Scripts {
    <script src="~/js/app-filter.js" asp-append-version="true"></script>
    <script src="~/js/bao-cao-ton-kho.js" asp-append-version="true"></script>
}
