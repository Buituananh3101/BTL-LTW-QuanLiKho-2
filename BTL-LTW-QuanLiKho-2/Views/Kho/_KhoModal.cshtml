@model BTL_LTW_QuanLiKho_2.ViewModels.QuanLyKho.KhoIndexVM

<!-- ========================================================================
     MODAL CHÍNH: TẠO & CẬP NHẬT CHI NHÁNH KHO chuẩn chuyên nghiệp
     Kế thừa 100% kiến trúc từ Form Thêm Hàng Hóa (_HangHoaModal.cshtml):
     - Tabs Thông tin & Mô tả (.hh-tabs, .hh-tab, .hh-pane)
     - Khối trường cơ bản Grid 2 cột (.hh-fields, .hh-f, .hh-span2)
     - Khối gập mở Accordion (.hh-sec, .hh-sec-h, .hh-sec-b, .hh-chev)
     - Soạn thảo mô tả giàu (.hh-rte-bar, .hh-rte)
     - Chân modal Split Button (.hh-split, .hh-btn, .hh-chk)
     ======================================================================== -->

<!-- Sprite icon SVG dùng cho modal -->
<svg style="display:none" xmlns="http://www.w3.org/2000/svg">
  <symbol id="i-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></symbol>
  <symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></symbol>
</svg>

<div class="hh-ov" id="khoModalOv">
  <div class="hh-modal main" role="dialog" aria-modal="true" aria-labelledby="khoModalTitle" style="max-width: 900px; min-height: 680px;">
    <!-- Header Modal có Tabs chuyển đổi chuẩn Hàng Hóa -->
    <div class="hh-m-head">
      <h2 id="khoModalTitle">Thêm mới chi nhánh kho</h2>
      <button type="button" class="hh-x" data-close="khoModalOv" aria-label="Đóng">
        <svg style="width:18px;height:18px;"><use href="#i-x"/></svg>
      </button>
      <div class="hh-tabs">
        <button type="button" class="hh-tab on" data-tab="info">Thông tin</button>
        <button type="button" class="hh-tab" data-tab="desc">Mô tả</button>
      </div>
    </div>

    <!-- Body Modal -->
    <div class="hh-m-body" id="khoModalBody" style="min-height: 540px;">
      <form id="khoForm" onsubmit="return false;" autocomplete="off">
        <input type="hidden" id="khoMaKho" value="0" />

        <!-- Alert báo lỗi form -->
        <div class="alert alert-danger py-2 px-3 small d-none mb-3" id="khoFormAlert"></div>

        <!-- ==================== TAB 1: THÔNG TIN ==================== -->
        <div class="hh-pane on" id="kho-pane-info">
          <!-- KHỐI 1: CÁC TRƯỜNG THÔNG TIN CƠ BẢN (GRID 2 CỘT) -->
          <div class="hh-fields" style="margin-bottom: 20px;">
            <!-- Mã kho -->
            <div class="hh-f" id="fldMaKho">
              <label for="khoMaKhoDisplay">
                <span>Mã kho</span>
                <span class="badge bg-secondary-subtle text-secondary" id="badgeAutoCode" style="font-size: 10px;">Tự động</span>
              </label>
              <input type="text" id="khoMaKhoDisplay" placeholder="Mã tự động sinh (VD: KHO-04)" readonly style="background: var(--hh-bg, #f3f4f6); cursor: not-allowed;" />
            </div>

            <!-- Tên chi nhánh kho -->
            <div class="hh-f" id="fldTenKho">
              <label for="khoTenKho">
                <span>Tên chi nhánh kho <span style="color:var(--hh-danger)">*</span></span>
              </label>
              <input type="text" id="khoTenKho" placeholder="Bắt buộc (VD: Kho trung tâm, Kho An Thới...)" autocomplete="off" />
              <span class="hh-err" id="errTenKho">Vui lòng nhập tên chi nhánh kho (tối đa 100 ký tự).</span>
            </div>

            <!-- Địa chỉ kho (Chiếm trọn 2 cột) -->
            <div class="hh-f hh-span2" id="fldDiaChi">
              <label for="khoDiaChi">Địa chỉ kho</label>
              <input type="text" id="khoDiaChi" placeholder="Số nhà, đường phố, phường/xã, thành phố / huyện..." autocomplete="off" />
            </div>

            <!-- KHỐI 2: DROPDOWN CHỌN NHÂN SỰ PHỤ TRÁCH KHO -->
            <div class="hh-f hh-span2" id="fldNhanSu">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label for="khoUserDropdownTrigger" class="mb-0" style="font-weight: 600;">
                  <span>Nhân sự phụ trách kho</span>
                  <span class="text-muted fw-normal small ms-1">(Nhân viên có quyền truy cập và thao tác tại chi nhánh này)</span>
                </label>
                <span class="badge bg-primary-subtle text-primary border" id="selectedUserBadge" style="font-size: 11px;">0 nhân sự</span>
              </div>

              <!-- DROPDOWN MULTI-SELECT NHÂN SỰ CHUẨN KIOTVIET -->
              <div class="kho-user-select-wrap position-relative" id="khoUserSelectWrap">
                <!-- Trigger box -->
                <div class="kho-user-dropdown-box" id="khoUserDropdownTrigger" tabindex="0" role="button" aria-expanded="false" aria-haspopup="true">
                  <div id="khoUserSelectedDisplay" class="kho-user-selected-display">
                    <span class="text-muted">Chọn nhân sự phụ trách kho...</span>
                  </div>
                  <i class="bi bi-chevron-down kho-user-arrow" id="khoUserDropdownArrow"></i>
                </div>

                <!-- Dropdown menu popup -->
                <div class="kho-user-dropdown-menu shadow" id="khoUserDropdownMenu">
                  <!-- Header search + quick actions -->
                  <div class="kho-user-dropdown-header">
                    <div class="kho-user-search-wrap">
                      <i class="bi bi-search kho-user-search-icon"></i>
                      <input type="text" id="searchUserInDropdown" class="kho-user-search-input" placeholder="Tìm theo tên, tên đăng nhập..." autocomplete="off" />
                    </div>
                    <div class="kho-user-actions-quick">
                      <button type="button" class="btn-quick-action text-primary" id="btnDropdownSelectAll">Chọn tất cả</button>
                      <span class="action-sep">|</span>
                      <button type="button" class="btn-quick-action text-muted" id="btnDropdownDeselectAll">Bỏ chọn</button>
                    </div>
                  </div>

                  <!-- Danh sách nhân viên có thanh cuộn -->
                  <div class="kho-user-dropdown-list" id="listUserDropdownItems">
                    @foreach (var u in Model.DanhSachTaiKhoan)
                    {
                      <div class="kho-user-dropdown-item @(u.TenVaiTro == "Quản lý" ? "selected" : "")" data-id="@u.MaTaiKhoan" data-name="@u.HoTen" data-role="@u.TenVaiTro" data-username="@u.TenDangNhap">
                        <div class="d-flex align-items-center gap-2 overflow-hidden flex-grow-1">
                          <input class="form-check-input kho-user-chk m-0 flex-shrink-0" type="checkbox" value="@u.MaTaiKhoan" id="chkUser_@u.MaTaiKhoan" @(u.TenVaiTro == "Quản lý" ? "checked disabled" : "") />
                          <div class="overflow-hidden">
                            <label for="chkUser_@u.MaTaiKhoan" class="fw-semibold text-dark mb-0 d-block text-truncate" title="@u.HoTen">
                              @u.HoTen
                            </label>
                            <div class="text-muted user-sub-text">
                              <i class="bi bi-person me-1"></i>@u.TenDangNhap
                            </div>
                          </div>
                        </div>
                        <div class="ms-2 flex-shrink-0">
                          @if (u.TenVaiTro == "Quản lý")
                          {
                            <span class="badge bg-primary text-white" style="font-size: 10px;">Quản lý</span>
                          }
                          else if (u.TenVaiTro.Contains("kho", StringComparison.OrdinalIgnoreCase))
                          {
                            <span class="badge bg-warning text-dark" style="font-size: 10px;">@u.TenVaiTro</span>
                          }
                          else
                          {
                            <span class="badge bg-success text-white" style="font-size: 10px;">@u.TenVaiTro</span>
                          }
                        </div>
                      </div>
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ==================== TAB 2: MÔ TẢ ==================== -->
        <div class="hh-pane" id="kho-pane-desc">
          <div class="hh-rte-bar">
            <button type="button" data-cmd="bold" title="In đậm"><b>B</b></button>
            <button type="button" data-cmd="italic" title="In nghiêng"><i>I</i></button>
            <button type="button" data-cmd="underline" title="Gạch chân"><u>U</u></button>
            <button type="button" data-cmd="insertUnorderedList" title="Danh sách dấu chấm">•</button>
          </div>
          <div class="hh-rte" id="khoMoTaRte" contenteditable="true" style="min-height: 380px;" data-ph="Nhập mô tả chi tiết chi nhánh kho, đặc điểm hàng hóa chứa, hướng dẫn đường đi hoặc quy định giao nhận..."></div>
        </div>
      </form>
    </div>

    <!-- Footer Modal chuẩn chuyên nghiệp Form Hàng Hóa -->
    <div class="hh-m-foot">
      <!-- Checkbox trạng thái kho bên trái chân modal -->
      <label class="hh-chk" style="display: inline-flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; font-size: 14px; font-weight: 500;">
        <input type="checkbox" id="khoTrangThaiChk" checked style="width: 18px; height: 18px; accent-color: var(--hh-blue); cursor: pointer;" />
        <span id="khoTrangThaiText">Đang hoạt động</span>
      </label>

      <span class="sp"></span>

      <button type="button" class="hh-btn" data-close="khoModalOv">Bỏ qua</button>
      
      <!-- Split Button Lego chuyên nghiệp: Lưu & Thêm mới / Lưu & Sao chép -->
      <div class="hh-split">
        <button type="button" class="hh-btn" id="btnSaveKhoAndNew">Lưu &amp; Thêm mới</button>
        <button type="button" class="hh-btn caret" id="btnKhoCaret" aria-label="Thêm tùy chọn">
          <svg style="width:14px;height:14px;"><use href="#i-chev"/></svg>
        </button>
        <div class="hh-menu" id="khoSplitMenu">
          <button type="button" id="btnSaveKhoCopy">Lưu &amp; Sao chép</button>
        </div>
      </div>

      <button type="button" class="hh-btn primary" id="btnSaveKho">
        <i class="bi bi-check-lg me-1"></i>Lưu chi nhánh kho
      </button>
    </div>
  </div>
</div>
