@model BTL_LTW_QuanLiKho_2.ViewModels.TraHangNhap.TraHangNhapIndexVM
@using System.Globalization
@{
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
}

<div class="kiot-table-scroll-body">
    <table class="tbl" id="receiptTable" style="width: max-content; min-width: 760px;">
        <thead>
            <tr>
                <th style="width: 36px; min-width: 36px;" class="text-center th-checkbox">
                    <input class="form-check-input" type="checkbox" id="selectAllRows" @(!Model.PagedData.Items.Any() ? "disabled" : "") />
                </th>
                <th style="width: 36px; min-width: 36px; cursor: pointer;" class="text-center th-star" onclick="toggleStarHeaderFilter(event)">
                    <span class="star-btn star-header-filter @(Model.DaDanhDauFilter ? "starred" : "")" id="starHeaderFilter" title="@(Model.DaDanhDauFilter ? "Bỏ lọc sao (Hiển thị tất cả)" : "Lọc danh sách phiếu được đánh dấu sao")">
                        <i class="bi @(Model.DaDanhDauFilter ? "bi-star-fill" : "bi-star")"></i>
                    </span>
                </th>
                <th data-col="ma" style="width: 150px; min-width: 150px;" class="sortable-th @((Model.SortBy == "ma" || Model.SortBy == "maphieu") ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Mã trả hàng nhập">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Mã trả hàng nhập</span>
                            @if ((Model.SortBy == "ma" || Model.SortBy == "maphieu") && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if ((Model.SortBy == "ma" || Model.SortBy == "maphieu") && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tg" style="width: 145px; min-width: 145px;" class="sortable-th @((Model.SortBy == "tg" || Model.SortBy == "ngaytra") ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Thời gian">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Thời gian</span>
                            @if ((Model.SortBy == "tg" || Model.SortBy == "ngaytra") && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if ((Model.SortBy == "tg" || Model.SortBy == "ngaytra") && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tgtao" style="width: 145px; min-width: 145px;" class="sortable-th @(Model.SortBy == "tgtao" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Thời gian tạo">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Thời gian tạo</span>
                            @if (Model.SortBy == "tgtao" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "tgtao" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="ncc" style="width: 250px; min-width: 250px;" class="col-product-name sortable-th @((Model.SortBy == "ncc" || Model.SortBy == "tenncc") ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Nhà cung cấp">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Nhà cung cấp</span>
                            @if ((Model.SortBy == "ncc" || Model.SortBy == "tenncc") && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if ((Model.SortBy == "ncc" || Model.SortBy == "tenncc") && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="chinhanh" style="width: 140px; min-width: 140px;" class="sortable-th @(Model.SortBy == "chinhanh" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Chi nhánh">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Chi nhánh</span>
                            @if (Model.SortBy == "chinhanh" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "chinhanh" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="nguoitra" style="width: 140px; min-width: 140px;" class="sortable-th @(Model.SortBy == "nguoitra" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Người trả">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Người trả</span>
                            @if (Model.SortBy == "nguoitra" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "nguoitra" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="nguoitao" style="width: 140px; min-width: 140px;" class="sortable-th @(Model.SortBy == "nguoitao" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Người tạo">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Người tạo</span>
                            @if (Model.SortBy == "nguoitao" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "nguoitao" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tongsl" style="width: 120px; min-width: 120px;" class="num sortable-th @((Model.SortBy == "tongsl" || Model.SortBy == "tongsoluong") ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Tổng số lượng">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Tổng SL</span>
                            @if ((Model.SortBy == "tongsl" || Model.SortBy == "tongsoluong") && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if ((Model.SortBy == "tongsl" || Model.SortBy == "tongsoluong") && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="slmathang" style="width: 110px; min-width: 110px;" class="num sortable-th @(Model.SortBy == "slmathang" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Số lượng mặt hàng">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">SL mặt hàng</span>
                            @if (Model.SortBy == "slmathang" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "slmathang" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tongtien" style="width: 140px; min-width: 140px;" class="num sortable-th @((Model.SortBy == "tongtien" || Model.SortBy == "tongtienhang") ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Tổng tiền hàng">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Tổng tiền hàng</span>
                            @if ((Model.SortBy == "tongtien" || Model.SortBy == "tongtienhang") && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if ((Model.SortBy == "tongtien" || Model.SortBy == "tongtienhang") && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="giamgia" style="width: 120px; min-width: 120px;" class="num sortable-th @(Model.SortBy == "giamgia" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Giảm giá">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Giảm giá</span>
                            @if (Model.SortBy == "giamgia" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "giamgia" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="canthu" style="width: 140px; min-width: 140px;" class="num sortable-th @((Model.SortBy == "canthu" || Model.SortBy == "canthuncc") ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo NCC cần trả">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">NCC cần trả</span>
                            @if ((Model.SortBy == "canthu" || Model.SortBy == "canthuncc") && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if ((Model.SortBy == "canthu" || Model.SortBy == "canthuncc") && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="dathu" style="width: 140px; min-width: 140px;" class="num sortable-th @((Model.SortBy == "dathu" || Model.SortBy == "dathuncc") ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo NCC đã trả">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">NCC đã trả</span>
                            @if ((Model.SortBy == "dathu" || Model.SortBy == "dathuncc") && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if ((Model.SortBy == "dathu" || Model.SortBy == "dathuncc") && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="ghi" style="width: 180px; min-width: 180px;" class="sortable-th @((Model.SortBy == "ghi" || Model.SortBy == "ghichu") ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Ghi chú">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Ghi chú</span>
                            @if ((Model.SortBy == "ghi" || Model.SortBy == "ghichu") && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if ((Model.SortBy == "ghi" || Model.SortBy == "ghichu") && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="st" style="width: 135px; min-width: 135px;" class="text-center sortable-th @((Model.SortBy == "st" || Model.SortBy == "trangthai") ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Trạng thái">
                    <div class="th-content justify-content-center">
                        <span class="th-title-wrap">
                            <span class="th-text">Trạng thái</span>
                            @if ((Model.SortBy == "st" || Model.SortBy == "trangthai") && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if ((Model.SortBy == "st" || Model.SortBy == "trangthai") && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PagedData.Items.Any())
            {
                <!-- DÒNG TỔNG HỢP CỐ ĐỊNH chuẩn chuyên nghiệp (TOTAL ROW) -->
                <tr class="total-summary-row fw-bold" style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                    <td></td>
                    <td></td>
                    <td data-col="ma" class="text-muted small">Tổng cộng</td>
                    <td data-col="tg"></td>
                    <td data-col="tgtao"></td>
                    <td data-col="ncc"></td>
                    <td data-col="chinhanh"></td>
                    <td data-col="nguoitra"></td>
                    <td data-col="nguoitao"></td>
                    <td data-col="tongsl" class="num text-end text-dark">@Model.TongSoLuong.ToString("N0", viCulture)</td>
                    <td data-col="slmathang"></td>
                    <td data-col="tongtien" class="num text-end text-dark">@Model.TongTienHang.ToString("N0", viCulture)</td>
                    <td data-col="giamgia" class="num text-end text-dark">@Model.TongGiamGia.ToString("N0", viCulture)</td>
                    <td data-col="canthu" class="num text-end text-primary">@Model.TongCanThuNcc.ToString("N0", viCulture)</td>
                    <td data-col="dathu" class="num text-end text-success">@Model.TongDaThuNcc.ToString("N0", viCulture)</td>
                    <td data-col="ghi"></td>
                    <td data-col="st"></td>
                </tr>

                foreach (var item in Model.PagedData.Items)
                {
                    <tr class="product-row tbl-row" data-id="@item.MaPhieuTraHang" title="Nhấn để xem chi tiết phiếu trả hàng">
                        <td class="text-center cell-checkbox" onclick="event.stopPropagation();">
                            <input class="form-check-input row-select" type="checkbox" value="@item.MaPhieuTraHang" />
                        </td>
                        <td class="text-center cell-star" style="cursor: pointer;" onclick="toggleFavoriteReceipt(event, @item.MaPhieuTraHang, this)">
                            <span class="star-btn @(item.DaDanhDau ? "starred" : "")" data-id="@item.MaPhieuTraHang" title="@(item.DaDanhDau ? "Bỏ đánh dấu sao" : "Đánh dấu sao")">
                                <i class="bi @(item.DaDanhDau ? "bi-star-fill" : "bi-star")"></i>
                            </span>
                        </td>
                        <td data-col="ma">
                            <span class="text-break fw-semibold text-dark">@item.MaPhieuHienThi</span>
                        </td>
                        <td data-col="tg">
                            @item.NgayTra.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td data-col="tgtao">
                            @item.NgayLap.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td data-col="ncc" class="col-product-name">
                            <span class="text-break">@(string.IsNullOrEmpty(item.TenNcc) ? "---" : item.TenNcc)</span>
                        </td>
                        <td data-col="chinhanh">
                            @item.TenKho
                        </td>
                        <td data-col="nguoitra">
                            @(item.TenNguoiTra ?? "---")
                        </td>
                        <td data-col="nguoitao">
                            @item.TenNguoiLap
                        </td>
                        <td data-col="tongsl" class="num text-end">
                            @item.TongSoLuong.ToString("N0", viCulture)
                        </td>
                        <td data-col="slmathang" class="num text-end">
                            @item.SoMatHang
                        </td>
                        <td data-col="tongtien" class="num text-end">
                            @item.TongTienHang.ToString("N0", viCulture)
                        </td>
                        <td data-col="giamgia" class="num text-end">
                            @item.GiamGia.ToString("N0", viCulture)
                        </td>
                        <td data-col="canthu" class="num text-end fw-semibold text-primary">
                            @item.CanThuNcc.ToString("N0", viCulture)
                        </td>
                        <td data-col="dathu" class="num text-end fw-semibold text-success">
                            @item.DaThuNcc.ToString("N0", viCulture)
                        </td>
                        <td data-col="ghi" class="text-muted small">
                            @(string.IsNullOrEmpty(item.GhiChu) ? "---" : item.GhiChu)
                        </td>
                        <td data-col="st" class="text-center">
                            <span class="@item.BadgeClass">@item.TenTrangThai</span>
                        </td>
                    </tr>

                    <!-- ACCORDION DRAWER CHI TIẾT INLINE -->
                    <tr class="product-detail-row dtl detail-row" id="detail-row-@item.MaPhieuTraHang" style="display: none;">
                        <td colspan="17" class="p-0">
                            <div class="product-detail-panel-wrap" style="display: none;">
                                <div class="ncc-detail-fixed-wrap thn-detail-fixed-wrap kiot-detail-fixed-wrap" style="padding: 16px 20px; background: #fff;">
                                    <div class="detail-panel-inline">
                                    <div class="dp-tabs border-bottom mb-3 pb-2">
                                        <span class="text-primary fw-bold pb-2 border-bottom border-primary border-2">Thông tin</span>
                                    </div>
                                    <div class="dp-head d-flex justify-content-between align-items-center mb-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <h4 class="m-0 fw-bold fs-5 text-dark">@item.MaPhieuHienThi</h4>
                                            <span class="@item.BadgeClass">@item.TenTrangThai</span>
                                        </div>
                                        <span class="text-muted fw-semibold">@item.TenKho</span>
                                    </div>

                                    <div class="dp-grid row g-3 align-items-center mb-3">
                                        <div class="col-md-3">
                                            <span class="text-muted small">Người tạo:</span>
                                            <b class="ms-1 text-dark">@item.TenNguoiLap</b>
                                        </div>
                                        <div class="col-md-3 d-flex align-items-center gap-2">
                                            <span class="text-muted small text-nowrap">Người trả:</span>
                                            <select class="form-select form-select-sm inp-payer" data-id="@item.MaPhieuTraHang" @(item.TrangThai == "HUY" ? "disabled" : "") style="border-radius: 6px; border-color: #cbd5e1; height: 32px; font-size: 13px;">
                                                @foreach (var nv in Model.NhanViens)
                                                {
                                                    <option value="@nv.Value" selected="@(item.MaNvtra?.ToString() == nv.Value)">@nv.Text</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3 d-flex align-items-center gap-2">
                                            <span class="text-muted small text-nowrap">Ngày trả:</span>
                                            <input type="datetime-local" class="form-control form-control-sm inp-date" data-id="@item.MaPhieuTraHang" value="@item.NgayTra.ToString("yyyy-MM-ddTHH:mm")" @(item.TrangThai == "HUY" ? "disabled" : "") />
                                        </div>
                                        <div class="col-md-3">
                                            <span class="text-muted small">Nhà cung cấp:</span>
                                            <b class="ms-1 text-dark">@(string.IsNullOrEmpty(item.TenNcc) ? "Không có NCC" : item.TenNcc)</b>
                                        </div>
                                    </div>

                                    <!-- Bảng chi tiết mặt hàng trả -->
                                    <table class="table table-bordered table-sm dtl-tbl mb-3">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 130px;">Mã hàng</th>
                                                <th>Tên hàng</th>
                                                <th class="text-center" style="width: 75px;">ĐVT</th>
                                                <th class="text-end" style="width: 90px;">Số lượng</th>
                                                <th class="text-end" style="width: 110px;">Giá nhập</th>
                                                <th class="text-end" style="width: 110px;">Giá trả lại</th>
                                                <th class="text-end" style="width: 130px;">Thành tiền</th>
                                            </tr>
                                            <tr class="sr">
                                                <td><input type="text" class="form-control form-control-sm fl-code" placeholder="Tìm mã hàng" /></td>
                                                <td><input type="text" class="form-control form-control-sm fl-name" placeholder="Tìm tên hàng" /></td>
                                                <td colspan="5"></td>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (item.Lines.Any())
                                            {
                                                foreach (var l in item.Lines)
                                                {
                                                    <tr class="dtl-item-row" data-code="@l.MaHangNoiBo.ToLower()" data-name="@l.TenHang.ToLower()">
                                                        <td><span class="fw-semibold text-primary">@l.MaHangNoiBo</span></td>
                                                        <td>@l.TenHang</td>
                                                        <td class="text-center text-muted">@l.TenDvt</td>
                                                        <td class="text-end">@l.SoLuong.ToString("N0", viCulture)</td>
                                                        <td class="text-end">@l.GiaVon.ToString("N0", viCulture)</td>
                                                        <td class="text-end">@l.DonGiaTra.ToString("N0", viCulture)</td>
                                                        <td class="text-end fw-semibold">@l.ThanhTien.ToString("N0", viCulture)</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="7" class="text-muted text-center py-2">Không có mặt hàng nào.</td></tr>
                                            }
                                        </tbody>
                                    </table>

                                    <!-- Khối Ghi chú + Tổng kết tài chính -->
                                    <div class="dp-bottom d-flex gap-4 align-items-start mt-3">
                                        <div class="flex-grow-1" style="min-width: 250px;">
                                            <textarea class="form-control dp-note" data-id="@item.MaPhieuTraHang" style="height: 110px; resize: none; font-size: 13.5px;" @(item.TrangThai == "HUY" ? "disabled" : "") placeholder="Ghi chú...">@item.GhiChu</textarea>
                                        </div>
                                        <div class="sums" style="flex: 0 0 320px; width: 320px;">
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="text-muted">Số lượng mặt hàng:</span>
                                                <span class="text-primary fw-medium">@item.SoMatHang</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="text-muted">Tổng tiền hàng (@item.TongSoLuong.ToString("N0", viCulture)):</span>
                                                <span class="text-dark fw-medium">@item.TongTienHang.ToString("N0", viCulture)</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="text-muted">Giảm giá:</span>
                                                <span class="text-dark fw-medium">@item.GiamGia.ToString("N0", viCulture)</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 border-top pt-2">
                                                <span class="fw-bold text-dark">NCC cần trả:</span>
                                                <span class="fw-bold text-primary fs-6">@item.CanThuNcc.ToString("N0", viCulture)</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="text-muted">NCC đã trả:</span>
                                                <span class="text-dark fw-medium">@item.DaThuNcc.ToString("N0", viCulture)</span>
                                            </div>
                                            @if (item.CongNo > 0)
                                            {
                                                <div class="d-flex justify-content-between py-1 text-danger">
                                                    <span>Tính vào công nợ:</span>
                                                    <span class="fw-bold">@item.CongNo.ToString("N0", viCulture)</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Hàng nút hành động chi tiết -->
                                    <div class="dp-actions d-flex align-items-center gap-2 mt-3 pt-3 border-top">
                                        @if (item.TrangThai != "HUY")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-cancel-return" data-id="@item.MaPhieuTraHang" data-code="@item.MaPhieuHienThi" data-status="@item.TrangThai">
                                                <i class="bi bi-trash me-1"></i>Hủy
                                            </button>
                                        }
                                        <a href="@Url.Action("Create", "TraHangNhap", new { copyId = item.MaPhieuTraHang })" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-copy me-1"></i>Sao chép
                                        </a>
                                        <a href="@Url.Action("ExportExcel", "TraHangNhap", new { type = "detail", id = item.MaPhieuTraHang })" class="btn btn-sm btn-outline-secondary" target="_blank">
                                            <i class="bi bi-box-arrow-up me-1"></i>Xuất file
                                        </a>
                                        <span class="ms-auto"></span>
                                        @if (item.TrangThai != "HUY")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-quick-save-note" data-id="@item.MaPhieuTraHang">
                                                <i class="bi bi-floppy me-1"></i>Lưu
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print();">
                                            <i class="bi bi-printer me-1"></i>In
                                        </button>
                                        @if (item.TrangThai == "NHAP" || item.TrangThai == "PHIEU_TAM")
                                        {
                                            <a href="@Url.Action("Edit", "TraHangNhap", new { id = item.MaPhieuTraHang })" class="btn btn-sm btn-primary">
                                                <i class="bi bi-pencil-square me-1"></i>Mở phiếu
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Details", "TraHangNhap", new { id = item.MaPhieuTraHang })" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye me-1"></i>Xem chi tiết
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
                }
            }
            else
            {
                <tr class="empty-row">
                    <td colspan="17" class="p-0">
                        <div class="empty d-block py-5 text-center">
                            <div class="ico mb-3"><i class="bi bi-inbox fs-1 text-primary"></i></div>
                            <h5 class="fw-bold">Không tìm thấy phiếu trả hàng nhập</h5>
                            <p class="text-muted mb-0 small">Không tìm thấy giao dịch nào phù hợp với bộ lọc hiện tại.<br />Nhấn <a href="javascript:void(0)" id="resetF" class="text-primary text-decoration-none fw-semibold">vào đây</a> để xóa bộ lọc và tiếp tục tìm kiếm.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Phân trang đáy bảng dùng chung component _Pagination.cshtml của hệ thống -->
@await Html.PartialAsync("_Pagination", Model.PagedData, new ViewDataDictionary(ViewData) { { "ItemLabel", "phiếu trả hàng nhập" } })
