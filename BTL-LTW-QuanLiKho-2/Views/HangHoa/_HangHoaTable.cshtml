@model BTL_LTW_QuanLiKho_2.ViewModels.HangHoaIndexVM
@using System.Globalization
@{
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
}

<div class="kiot-table-scroll-body">
<table class="tbl" id="productTable">
    <thead>
        <tr>
            <th style="width: 38px;" class="text-center th-checkbox">
                <input class="form-check-input" type="checkbox" id="selectAllRows" />
            </th>
            <th style="width: 38px; cursor: pointer;" class="text-center th-star" onclick="toggleStarHeaderFilter(event)">
                <span class="star-btn star-header-filter @(Model.DaDanhDauFilter ? "starred" : "")" id="starHeaderFilter" title="@(Model.DaDanhDauFilter ? "Bỏ lọc sao (Hiển thị tất cả)" : "Lọc danh sách hàng được đánh dấu sao")">
                    <i class="bi @(Model.DaDanhDauFilter ? "bi-star-fill" : "bi-star")"></i>
                </span>
            </th>
            <th style="width: 50px;" class="text-center col-hinhanh">Ảnh</th>
            <th style="width: 130px;" class="col-mahang sortable-th @(Model.SortBy == "mahang" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" data-col="mahang" title="Nhấn để sắp xếp theo Mã hàng">
                <div class="th-content">
                    <span class="th-title-wrap">
                        <span class="th-text">Mã hàng</span>
                        @if (Model.SortBy == "mahang" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                        else if (Model.SortBy == "mahang" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                    </span>
                </div>
            </th>
            <th style="width: 130px;" class="col-mavach">
                <div class="th-content"><span class="th-text">Mã vạch</span></div>
            </th>
            <th style="width: 280px;" class="col-product-name col-tenhang sortable-th @(Model.SortBy == "tenhang" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" data-col="tenhang" title="Nhấn để sắp xếp theo Tên hàng">
                <div class="th-content">
                    <span class="th-title-wrap">
                        <span class="th-text">Tên hàng</span>
                        @if (Model.SortBy == "tenhang" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                        else if (Model.SortBy == "tenhang" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                    </span>
                </div>
            </th>
            <th style="width: 140px;" class="col-nhomhang">
                <div class="th-content"><span class="th-text">Nhóm hàng</span></div>
            </th>
            <th style="width: 110px;" class="col-loaihang">
                <div class="th-content"><span class="th-text">Loại hàng</span></div>
            </th>
            <th class="num col-giaban sortable-th @(Model.SortBy == "giaban" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" style="width: 115px;" data-col="giaban" title="Nhấn để sắp xếp theo Giá bán">
                <div class="th-content">
                    <span class="th-title-wrap">
                        <span class="th-text">Giá bán</span>
                        @if (Model.SortBy == "giaban" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                        else if (Model.SortBy == "giaban" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                    </span>
                </div>
            </th>
            <th class="num col-giavon sortable-th @(Model.SortBy == "giavon" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" style="width: 115px;" data-col="giavon" title="Nhấn để sắp xếp theo Giá vốn">
                <div class="th-content">
                    <span class="th-title-wrap">
                        <span class="th-text">Giá vốn</span>
                        @if (Model.SortBy == "giavon" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                        else if (Model.SortBy == "giavon" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                    </span>
                </div>
            </th>
            <th class="num col-tonkho sortable-th @(Model.SortBy == "tonkho" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" style="width: 105px;" data-col="tonkho" title="Nhấn để sắp xếp theo Tồn kho">
                <div class="th-content">
                    <span class="th-title-wrap">
                        <span class="th-text">Tồn kho</span>
                        @if (Model.SortBy == "tonkho" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                        else if (Model.SortBy == "tonkho" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                    </span>
                </div>
            </th>
            <th style="width: 130px;" class="col-vitri">
                <div class="th-content"><span class="th-text">Vị trí</span></div>
            </th>
            <th class="num col-khachdat sortable-th @(Model.SortBy == "khachdat" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" style="width: 105px;" data-col="khachdat" title="Nhấn để sắp xếp theo Khách đặt">
                <div class="th-content">
                    <span class="th-title-wrap">
                        <span class="th-text">Khách đặt</span>
                        @if (Model.SortBy == "khachdat" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                        else if (Model.SortBy == "khachdat" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                    </span>
                </div>
            </th>
            <th style="width: 150px;" class="col-ngaytao sortable-th @(Model.SortBy == "ngaytao" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" data-col="ngaytao" title="Nhấn để sắp xếp theo Thời gian tạo">
                <div class="th-content">
                    <span class="th-title-wrap">
                        <span class="th-text">Thời gian tạo</span>
                        @if (Model.SortBy == "ngaytao" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                        else if (Model.SortBy == "ngaytao" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                    </span>
                </div>
            </th>
            <th style="width: 165px;" class="col-dukienhethang sortable-th @(Model.SortBy == "dukienhethang" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" data-col="dukienhethang" title="Nhấn để sắp xếp theo Dự kiến hết hàng">
                <div class="th-content">
                    <span class="th-title-wrap">
                        <span class="th-text">Dự kiến hết hàng</span>
                        @if (Model.SortBy == "dukienhethang" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                        else if (Model.SortBy == "dukienhethang" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                    </span>
                </div>
            </th>
            <th style="width: 130px;" class="col-tontothieu num">
                <div class="th-content"><span class="th-text">Tồn ít nhất</span></div>
            </th>
            <th style="width: 140px;" class="col-toncaonhat num">
                <div class="th-content"><span class="th-text">Tồn nhiều nhất</span></div>
            </th>
            <th style="width: 160px;" class="col-trangthai">
                <div class="th-content"><span class="th-text">Trạng thái</span></div>
            </th>
        </tr>
    </thead>
    <tbody>
        <!-- Dòng tổng hợp (Summary row) cuộn tự nhiên cùng nội dung bảng -->
        <tr class="summary-row">
            <td class="text-center"></td>
            <td class="text-center"></td>
            <td class="col-hinhanh"></td>
            <td class="col-mahang"></td>
            <td class="col-mavach"></td>
            <td class="col-tenhang"></td>
            <td class="col-nhomhang"></td>
            <td class="col-loaihang"></td>
            <td class="num col-giaban"></td>
            <td class="num col-giavon"></td>
            <td class="num fw-bold text-dark col-tonkho">@Model.TotalStockSum.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</td>
            <td class="col-vitri"></td>
            <td class="num fw-bold text-dark col-khachdat">@Model.TotalKhachDatSum.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</td>
            <td class="text-muted col-ngaytao">---</td>
            <td class="text-muted col-dukienhethang">---</td>
            <td class="num col-tontothieu"></td>
            <td class="num col-toncaonhat"></td>
            <td class="col-trangthai"></td>
        </tr>
        @if (Model.Items.Any())
        {
            @foreach (var item in Model.Items)
            {
                <tr data-id="@item.MaHang" class="product-row" title="Nhấn để xem chi tiết hàng hóa">
                    <td class="text-center cell-checkbox" onclick="event.stopPropagation();">
                        <input class="form-check-input row-select" type="checkbox" value="@item.MaHang" />
                    </td>
                    <td class="text-center cell-star" style="cursor: pointer;" onclick="toggleFavoriteProduct(event, @item.MaHang, this)">
                        <span class="star-btn @(item.IsFavorite ? "starred" : "")" data-id="@item.MaHang" title="@(item.IsFavorite ? "Bỏ đánh dấu sao" : "Đánh dấu sao")">
                            <i class="bi @(item.IsFavorite ? "bi-star-fill" : "bi-star")"></i>
                        </span>
                    </td>
                    <td class="text-center p-1 col-hinhanh" onclick="event.stopPropagation();">
                        <div class="product-img-wrapper" title="@item.TenHang">
                            <img src="/HangHoa/GetImage/@item.MaHang?v=@item.ImageVersion" class="product-thumb-img" data-img-id="@item.MaHang" alt="@item.TenHang" />
                            @if (item.HasImage)
                            {
                                <div class="product-img-popover">
                                    <img src="/HangHoa/GetImage/@item.MaHang?v=@item.ImageVersion" data-popover-img-id="@item.MaHang" alt="@item.TenHang" />
                                </div>
                            }
                        </div>
                    </td>
                    <td class="col-mahang">
                        <span class="fw-semibold text-primary text-break">@item.MaHangNoiBo</span>
                    </td>
                    <td class="col-mavach text-muted small">
                        ---
                    </td>
                    <td class="cell-product-name col-tenhang">
                        <div class="fw-semibold text-dark product-name-text">@item.TenHang</div>
                        @if (!string.IsNullOrWhiteSpace(item.QuyCach))
                        {
                            <small class="text-muted d-block product-spec-text">@item.QuyCach</small>
                        }
                    </td>
                    <td class="col-nhomhang text-muted small">
                        @(!string.IsNullOrEmpty(item.TenNhom) && item.TenNhom != "---" ? item.TenNhom : "---")
                    </td>
                    <td class="col-loaihang text-muted small">
                        Hàng hóa
                    </td>
                    <td class="num text-dark col-giaban">
                        @item.GiaBan.ToString("N0", viCulture)
                    </td>
                    <td class="num text-muted col-giavon">
                        @item.GiaVon.ToString("N0", viCulture)
                    </td>
                    <td class="num col-tonkho">
                        @if (item.TonKho <= 0)
                        {
                            <span class="text-danger fw-bold">0</span>
                        }
                        else if (item.TonToiThieu.HasValue && item.TonKho < item.TonToiThieu.Value)
                        {
                            <span class="text-danger fw-bold" title="Dưới định mức tồn">
                                @item.TonKho.ToString("N0", viCulture) ⚠️
                            </span>
                        }
                        else
                        {
                            <span>@item.TonKho.ToString("N0", viCulture)</span>
                        }
                    </td>
                    <td class="col-vitri text-muted small">
                        @(!string.IsNullOrWhiteSpace(item.ViTri) ? item.ViTri : "---")
                    </td>
                    <td class="num text-muted col-khachdat">
                        @item.KhachDat
                    </td>
                    <td class="text-muted small col-ngaytao">
                        @(item.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "---")
                    </td>
                    <td class="text-muted small col-dukienhethang">
                        @item.DuKienHetHang
                    </td>
                    <td class="num text-muted small col-tontothieu">
                        @(item.TonToiThieu.HasValue ? item.TonToiThieu.Value.ToString("N0", viCulture) : "0")
                    </td>
                    <td class="num text-muted small col-toncaonhat">
                        @(item.TonCaoNhat.HasValue && item.TonCaoNhat.Value < 999999999 ? item.TonCaoNhat.Value.ToString("N0", viCulture) : "---")
                    </td>
                    <td class="col-trangthai small">
                        @if (item.TrangThai == "DANG_BAN")
                        {
                            <span class="text-primary fw-medium">Cho phép kinh doanh</span>
                        }
                        else
                        {
                            <span class="text-danger fw-medium">Ngừng kinh doanh</span>
                        }
                    </td>
                </tr>

                <!-- Dòng chi tiết mở rộng (KiotViet Inline Detail Panel với 4 Tabs) -->
                <tr class="product-detail-row" id="detail-@item.MaHang" style="display: none;">
                    <td colspan="100" class="p-0">
                        <div class="product-detail-panel-wrap" style="display: none;">
                            <div class="product-detail-panel">
                                <!-- Tabs Header Bar -->
                                <div class="product-detail-tabs">
                                    <button type="button" class="product-detail-tab-btn active" data-tab="info">Thông tin</button>
                                    <button type="button" class="product-detail-tab-btn" data-tab="desc">Mô tả, ghi chú</button>
                                    <button type="button" class="product-detail-tab-btn" data-tab="thekho">Thẻ kho</button>
                                    <button type="button" class="product-detail-tab-btn" data-tab="tonkho">Tồn kho</button>
                                </div>

                                <!-- Tabs Content -->
                                <div class="product-detail-tab-content">
                                    <!-- ================= TAB 1: THÔNG TIN ================= -->
                                    <div class="tab-pane-content tab-info">
                                        <div class="d-flex gap-4 align-items-start mb-4">
                                            <div class="product-detail-img-box">
                                                <img src="/HangHoa/GetImage/@item.MaHang?v=@item.ImageVersion" data-detail-img-id="@item.MaHang" alt="@item.TenHang" onerror="this.src='/images/no-image.png'" />
                                            </div>
                                            <div class="flex-grow-1" style="min-width: 0;">
                                                <h4 class="product-detail-title mb-1">@item.TenHang</h4>
                                                <div class="text-muted small mb-2">
                                                    Nhóm hàng: <span class="text-dark fw-semibold">@(!string.IsNullOrEmpty(item.TenNhom) && item.TenNhom != "---" ? item.TenNhom : "Chưa có nhóm")</span>
                                                </div>
                                                <div class="d-flex flex-wrap gap-2">
                                                    <span class="badge-kiot-tag">Hàng hóa thường</span>
                                                    <span class="badge-kiot-tag">Bán trực tiếp</span>
                                                    <span class="badge-kiot-tag badge-kiot-warning">Không tích điểm</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Grid thông tin thuộc tính (4 cột như ảnh KiotViet) -->
                                        <div class="row g-3 mb-3 product-attr-grid">
                                            <div class="col-md-3">
                                                <div class="attr-item">
                                                    <div class="attr-label">Mã hàng</div>
                                                    <div class="attr-value">@item.MaHangNoiBo</div>
                                                </div>
                                                <div class="attr-item">
                                                    <div class="attr-label">Giá vốn</div>
                                                    <div class="attr-value">@item.GiaVon.ToString("N0", viCulture)</div>
                                                </div>
                                                <div class="attr-item">
                                                    <div class="attr-label">Trọng lượng</div>
                                                    <div class="attr-value @(item.TrongLuong.HasValue && item.TrongLuong.Value > 0 ? "" : "text-muted")">
                                                        @(item.TrongLuong.HasValue && item.TrongLuong.Value > 0 ? $"{item.TrongLuong.Value.ToString("G29")} {item.DonViTrongLuong}" : "Chưa có")
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="attr-item">
                                                    <div class="attr-label">Mã vạch</div>
                                                    <div class="attr-value text-muted">@(string.IsNullOrWhiteSpace(item.QuyCach) ? "Chưa có" : item.QuyCach)</div>
                                                </div>
                                                <div class="attr-item">
                                                    <div class="attr-label">Giá bán</div>
                                                    <div class="attr-value">@item.GiaBan.ToString("N0", viCulture)</div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="attr-item">
                                                    <div class="attr-label">Tồn kho</div>
                                                    <div class="attr-value">@item.TonKho.ToString("N0", viCulture)</div>
                                                </div>
                                                <div class="attr-item">
                                                    <div class="attr-label">Đơn vị tính</div>
                                                    <div class="attr-value text-dark fw-semibold">@item.TenDvt</div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="attr-item">
                                                    <div class="attr-label">Định mức tồn</div>
                                                    <div class="attr-value">
                                                        @(item.TonToiThieu?.ToString("N0", viCulture) ?? "0") - @(item.TonCaoNhat.HasValue ? (item.TonCaoNhat.Value >= 999999999m ? "999,999,999" : item.TonCaoNhat.Value.ToString("N0", viCulture)) : "999,999,999")
                                                    </div>
                                                </div>
                                                <div class="attr-item">
                                                    <div class="attr-label">Vị trí</div>
                                                    <div class="attr-value @(!string.IsNullOrWhiteSpace(item.ViTri) ? "text-primary fw-semibold" : "text-muted")">
                                                        @(!string.IsNullOrWhiteSpace(item.ViTri) ? item.ViTri : "Chưa có")
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Hộp Nhà cung cấp -->
                                        <div class="supplier-box mb-3 p-3 rounded-2">
                                            <div class="supplier-label small fw-semibold text-secondary mb-1">Nhà cung cấp</div>
                                            <div class="supplier-names text-dark small">
                                                @(Model.DonViCapHangs.Any() 
                                                    ? string.Join(", ", Model.DonViCapHangs.Select(s => s.TenDonVi)) 
                                                    : "Công ty TNHH Citigo, Cửa hàng Đại Việt, Công ty Pharmedic, Công ty Hoàng Gia, Đại lý Hồng Phúc")
                                            </div>
                                        </div>

                                        <!-- Danh sách Thuộc tính động -->
                                        @if (item.ThuocTinhs.Any())
                                        {
                                            <div class="mb-3">
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var attr in item.ThuocTinhs)
                                                    {
                                                        <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 12px;">
                                                            <strong class="text-secondary">@attr.Ten:</strong> @attr.GiaTri
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <!-- Thanh nút thao tác cuối dòng chi tiết -->
                                        <div class="d-flex justify-content-between align-items-center pt-3 border-top product-detail-footer">
                                            <div class="d-flex gap-2 product-detail-footer-left">
                                                <button type="button" class="btn btn-outline-secondary btn-sm btn-delete-product" data-id="@item.MaHang" data-name="@item.TenHang">
                                                    <i class="bi bi-trash me-1"></i> Xóa
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm btn-copy-product" data-id="@item.MaHang">
                                                    <i class="bi bi-copy me-1"></i> Sao chép
                                                </button>
                                            </div>
                                            <div class="d-flex gap-2 product-detail-footer-right">
                                                <button type="button" class="btn btn-primary btn-sm btn-edit-product" data-id="@item.MaHang">
                                                    <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm">
                                                    <i class="bi bi-printer me-1"></i> In tem mã
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm">
                                                    <i class="bi bi-three-dots"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ================= TAB 2: MÔ TẢ, GHI CHÚ ================= -->
                                    <div class="tab-pane-content tab-desc" style="display: none;">
                                        <div class="border rounded-2 p-3 mb-3 bg-white">
                                            <div class="fw-semibold text-secondary small mb-2">Mô tả</div>
                                            <div class="text-muted small">
                                                @(string.IsNullOrWhiteSpace(item.QuyCach) ? "Chưa có mô tả" : item.QuyCach)
                                            </div>
                                        </div>

                                        <div class="border rounded-2 p-3 mb-4 bg-white">
                                            <div class="fw-semibold text-secondary small mb-2">Ghi chú đặt hàng</div>
                                            <div class="text-muted small">Chưa có ghi chú</div>
                                        </div>

                                        <div class="d-flex justify-content-end pt-3 border-top product-detail-footer">
                                            <div class="product-detail-footer-right">
                                                <button type="button" class="btn btn-primary btn-sm btn-edit-product" data-id="@item.MaHang">
                                                    <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ================= TAB 3: THẺ KHO ================= -->
                                    <div class="tab-pane-content tab-thekho" style="display: none;">
                                        <div class="table-responsive mb-3 border rounded-2">
                                            <table class="thekho-table table table-sm mb-0">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 120px;">Chứng từ</th>
                                                        <th style="width: 140px;">Thời gian</th>
                                                        <th style="width: 120px;">Loại giao dịch</th>
                                                        <th class="text-end" style="width: 110px;">Giá GD <i class="bi bi-info-circle text-muted" title="Giá giao dịch"></i></th>
                                                        <th class="text-end" style="width: 110px;">Giá vốn</th>
                                                        <th class="text-end" style="width: 90px;">Số lượng</th>
                                                        <th class="text-end" style="width: 90px;">Tồn cuối</th>
                                                        <th>Đối tác</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
