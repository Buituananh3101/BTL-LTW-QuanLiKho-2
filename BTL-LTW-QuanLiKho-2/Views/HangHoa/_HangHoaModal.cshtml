@model BTL_LTW_QuanLiKho_2.ViewModels.HangHoaIndexVM

<!-- ========================================================================
     MODAL CHÍNH: TẠO & CẬP NHẬT HÀNG HÓA CHUẨN KIOTVIET (PROTOTYPE MATCH)
     Hỗ trợ tối đa 5 ảnh trực tiếp CSDL, Tab Mô tả, Khối gập accordion
     ======================================================================== -->

<!-- Sprite icon SVG dùng cho modal -->
<svg style="display:none" xmlns="http://www.w3.org/2000/svg">
  <symbol id="i-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></symbol>
  <symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></symbol>
  <symbol id="i-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></symbol>
  <symbol id="i-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 10v7M14 10v7"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></symbol>
  <symbol id="i-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></symbol>
  <symbol id="i-img" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M3 17l5-5 4 4 3-3 6 6"/></symbol>
  <symbol id="i-pencil" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></symbol>
</svg>

<div class="hh-ov" id="hangHoaModalOv">
  <div class="hh-modal main" role="dialog" aria-modal="true" aria-labelledby="hhModalTitle">
    <!-- Header Modal -->
    <div class="hh-m-head">
      <h2 id="hhModalTitle">Tạo hàng hóa</h2>
      <button type="button" class="hh-x" data-close="hangHoaModalOv" aria-label="Đóng">
        <svg style="width:18px;height:18px;"><use href="#i-x"/></svg>
      </button>
      <div class="hh-tabs">
        <button type="button" class="hh-tab on" data-tab="info">Thông tin</button>
        <button type="button" class="hh-tab" data-tab="desc">Mô tả</button>
      </div>
    </div>

    <!-- Body Modal -->
    <div class="hh-m-body" id="hhModalBody">
      <form id="hhForm" onsubmit="return false;">
        <input type="hidden" id="formMaHang" value="0" />

        <!-- ---- TAB 1: THÔNG TIN ---- -->
        <div class="hh-pane on" id="hh-pane-info">
          <div class="hh-top-grid" style="position: relative; z-index: 30;">
            <!-- Cột trái: Các trường thông tin cơ bản -->
            <div class="hh-fields">
              <div class="hh-f">
                <label for="formMaHangNoiBo">Mã hàng</label>
                <input type="text" id="formMaHangNoiBo" placeholder="Tự động" autocomplete="off" />
              </div>
              <div class="hh-f">
                <label for="formQuyCach">Mã vạch</label>
                <input type="text" id="formQuyCach" placeholder="Nhập mã vạch" autocomplete="off" />
              </div>
              <div class="hh-f hh-span2" id="hhFldTen">
                <label for="formTenHang">Tên hàng <span style="color:var(--hh-danger)">*</span></label>
                <input type="text" id="formTenHang" placeholder="Bắt buộc" autocomplete="off" />
                <span class="hh-err">Vui lòng nhập tên hàng.</span>
              </div>
              <div class="hh-f" id="hhFldNhom">
                <label for="inputMaNhom">Nhóm hàng <button type="button" class="hh-link" id="btnNewNhom" data-new="nhom">+ Tạo mới</button></label>
                <div class="hh-cs-wrap" id="wrapMaNhom" data-select-id="#formMaNhom">
                  <div class="hh-cs-box" id="boxMaNhom">
                    <input type="text" class="hh-cs-input" id="inputMaNhom" placeholder="Chọn nhóm hàng (Bắt buộc)" readonly autocomplete="off" />
                    <svg class="hh-cs-arrow" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
                  </div>
                  <div class="hh-cs-dropdown" id="dropdownMaNhom" style="display: none;">
                    <div class="hh-cs-search">
                      <input type="text" id="searchMaNhom" placeholder="Tìm nhóm hàng..." autocomplete="off" />
                    </div>
                    <div class="hh-cs-list" id="listMaNhom">
                      @foreach (var g in Model.NhomHangs)
                      {
                        <div class="hh-cs-item" data-val="@g.MaNhom">
                          <span>@g.TenNhom</span>
                          <svg class="hh-check-icon" viewBox="0 0 24 24"><path d="M4 12l5 5L20 6"/></svg>
                        </div>
                      }
                    </div>
                  </div>
                </div>
                <select id="formMaNhom" style="display: none;">
                  <option value="">Chọn nhóm hàng (Bắt buộc)</option>
                  @foreach (var g in Model.NhomHangs)
                  {
                    <option value="@g.MaNhom">@g.TenNhom</option>
                  }
                </select>
                <span class="hh-err">Vui lòng chọn nhóm hàng.</span>
              </div>
              <!-- Thay thế Thương hiệu bằng Đơn vị tính theo yêu cầu của dự án -->
              <div class="hh-f" id="hhFldDvt">
                <label for="inputMaDvt">Đơn vị tính <button type="button" class="hh-link" id="btnNewDvt" data-new="dvt">+ Tạo mới</button></label>
                <div class="hh-cs-wrap" id="wrapMaDvt" data-select-id="#formMaDvt">
                  <div class="hh-cs-box" id="boxMaDvt">
                    <input type="text" class="hh-cs-input" id="inputMaDvt" placeholder="Chọn ĐVT (Bắt buộc)" readonly autocomplete="off" />
                    <svg class="hh-cs-arrow" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
                  </div>
                  <div class="hh-cs-dropdown" id="dropdownMaDvt" style="display: none;">
                    <div class="hh-cs-search">
                      <input type="text" id="searchMaDvt" placeholder="Tìm đơn vị tính..." autocomplete="off" />
                    </div>
                    <div class="hh-cs-list" id="listMaDvt">
                      @foreach (var u in Model.DonViTinhs)
                      {
                        <div class="hh-cs-item" data-val="@u.MaDvt">
                          <span>@u.TenDvt</span>
                          <svg class="hh-check-icon" viewBox="0 0 24 24"><path d="M4 12l5 5L20 6"/></svg>
                        </div>
                      }
                    </div>
                  </div>
                </div>
                <select id="formMaDvt" style="display: none;">
                  <option value="">Chọn ĐVT (Bắt buộc)</option>
                  @foreach (var u in Model.DonViTinhs)
                  {
                    <option value="@u.MaDvt">@u.TenDvt</option>
                  }
                </select>
                <span class="hh-err">Vui lòng chọn đơn vị tính.</span>
              </div>
            </div>

            <!-- Cột phải: Quản lý 5 ảnh sản phẩm -->
            <div class="hh-imgs">
              <div class="hh-img-main" id="hhImgMain" title="Bấm để chọn ảnh từ máy tính">
                <svg class="hh-ic" style="width:44px;height:44px;"><use href="#i-img"/></svg>
                <span>Chưa có ảnh</span>
              </div>
              <div class="hh-thumbs" id="hhThumbs">
                <!-- Dynamic thumbnails render via JS (tối đa 5 ảnh) -->
              </div>
              <input type="file" id="hhImgFile" accept="image/*" multiple hidden />
              <input type="file" id="hhImgFileReplaceMain" accept="image/*" hidden />
            </div>
          </div>

          <!-- Section 1: Giá vốn, giá bán -->
          <section class="hh-sec open">
            <div class="hh-sec-h">
              <div><h3>Giá vốn, giá bán</h3></div>
              <svg class="hh-chev"><use href="#i-chev"/></svg>
            </div>
            <div class="hh-sec-b">
              <div class="hh-row">
                <div class="hh-f">
                  <label for="formGiaVon">Giá vốn</label>
                  <input type="text" id="formGiaVon" class="hh-num" value="0" inputmode="numeric" />
                </div>
                <div class="hh-f">
                  <label for="formGiaBan">Giá bán</label>
                  <input type="text" id="formGiaBan" class="hh-num" value="0" inputmode="numeric" />
                </div>
              </div>
            </div>
          </section>

          <!-- Section 2: Tồn kho & Định mức -->
          <section class="hh-sec open">
            <div class="hh-sec-h">
              <div>
                <h3>Tồn kho</h3>
                <p>Quản lý số lượng tồn kho và định mức tồn. Khi tồn kho chạm đến định mức, bạn sẽ nhận được cảnh báo từ hệ thống.</p>
              </div>
              <svg class="hh-chev"><use href="#i-chev"/></svg>
            </div>
            <div class="hh-sec-b">
              <div class="hh-row">
                <div class="hh-f" id="boxInitialStock">
                  <label for="formTonKhoBanDau">Tồn kho ban đầu</label>
                  <input type="text" id="formTonKhoBanDau" class="hh-num" value="0" inputmode="numeric" />
                </div>
                <div class="hh-f">
                  <label for="formTonToiThieu">Định mức tồn thấp nhất</label>
                  <input type="text" id="formTonToiThieu" class="hh-num" value="0" inputmode="numeric" />
                </div>
                <div class="hh-f">
                  <label for="formTonCaoNhat">Định mức tồn cao nhất</label>
                  <input type="text" id="formTonCaoNhat" class="hh-num" value="999,999,999" inputmode="numeric" />
                </div>
              </div>
            </div>
          </section>

          <!-- Section 3: Vị trí, trọng lượng -->
          <section class="hh-sec open" style="position: relative; z-index: 20;">
            <div class="hh-sec-h">
              <div>
                <h3>Vị trí, trọng lượng</h3>
                <p>Quản lý việc sắp xếp kho, vị trí bán hàng hoặc trọng lượng hàng hóa</p>
              </div>
              <svg class="hh-chev"><use href="#i-chev"/></svg>
            </div>
            <div class="hh-sec-b" style="overflow: visible;">
              <div class="hh-row">
                <div class="hh-f hh-w2">
                  <label for="formViTriSearch">
                    <span>Vị trí</span>
                    <button type="button" class="hh-link" id="btnNewViTri" data-new="vitri">Tạo mới</button>
                  </label>
                  <div class="hh-multiselect-wrap" id="formViTriWrap">
                    <div class="hh-multiselect-box" id="formViTriBox">
                      <span class="hh-multiselect-tags" id="formViTriTags"></span>
                      <input type="text" id="formViTriSearch" placeholder="Chọn hoặc nhập vị trí..." autocomplete="off" />
                    </div>
                    <div class="hh-multiselect-dropdown" id="formViTriDropdown" style="display: none;">
                      <div class="hh-multiselect-list" id="formViTriList">
                        <!-- Dynamic items rendered via JS -->
                      </div>
                    </div>
                  </div>
                  <input type="hidden" id="formViTri" value="" />
                </div>
                <div class="hh-f hh-w2">
                  <label for="formTrongLuong">Trọng lượng</label>
                  <div class="hh-weight">
                    <input type="text" id="formTrongLuong" class="hh-num" value="0" inputmode="decimal" />
                    <div class="hh-cs-wrap" id="wrapDonViTrongLuong" data-select-id="#formDonViTrongLuong" style="width: 75px; flex: none;">
                      <div class="hh-cs-box" id="boxDonViTrongLuong" style="border-top-left-radius: 0; border-bottom-left-radius: 0; border-left: 0; padding: 0 8px;">
                        <input type="text" class="hh-cs-input" id="inputDonViTrongLuong" value="g" readonly style="text-align: center; cursor: pointer;" />
                        <svg class="hh-cs-arrow" viewBox="0 0 24 24" style="width: 14px; height: 14px;"><path d="M6 9l6 6 6-6"/></svg>
                      </div>
                      <div class="hh-cs-dropdown" id="dropdownDonViTrongLuong" style="display: none; min-width: 75px;">
                        <div class="hh-cs-list" id="listDonViTrongLuong">
                          <div class="hh-cs-item selected" data-val="g">
                            <span>g</span>
                            <svg class="hh-check-icon" viewBox="0 0 24 24"><path d="M4 12l5 5L20 6"/></svg>
                          </div>
                          <div class="hh-cs-item" data-val="kg">
                            <span>kg</span>
                            <svg class="hh-check-icon" viewBox="0 0 24 24"><path d="M4 12l5 5L20 6"/></svg>
                          </div>
                        </div>
                      </div>
                    </div>
                    <select id="formDonViTrongLuong" style="display: none;">
                      <option value="g" selected>g</option>
                      <option value="kg">kg</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Section 4: Thuộc tính hàng hóa (bỏ phần quy đổi đơn vị tính theo yêu cầu) -->
          <section class="hh-sec open" style="position: relative; z-index: 10; overflow: visible;">
            <div class="hh-sec-h">
              <div>
                <h3>Thuộc tính</h3>
                <p>Thêm đặc điểm như hương vị, dung tích, màu sắc</p>
              </div>
              <svg class="hh-chev"><use href="#i-chev"/></svg>
            </div>
            <div class="hh-sec-b" style="overflow: visible;">
              <div id="hhAttrRows"></div>
              <button type="button" class="hh-add-link" id="hhAddAttr">
                <svg style="width:16px;height:16px;"><use href="#i-plus"/></svg> Thêm thuộc tính
              </button>
            </div>
          </section>
        </div>

        <!-- ---- TAB 2: MÔ TẢ ---- -->
        <div class="hh-pane" id="hh-pane-desc">
          <div class="hh-rte-bar">
            <button type="button" data-cmd="bold" title="In đậm"><b>B</b></button>
            <button type="button" data-cmd="italic" title="In nghiêng"><i>I</i></button>
            <button type="button" data-cmd="underline" title="Gạch chân"><u>U</u></button>
            <button type="button" data-cmd="insertUnorderedList" title="Danh sách dấu chấm">•</button>
          </div>
          <div class="hh-rte" id="formMoTa" contenteditable="true" data-ph="Nhập mô tả chi tiết hàng hóa, bảo quản, hướng dẫn sử dụng…"></div>
        </div>
      </form>
    </div>

    <!-- Footer Modal -->
    <div class="hh-m-foot">
      <button type="button" class="hh-btn-del" id="btnDeleteProductInModal" style="display: none; margin-right: 12px;" title="Xóa hàng hóa này">
        <svg style="width:16px;height:16px;vertical-align:middle;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;margin-right:4px;"><use href="#i-trash"/></svg>
        <span>Xóa</span>
      </button>
      <label class="hh-chk">
        <input type="checkbox" id="chkBanTrucTiep" checked />
        <span>Bán trực tiếp</span>
      </label>
      <span class="hh-info">
        <svg style="width:18px;height:18px;"><use href="#i-info"/></svg>
        <span class="hh-tip">Hàng hóa được phép bán trực tiếp trên màn hình bán hàng (POS).</span>
      </span>
      <span class="sp"></span>
      <button type="button" class="hh-btn" data-close="hangHoaModalOv">Bỏ qua</button>
      <div class="hh-split">
        <button type="button" class="hh-btn" id="btnSaveAgain">Lưu &amp; Tạo thêm hàng</button>
        <button type="button" class="hh-btn caret" id="btnCaret" aria-label="Thêm tùy chọn">
          <svg style="width:14px;height:14px;"><use href="#i-chev"/></svg>
        </button>
        <div class="hh-menu" id="hhSplitMenu">
          <button type="button" id="btnSaveCopy">Lưu &amp; Sao chép</button>
        </div>
      </div>
      <button type="button" class="hh-btn primary" id="btnSaveProduct">Lưu</button>
    </div>
  </div>
</div>

<!-- ===== MODAL CON 1: NHẬP TÊN NHANH (Nhóm hàng / Đơn vị tính / Vị trí / Thuộc tính) ===== -->
<div class="hh-ov" id="hhPromptOv">
  <div class="hh-modal small" role="dialog" aria-modal="true" aria-labelledby="pTitle">
    <div class="hh-m-head">
      <h2 id="pTitle">Tạo mới</h2>
      <button type="button" class="hh-x" data-close="hhPromptOv" aria-label="Đóng">
        <svg style="width:18px;height:18px;"><use href="#i-x"/></svg>
      </button>
    </div>
    <div class="hh-m-body">
      <div class="hh-f" id="pField">
        <label for="pInput" id="pLabel">Tên</label>
        <input type="text" id="pInput" autocomplete="off" />
        <span class="hh-err" id="pErr">Vui lòng nhập thông tin.</span>
      </div>
    </div>
    <div class="hh-m-foot">
      <span class="sp"></span>
      <button type="button" class="hh-btn" data-close="hhPromptOv">Bỏ qua</button>
      <button type="button" class="hh-btn primary" id="pSave">Lưu</button>
    </div>
  </div>
</div>

<!-- ===== MODAL CON 2: CHỌN GIÁ TRỊ THUỘC TÍNH (Chips / Search / Sort) ===== -->
<div class="hh-ov" id="hhPickOv">
  <div class="hh-modal pick" role="dialog" aria-modal="true" aria-labelledby="pkTitle">
    <div class="hh-m-head">
      <h2 id="pkTitle">Chọn giá trị thuộc tính</h2>
      <button type="button" class="hh-x" data-close="hhPickOv" aria-label="Đóng">
        <svg style="width:18px;height:18px;"><use href="#i-x"/></svg>
      </button>
    </div>
    <div class="hh-m-body">
      <div class="hh-pk-bar">
        <div class="hh-pk-search">
          <svg class="hh-ic"><use href="#i-search"/></svg>
          <input type="text" id="pkSearch" placeholder="Tìm kiếm giá trị..." autocomplete="off" />
        </div>
        <!-- Custom Dropdown Sắp xếp A-Z / Z-A chuẩn KiotViet -->
        <div class="hh-pk-sort-wrap" id="wrapPkSort">
          <div class="hh-pk-sort-box" id="boxPkSort" tabindex="0">
            <span id="textPkSort">A → Z</span>
            <svg class="hh-pk-sort-arrow"><use href="#i-chev"/></svg>
          </div>
          <div class="hh-pk-sort-dropdown" id="dropdownPkSort">
            <div class="hh-pk-sort-item selected" data-val="asc">
              <span>A → Z</span>
              <svg class="hh-check-icon"><use href="#i-check"/></svg>
            </div>
            <div class="hh-pk-sort-item" data-val="desc">
              <span>Z → A</span>
              <svg class="hh-check-icon"><use href="#i-check"/></svg>
            </div>
          </div>
          <select id="pkSort" style="display:none">
            <option value="asc" selected>A → Z</option>
            <option value="desc">Z → A</option>
          </select>
        </div>
        <span class="sp" style="flex:1"></span>
        <button type="button" class="hh-link" id="pkAll" style="font-size:14.5px;font-weight:600">Chọn tất cả</button>
      </div>
      <div class="hh-pk-chips" id="pkChips"></div>
    </div>
    <div class="hh-m-foot">
      <span class="sp"></span>
      <button type="button" class="hh-btn" data-close="hhPickOv">Bỏ qua</button>
      <button type="button" class="hh-btn primary" id="pkDone">Xong</button>
    </div>
  </div>
</div>

<!-- ===== MODAL CON 3: SỬA / XÓA VỊ TRÍ & THUỘC TÍNH (Chuẩn KiotViet) ===== -->
<div class="hh-ov" id="hhEditItemOv">
  <div class="hh-modal small" role="dialog" aria-modal="true" aria-labelledby="editItemTitle" style="max-width: 480px;">
    <div class="hh-m-head">
      <h2 id="editItemTitle">Sửa vị trí</h2>
      <button type="button" class="hh-x" data-close="hhEditItemOv" aria-label="Đóng">
        <svg style="width:18px;height:18px;"><use href="#i-x"/></svg>
      </button>
    </div>
    <div class="hh-m-body">
      <div class="hh-f" id="editItemField">
        <label for="editItemInput" id="editItemLabel">Vị trí</label>
        <input type="text" id="editItemInput" autocomplete="off" />
        <span class="hh-err" id="editItemErr">Vui lòng nhập thông tin.</span>
      </div>
    </div>
    <div class="hh-m-foot" style="display: flex; justify-content: space-between; align-items: center;">
      <button type="button" class="hh-btn-del" id="btnEditItemDelete">
        <svg style="width:16px;height:16px;vertical-align:middle;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;margin-right:4px;"><use href="#i-trash"/></svg>
        <span>Xóa</span>
      </button>
      <div style="display: flex; gap: 8px;">
        <button type="button" class="hh-btn" data-close="hhEditItemOv">Bỏ qua</button>
        <button type="button" class="hh-btn primary" id="btnEditItemSave">Lưu</button>
      </div>
    </div>
  </div>
</div>

<!-- ===== MODAL CON 4: XÁC NHẬN XÓA HÀNG HÓA (Chuẩn KiotViet) ===== -->
<div class="hh-ov" id="hhDeleteProductOv">
  <div class="hh-modal small" role="dialog" aria-modal="true" aria-labelledby="delProdTitle" style="max-width: 480px;">
    <div class="hh-m-head" style="border-bottom: 1px solid var(--hh-line-l); padding-bottom: 12px;">
      <h2 id="delProdTitle" style="color: #dc2626; display: flex; align-items: center; gap: 8px; margin: 0; font-size: 18px;">
        <svg style="width:20px;height:20px;stroke:#dc2626;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;"><use href="#i-trash"/></svg>
        <span>Xóa hàng hóa</span>
      </h2>
      <button type="button" class="hh-x" data-close="hhDeleteProductOv" aria-label="Đóng">
        <svg style="width:18px;height:18px;"><use href="#i-x"/></svg>
      </button>
    </div>
    <div class="hh-m-body" style="padding: 20px 24px; font-size: 14.5px; line-height: 1.5;">
      <input type="hidden" id="delProdId" value="0" />
      <div id="delProdConfirmMsg" style="color: #374151;">
        Bạn có chắc chắn muốn xóa hàng hóa <strong id="delProdName" style="color: #111827;"></strong>? Thao tác này không thể hoàn tác.
      </div>

      <!-- Khối cảnh báo khi hàng hóa đã phát sinh giao dịch không thể xóa -->
      <div id="delProdErrorBox" style="display: none; margin-top: 14px; padding: 12px 14px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b; font-size: 13.5px; line-height: 1.5;">
        <div style="display: flex; gap: 8px; align-items: flex-start;">
          <svg style="width:18px;height:18px;flex:none;stroke:#dc2626;fill:none;stroke-width:2;margin-top:2px;"><use href="#i-info"/></svg>
          <div style="flex: 1;">
            <div id="delProdErrorMsg" style="font-weight: 500; margin-bottom: 8px;"></div>
            <button type="button" class="hh-btn" id="btnSwitchNgungBan" style="background:#fff;border-color:#fca5a5;color:#b91c1c;height:32px;font-size:13px;padding:0 12px;font-weight:600;">
              Chuyển sang "Ngừng bán" ngay
            </button>
          </div>
        </div>
      </div>
    </div>
    <div class="hh-m-foot" style="background: #f9fafb; border-top: 1px solid var(--hh-line-l); padding: 12px 24px; display: flex; justify-content: flex-end; gap: 10px;">
      <button type="button" class="hh-btn" data-close="hhDeleteProductOv">Bỏ qua</button>
      <button type="button" class="hh-btn danger" id="btnConfirmDeleteProd">Đồng ý xóa</button>
    </div>
  </div>
</div>

<!-- Toast thông báo nổi -->
<div class="hh-toast" id="hhToast"></div>
