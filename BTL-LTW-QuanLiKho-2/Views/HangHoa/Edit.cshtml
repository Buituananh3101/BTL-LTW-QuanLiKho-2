@model BTL_LTW_QuanLiKho_2.ViewModels.HangHoaForm
@{
    ViewData["Title"] = "Sửa hàng hóa: " + Model.TenHang;
}

<div class="page">
    <div class="page-head">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" class="btn btn-tool" title="Quay lại danh sách">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h1 class="mb-0">Cập nhật hàng hóa</h1>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="modal-card-section">
                <form asp-action="Edit" asp-route-id="@Model.MaHang" method="post">
                    <input type="hidden" asp-for="MaHang" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="MaHangNoiBo" class="form-label small fw-bold">Mã hàng</label>
                            <input asp-for="MaHangNoiBo" class="form-control" />
                            <span asp-validation-for="MaHangNoiBo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="QuyCach" class="form-label small fw-bold">Mã vạch / Quy cách</label>
                            <input asp-for="QuyCach" class="form-control" placeholder="Quy cách đóng gói" />
                            <span asp-validation-for="QuyCach" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="TenHang" class="form-label small fw-bold">Tên hàng hóa <span class="text-danger">*</span></label>
                            <input asp-for="TenHang" class="form-control" required />
                            <span asp-validation-for="TenHang" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MaNhom" class="form-label small fw-bold">Nhóm hàng <span class="text-danger">*</span></label>
                            <select asp-for="MaNhom" asp-items="ViewBag.NhomHang" class="form-select" required></select>
                            <span asp-validation-for="MaNhom" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MaDvt" class="form-label small fw-bold">Đơn vị tính <span class="text-danger">*</span></label>
                            <select asp-for="MaDvt" asp-items="ViewBag.DonViTinh" class="form-select" required></select>
                            <span asp-validation-for="MaDvt" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GiaBanThamKhao" class="form-label small fw-bold">Giá bán tham khảo (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="GiaBanThamKhao" type="number" step="1000" min="0" class="form-control" required />
                            <span asp-validation-for="GiaBanThamKhao" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TrangThai" class="form-label small fw-bold">Trạng thái</label>
                            <select asp-for="TrangThai" asp-items="ViewBag.States" class="form-select"></select>
                            <span asp-validation-for="TrangThai" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Bỏ qua</a>
                        <button type="submit" class="btn btn-brand">Cập nhật hàng hóa</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
