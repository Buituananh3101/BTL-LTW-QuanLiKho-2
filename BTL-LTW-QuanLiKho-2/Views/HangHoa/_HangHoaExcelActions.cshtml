<!-- ========================================================================
     NÚT NHẬP & XUẤT FILE EXCEL HÀNG HÓA CHUẨN KIOTVIET
     Tách thành 2 nút độc lập: 1 nút Nhập file và 1 nút Xuất file
     ======================================================================== -->
<!-- 1. Nút Nhập file -->
<button type="button" class="btn btn-tool" id="btnOpenImportModal" onclick="window.openImportModal();" title="Nhập hàng hóa từ file Excel">
    <i class="bi bi-box-arrow-in-down me-1 text-primary"></i>
    <span class="d-none d-sm-inline">Nhập file</span>
</button>

<!-- 2. Nút Xuất file -->
<button type="button" class="btn btn-tool" id="btnOpenExportModal" onclick="window.openExportModal();" title="Xuất danh sách hàng hóa ra Excel">
    <i class="bi bi-box-arrow-up me-1 text-success"></i>
    <span class="d-none d-sm-inline">Xuất file</span>
</button>
