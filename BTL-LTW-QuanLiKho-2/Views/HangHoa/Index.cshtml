@model BTL_LTW_QuanLiKho_2.ViewModels.HangHoaIndexVM
@{
    ViewData["Title"] = "Hàng hóa";
}

<link rel="stylesheet" href="~/css/hang-hoa-form.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/hang-hoa-excel.css" asp-append-version="true" />

<!-- Cấu hình dữ liệu ban đầu cho JavaScript (tránh inline script trong view) -->
<div id="hangHoaConfig"
     data-page="@Model.Page"
     data-sort-by="@(Model.SortBy ?? "")"
     data-sort-dir="@(Model.SortDir ?? "")"
     data-du-kien="@(Model.DuKienFilter ?? "ALL")"
     data-tg-tao="@(Model.TgTaoFilter ?? "ALL")"
     data-is-starred="@(Model.DaDanhDauFilter ? "true" : "false")"
     style="display:none;"></div>

<div class="kiot-container position-relative" id="kiotContainer">
    <!-- 1. CỘT BÊN TRÁI: TIÊU ĐỀ + 7 BỘ LỌC KIOTVIET (PARTIAL VIEW) -->
    <partial name="_HangHoaFilterSidebar" model="Model" />

    <!-- Backdrop che mờ khi mở bộ lọc trên mobile/zoom in -->
    <div class="kiot-sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Nút tròn thu gọn / mở rộng ở ranh giới giữa sidebar và bảng (Phím tắt F4) -->
    <button type="button" class="kiot-sidebar-toggle-btn d-none d-lg-flex" id="btnToggleSidebar" title="Thu gọn bộ lọc (F4)">
        <i class="bi bi-chevron-left" id="sidebarToggleIcon"></i>
    </button>

    <!-- 2. CỘT BÊN PHẢI: THANH TÌM KIẾM + TOOLBAR + BẢNG HÀNG HÓA -->
    <main class="kiot-main-col">
        <!-- Toolbar trên cùng: Thanh tìm kiếm thẳng hàng với bảng bên dưới -->
        <div class="kiot-toolbar-row">
            <!-- Tiêu đề + Nút phễu bộ lọc trên mobile / zoom in -->
            <div class="kiot-mobile-title-wrap d-lg-none d-flex align-items-center gap-2">
                <span class="kiot-mobile-title fw-bold fs-6 text-dark">Hàng hóa</span>
                <button type="button" class="btn btn-sm btn-outline-primary kiot-btn-funnel" id="btnMobileFilter" title="Mở bộ lọc hàng hóa">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>

            <div class="kiot-search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="keywordSearch" class="form-control" placeholder="Theo mã, tên hàng (F3)" value="@Model.Q" autocomplete="off" />
            </div>

            <div class="kiot-actions-group">
                <!-- Dropdown + Tạo mới hàng hóa -->
                <div class="dropdown">
                    <button class="btn btn-primary dropdown-toggle kiot-btn-create d-inline-flex align-items-center" type="button" id="btnDropdownCreate" data-bs-toggle="dropdown" aria-expanded="false" title="Thêm mới">
                        <i class="bi bi-plus-lg me-1"></i><span class="d-none d-md-inline">Tạo mới</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="btnDropdownCreate">
                        <li>
                            <a class="dropdown-item py-2" href="javascript:void(0)" id="btnOpenCreateModal">
                                <i class="bi bi-box-seam me-2 text-primary"></i>Thêm hàng hóa
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Cụm nút Nhập file & Xuất file Excel chuẩn KiotViet -->
                <partial name="_HangHoaExcelActions" />

                <!-- Dropdown tùy chọn hiển thị cột chuẩn Nhập hàng & KiotViet -->
                <div class="dropdown">
                    <button class="btn btn-tool" type="button" id="btnColsDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Tùy chọn hiển thị cột">
                        <i class="bi bi-view-list"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow p-3" id="colMenu" style="min-width: 400px;">
                        <h6 class="dropdown-header px-0 pt-0 text-dark fw-bold mb-2">Hiển thị cột</h6>
                        <div class="row g-3">
                            <div class="col-6 d-flex flex-column gap-2 small">
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="img" checked> Hình ảnh</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="mahang" checked> Mã hàng</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="tenhang" checked> Tên hàng</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="nhomhang"> Nhóm hàng</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="dvt"> Đơn vị tính</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="giaban" checked> Giá bán</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="giavon" checked> Giá vốn</label>
                            </div>
                            <div class="col-6 d-flex flex-column gap-2 small">
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="tonkho" checked> Tồn kho</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="khachdat" checked> Khách đặt</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="vitri"> Vị trí</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="ngaytao" checked> Thời gian tạo</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="dukienhethang" checked> Dự kiến hết hàng</label>
                                <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="trangthai"> Trạng thái</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Các icon tiện ích KiotViet -->
                <button type="button" class="btn btn-tool d-none d-sm-inline-flex" title="Tải lại bảng" id="btnReloadTable">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button type="button" class="btn btn-tool btn-help" id="btnHelp" title="Hướng dẫn sử dụng (F1)">
                    <i class="bi bi-question-circle"></i>
                </button>
            </div>
        </div>

        <!-- Bảng danh sách hàng hóa (Partial View AJAX) -->
        <section id="content">
            <div id="productTableContainer">
                <partial name="_HangHoaTable" model="Model" />
            </div>
        </section>
    </main>
</div>

<!-- ========================================================================
     CÁC MODAL KIOTVIET (THÊM/SỬA, XUẤT EXCEL, NHẬP EXCEL, TẠO NHÓM)
     ======================================================================== -->
<partial name="_HangHoaModal" model="Model" />
<partial name="_HangHoaExportModal" />
<partial name="_HangHoaImportModal" />

<!-- Modal Tạo nhanh nhóm hàng -->
<div class="modal fade" id="quickGroupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold">Tạo mới nhóm hàng</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <label class="form-label small fw-semibold text-muted mb-1">Tên nhóm hàng <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="quickGroupInput" placeholder="Ví dụ: Bánh kẹo, Nước giải khát…" />
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Bỏ qua</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnSaveQuickGroup">Lưu nhóm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/kiot-filter.js" asp-append-version="true"></script>
    <script src="~/js/hang-hoa-index.js" asp-append-version="true"></script>
    <script src="~/js/hang-hoa-form.js" asp-append-version="true"></script>
    <script src="~/js/hang-hoa-excel.js" asp-append-version="true"></script>
}
