    // ========================================================================
    // QUẢN LÝ THUỘC TÍNH ĐỘNG & VỊ TRÍ, TRỌNG LƯỢNG (KIOTVIET STYLE - IMAGE MATCH)
    // ========================================================================
    let availableAttributes = ['Màu sắc', 'Kích cỡ', 'Dung tích', 'Hương vị', 'Chất liệu', 'Xuất xứ'];

    function escapeHtml(text) {
        if (!text) return '';
        return text.toString()
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function renderDropdownItems(selectedName) {
        if (!availableAttributes || availableAttributes.length === 0) {
            return '<li class="text-muted small px-3 py-1 fst-italic">Chưa có thuộc tính mẫu</li>';
        }
        return availableAttributes.map(attr => {
            const isSelected = (selectedName && attr.trim().toLowerCase() === selectedName.trim().toLowerCase());
            return `
                <li>
                    <a class="dropdown-item d-flex justify-content-between align-items-center py-2 px-3 kiot-attr-item ${isSelected ? 'active' : ''}" href="javascript:void(0)" data-name="${escapeHtml(attr)}">
                        <span>${escapeHtml(attr)}</span>
                        ${isSelected ? '<i class="bi bi-check2 text-primary fw-bold" style="font-size: 16px;"></i>' : ''}
                    </a>
                </li>
            `;
        }).join('');
    }

    function createAttrRowHtml(name = '', val = '') {
        if (name && !availableAttributes.some(a => a.toLowerCase() === name.toLowerCase())) {
            availableAttributes.push(name);
        }

        const displayName = name ? escapeHtml(name) : 'Chọn thuộc tính';
        const isPlaceholder = !name;

        return `
            <div class="kiot-attr-row">
                <!-- Dropdown Chọn thuộc tính -->
                <div class="dropdown kiot-attr-dropdown" style="width: 220px; flex-shrink: 0;">
                    <button class="btn btn-outline-secondary dropdown-toggle d-flex justify-content-between align-items-center w-100 bg-white border kiot-attr-btn ${isPlaceholder ? 'text-muted' : 'text-dark fw-semibold'}" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="height: 38px; border-color: #ced4da; border-radius: 6px; padding: 6px 12px;">
                        <span class="kiot-attr-selected-text text-truncate">${displayName}</span>
                        <i class="bi bi-chevron-down ms-1 text-muted kiot-attr-chevron" style="font-size: 11px;"></i>
                    </button>
                    <div class="dropdown-menu shadow-sm py-1 w-100 kiot-attr-menu" style="min-width: 220px; font-size: 13.5px; border-radius: 6px; border: 1px solid #dee2e6;">
                        <div class="dropdown-header text-muted small py-1 px-3" style="font-weight: 500;">Chọn thuộc tính</div>
                        <ul class="list-unstyled mb-0 kiot-attr-list-items" style="max-height: 200px; overflow-y: auto;">
                            ${renderDropdownItems(name)}
                        </ul>
                        <div class="dropdown-divider my-1"></div>
                        <a class="dropdown-item text-primary py-2 px-3 fw-semibold kiot-btn-create-attr d-flex align-items-center" href="javascript:void(0)">
                            <i class="bi bi-plus-lg me-2" style="font-size: 12px;"></i>Tạo thuộc tính mới
                        </a>
                        <div class="kiot-attr-inline-form p-2 border-top bg-light" style="display: none;">
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control kiot-attr-new-name-input" placeholder="Tên thuộc tính..." />
                                <button class="btn btn-primary kiot-btn-confirm-create-attr" type="button">Tạo</button>
                                <button class="btn btn-outline-secondary kiot-btn-cancel-create-attr" type="button">×</button>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" class="kiot-attr-name-val" value="${escapeHtml(name)}" />
                </div>

                <!-- Ô nhập giá trị thuộc tính -->
                <input type="text" class="form-control kiot-attr-val-input" placeholder="Nhập giá trị thuộc tính (VD: Đỏ, Xanh, XL)" value="${escapeHtml(val)}" style="height: 38px; border-radius: 6px; border-color: #ced4da;" />

                <!-- Nút xóa thùng rác -->
                <button type="button" class="btn btn-outline-secondary kiot-btn-remove-attr" title="Xóa thuộc tính">
                    <i class="bi bi-trash text-muted" style="font-size: 15px;"></i>
                </button>
            </div>
        `;
    }

    function renderAttributeRows(jsonStr, containerSelector, emptySelector) {
        const $container = $(containerSelector);
        const $empty = $(emptySelector);
        $container.empty();
        let list = [];
        try {
            if (jsonStr) {
                list = typeof jsonStr === 'string' ? JSON.parse(jsonStr) : jsonStr;
            }
        } catch (e) {
            list = [];
        }

        if (Array.isArray(list) && list.length > 0) {
            list.forEach(item => {
                const name = item.Ten || item.ten || '';
                const val = item.GiaTri || item.giaTri || '';
                if (name || val) {
                    $container.append(createAttrRowHtml(name, val));
                }
            });
            if ($container.children().length > 0) {
                $empty.hide();
                return;
            }
        }
        $empty.show();
    }

    function collectAttributes(containerSelector) {
        const result = [];
        $(containerSelector).find('.kiot-attr-row').each(function () {
            const name = $(this).find('.kiot-attr-name-val').val().trim();
            const val = $(this).find('.kiot-attr-val-input').val().trim();
            if (name || val) {
                result.push({ ten: name, giaTri: val });
            }
        });
        return result;
    }

    // Chọn thuộc tính từ dropdown
    $(document).on('click', '.kiot-attr-item', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const name = $(this).data('name');
        const dropdown = $(this).closest('.kiot-attr-dropdown');
        
        dropdown.find('.kiot-attr-name-val').val(name);
        dropdown.find('.kiot-attr-selected-text').text(name);
        dropdown.find('.kiot-attr-btn').removeClass('text-muted').addClass('text-dark fw-semibold');
        
        // Re-render items để cập nhật checkmark
        dropdown.find('.kiot-attr-list-items').html(renderDropdownItems(name));

        // Đóng dropdown
        const btn = dropdown.find('.kiot-attr-btn')[0];
        const bsDropdown = bootstrap.Dropdown.getInstance(btn) || new bootstrap.Dropdown(btn);
        bsDropdown.hide();

        // Focus vào ô giá trị
        $(this).closest('.kiot-attr-row').find('.kiot-attr-val-input').focus();
    });

    // Bấm "+ Tạo thuộc tính mới"
    $(document).on('click', '.kiot-btn-create-attr', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const menu = $(this).closest('.kiot-attr-menu');
        $(this).hide();
        const form = menu.find('.kiot-attr-inline-form');
        form.show();
        form.find('.kiot-attr-new-name-input').focus();
    });

    // Hủy tạo mới
    $(document).on('click', '.kiot-btn-cancel-create-attr', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const menu = $(this).closest('.kiot-attr-menu');
        menu.find('.kiot-attr-inline-form').hide();
        menu.find('.kiot-btn-create-attr').show();
    });

    // Xác nhận tạo mới
    $(document).on('click', '.kiot-btn-confirm-create-attr', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const form = $(this).closest('.kiot-attr-inline-form');
        const input = form.find('.kiot-attr-new-name-input');
        const newName = input.val().trim();
        if (!newName) {
            input.focus();
            return;
        }

        if (!availableAttributes.some(a => a.toLowerCase() === newName.toLowerCase())) {
            availableAttributes.push(newName);
        }

        const dropdown = $(this).closest('.kiot-attr-dropdown');
        dropdown.find('.kiot-attr-name-val').val(newName);
        dropdown.find('.kiot-attr-selected-text').text(newName);
        dropdown.find('.kiot-attr-btn').removeClass('text-muted').addClass('text-dark fw-semibold');

        // Cập nhật lại dropdown items
        dropdown.find('.kiot-attr-list-items').html(renderDropdownItems(newName));
        form.hide();
        dropdown.find('.kiot-btn-create-attr').show();
        input.val('');

        // Đóng dropdown
        const btn = dropdown.find('.kiot-attr-btn')[0];
        const bsDropdown = bootstrap.Dropdown.getInstance(btn) || new bootstrap.Dropdown(btn);
        bsDropdown.hide();

        // Focus vào ô giá trị
        dropdown.closest('.kiot-attr-row').find('.kiot-attr-val-input').focus();
    });

    $(document).on('keydown', '.kiot-attr-new-name-input', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            $(this).closest('.kiot-attr-inline-form').find('.kiot-btn-confirm-create-attr').click();
        }
    });

    // Thêm dòng thuộc tính trong modal chính
    $('#btnAddAttributeRow, #btnAddAttributeRowLink').on('click', function (e) {
        e.preventDefault();
        $('#noAttributeAlert').hide();
        const newRow = $(createAttrRowHtml('', ''));
        $('#attributeRowsContainer').append(newRow);
        // Tự động mở dropdown chọn thuộc tính cho dòng mới (chuẩn như ảnh)
        const btn = newRow.find('.kiot-attr-btn')[0];
        if (btn) {
            const bsDropdown = new bootstrap.Dropdown(btn);
            bsDropdown.show();
        }
    });

    // Thêm dòng thuộc tính trong modal cập nhật nhanh
    $('#btnQuickModalAddRow').on('click', function (e) {
        e.preventDefault();
        $('#quickAttrEmptyAlert').hide();
        const newRow = $(createAttrRowHtml('', ''));
        $('#quickAttrRowsContainer').append(newRow);
        const btn = newRow.find('.kiot-attr-btn')[0];
        if (btn) {
            const bsDropdown = new bootstrap.Dropdown(btn);
            bsDropdown.show();
        }
    });

    // Xóa dòng thuộc tính
    $(document).on('click', '.kiot-btn-remove-attr', function () {
        const row = $(this).closest('.kiot-attr-row');
        const container = row.parent();
        row.remove();
        if (container.children('.kiot-attr-row').length === 0) {
            if (container.attr('id') === 'attributeRowsContainer') {
                $('#noAttributeAlert').show();
            } else if (container.attr('id') === 'quickAttrRowsContainer') {
                $('#quickAttrEmptyAlert').show();
            }
        }
    });

    // Nút Tạo mới Vị trí
    $('#btnQuickAddLocation').on('click', function () {
        const newLoc = prompt('Nhập tên vị trí kho mới (Ví dụ: Kệ C3 - Tầng 2):');
        if (newLoc && newLoc.trim()) {
            const val = newLoc.trim();
            let exists = false;
            $('#listViTriSuggestions option').each(function () {
                if ($(this).val().toLowerCase() === val.toLowerCase()) exists = true;
            });
            if (!exists) {
                $('#listViTriSuggestions').append(`<option value="${escapeHtml(val)}"></option>`);
            }
            $('#formViTri').val(val);
        }
    });

    // Mở modal Cập nhật nhanh thuộc tính từ bảng danh sách
    $(document).on('click', '.btn-quick-attr', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const id = $(this).data('id');
        const name = $(this).data('name');
        const attrs = $(this).data('attrs');

        $('#quickAttrMaHang').val(id);
        $('#quickAttrProductName').text(name);
        renderAttributeRows(attrs, '#quickAttrRowsContainer', '#quickAttrEmptyAlert');
        quickAttrModal.show();
    });

    // Lưu nhanh thuộc tính từ modal quickAttrModal
    $('#btnSaveQuickAttr').on('click', function () {
        const maHang = parseInt($('#quickAttrMaHang').val()) || 0;
        if (maHang <= 0) return;

        const attrs = collectAttributes('#quickAttrRowsContainer');
        const btn = $(this);
        btn.prop('disabled', true).text('Đang lưu...');

        $.ajax({
            url: '/HangHoa/UpdateThuocTinh',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                maHang: maHang,
                thuocTinhJson: JSON.stringify(attrs)
            }),
            success: function () {
                btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i>Lưu thuộc tính');
                quickAttrModal.hide();
                loadTable();
            },
            error: function (xhr) {
                btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i>Lưu thuộc tính');
                alert('Lỗi: ' + (xhr.responseJSON?.message || 'Không thể lưu thuộc tính.'));
            }
        });
    });

    // Mở modal Sửa hàng hóa
    $(document).on('click', '.btn-edit-product', function () {
        const id = $(this).data('id');
        resetModalForm();
        $('#modalTitle').text('Cập nhật hàng hóa');
        $('#formMaHang').val(id);
        $('#boxInitialStock').hide();

        $.ajax({
            url: '/HangHoa/GetItem/' + id,
            type: 'GET',
            success: function (res) {
                $('#formMaHangNoiBo').val(res.maHangNoiBo);
                $('#formQuyCach').val(res.quyCach);
                $('#formTenHang').val(res.tenHang);
                $('#formMaNhom').val(res.maNhom);
                $('#formMaDvt').val(res.maDvt);
                $('#formGiaVon').val(res.giaVon);
                $('#formGiaBan').val(res.giaBanThamKhao);
                $('#formTonToiThieu').val(res.tonToiThieu);
                $('#formTonCaoNhat').val(res.tonCaoNhat ?? 999999999);
                $('#formViTri').val(res.viTri || '');
                $('#formTrongLuong').val(res.trongLuong || 0);
                $('#formDonViTrongLuong').val(res.donViTrongLuong || 'g');
                $('#formMoTa').val(res.moTa || res.quyCach || '');

                renderAttributeRows(res.thuocTinhJson, '#attributeRowsContainer', '#noAttributeAlert');

                if (res.hinhAnhBase64) {
                    $('#imagePreview').attr('src', res.hinhAnhBase64).show();
                    $('#imagePlaceholder').hide();
                    $('#btnRemoveImage').show();
                } else {
                    $('#imagePreview').hide();
                    $('#imagePlaceholder').show();
                    $('#btnRemoveImage').hide();
                }

                if (res.trangThai === 'DANG_BAN') {
                    $('#statusActive').prop('checked', true);
                    $('#chkBanTrucTiep').prop('checked', true);
                } else {
                    $('#statusInactive').prop('checked', true);
                    $('#chkBanTrucTiep').prop('checked', false);
                }

                hangHoaModal.show();
            },
            error: function (xhr) {
                alert('Không thể tải thông tin hàng hóa: ' + (xhr.responseJSON?.message || 'Lỗi kết nối'));
            }
        });
    });

    // Lưu hàng hóa (Nút Lưu)
    $('#btnSaveProduct').on('click', function () {
        saveProduct(false);
    });

    $('#btnSaveAndAddMore').on('click', function () {
        saveProduct(true);
    });

    function saveProduct(addMore) {
        const maHang = parseInt($('#formMaHang').val()) || 0;
        const tenHang = $('#formTenHang').val().trim();
        const maNhom = parseInt($('#formMaNhom').val()) || 0;
        const maDvt = parseInt($('#formMaDvt').val()) || 0;
        const giaBan = parseFloat($('#formGiaBan').val()) || 0;

        if (!tenHang) {
            alert('Vui lòng nhập tên hàng hóa.');
            $('#formTenHang').focus();
            return;
        }

        if (maNhom <= 0) {
            alert('Vui lòng chọn nhóm hàng.');
            $('#formMaNhom').focus();
            return;
        }

        if (maDvt <= 0) {
            alert('Vui lòng chọn đơn vị tính.');
            $('#formMaDvt').focus();
            return;
        }

        const attrs = collectAttributes('#attributeRowsContainer');
        const payload = {
            maHang: maHang,
            maHangNoiBo: $('#formMaHangNoiBo').val().trim(),
            quyCach: $('#formQuyCach').val().trim(),
            tenHang: tenHang,
            maNhom: maNhom,
            maDvt: maDvt,
            giaVon: parseFloat($('#formGiaVon').val()) || 0,
            giaBanThamKhao: giaBan,
            tonKhoBanDau: parseFloat($('#formTonKhoBanDau').val()) || 0,
            tonToiThieu: parseFloat($('#formTonToiThieu').val()) || 0,
            tonCaoNhat: parseFloat($('#formTonCaoNhat').val()) || 999999999,
            viTri: $('#formViTri').val().trim(),
            trongLuong: parseFloat($('#formTrongLuong').val()) || 0,
            donViTrongLuong: $('#formDonViTrongLuong').val(),
            thuocTinhJson: JSON.stringify(attrs),
            trangThai: $('#chkBanTrucTiep').length ? ($('#chkBanTrucTiep').is(':checked') ? 'DANG_BAN' : 'NGUNG_BAN') : $('input[name="TrangThai"]:checked').val(),
            hinhAnhBase64: $('#formHinhAnhBase64').val(),
            xoaHinhAnh: $('#formXoaHinhAnh').val() === 'true'
        };

        const url = maHang > 0 ? ('/HangHoa/Edit/' + maHang) : '/HangHoa/Create';
        const saveBtn = $('#btnSaveProduct');
        saveBtn.prop('disabled', true).text('Đang lưu...');

        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                saveBtn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i>Lưu');
                if (addMore) {
                    resetModalForm();
                    $('#modalTitle').text('Thêm mới hàng hóa');
                    $('#formMaHang').val(0);
                    $('#boxInitialStock').show();
                    $('#formTenHang').focus();
                    loadTable();
                } else {
                    hangHoaModal.hide();
                    loadTable();
                }
            },
            error: function (xhr) {
                saveBtn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i>Lưu');
                alert('Lỗi: ' + (xhr.responseJSON?.message || 'Không thể lưu hàng hóa.'));
            }
        });
    }

    // Modal Xóa hàng hóa
    $(document).on('click', '.btn-delete-product', function () {
        deleteId = $(this).data('id');
        $('#deleteTargetName').text($(this).data('name'));
        const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
        modal.show();
    });

    $('#btnExecuteDelete').on('click', function () {
        if (deleteId > 0) {
            $.ajax({
                url: '/HangHoa/Delete/' + deleteId,
                type: 'POST',
                success: function (res) {
                    $('#deleteConfirmModal').modal('hide');
                    loadTable();
                },
                error: function (xhr) {
                    alert('Lỗi: ' + (xhr.responseJSON?.message || 'Không thể xóa hàng hóa.'));
                }
            });
        }
    });

    function resetModalForm() {
        $('#hangHoaForm')[0].reset();
        $('#fileUploadInput').val('');
        $('#formHinhAnhBase64').val('');
        $('#formXoaHinhAnh').val('false');
        $('#imagePreview').attr('src', '').hide();
        $('#imagePlaceholder').show();
        $('#btnRemoveImage').hide();

        $('#formMaHang').val(0);
        $('#formViTri').val('');
        $('#formTrongLuong').val(0);
        $('#formDonViTrongLuong').val('g');
        $('#formTonCaoNhat').val(999999999);
        $('#formMoTa').val('');
        $('#attributeRowsContainer').empty();
        $('#noAttributeAlert').hide();

        $('#chkBanTrucTiep').prop('checked', true);
        $('#statusActive').prop('checked', true);
        $('#tab-info-btn').tab('show');
    }

    // Đồng bộ checkbox Bán trực tiếp và radio Trạng thái
    $('#chkBanTrucTiep').on('change', function () {
        if ($(this).is(':checked')) {
            $('#statusActive').prop('checked', true);
        } else {
            $('#statusInactive').prop('checked', true);
        }
    });

    $('input[name="TrangThai"]').on('change', function () {
        $('#chkBanTrucTiep').prop('checked', $('#statusActive').is(':checked'));
    });

    // 7. Lọc dữ liệu qua AJAX
    let searchTimeout = null;
    $('#keywordSearch').on('input', function () {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function () {
            currentPage = 1;
            loadTable();
        }, 300);
    }).on('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            clearTimeout(searchTimeout);
            currentPage = 1;
            loadTable();
        }
    });

    $('.filter-change').on('change', function () {
        currentPage = 1;
        loadTable();
    });

    $('#btnReloadTable').on('click', function () {
        loadTable();
    });

    // Phân trang AJAX
    $(document).on('click', '.page-ajax', function (e) {
        e.preventDefault();
        const p = $(this).data('page');
        if (p && p > 0) {
            currentPage = p;
            loadTable();
        }
    });

    // Checkbox chọn tất cả
    $(document).on('change', '#selectAllRows', function () {
        $('.row-select').prop('checked', $(this).is(':checked'));
    });

    // Toggle mở/đóng chi tiết hàng hóa (KiotViet Inline Accordion)
    $(document).on('click', '.product-row', function (e) {
        // Không mở khi click vào checkbox, star, hoặc nút thao tác
        if ($(e.target).closest('input[type="checkbox"], .star-btn, button, a.btn-delete-product').length) {
            return;
        }

        const id = $(this).data('id');
        const $detailRow = $('#detail-' + id);
        const $wrap = $detailRow.find('.product-detail-panel-wrap');
        const isCurrentlyOpen = $detailRow.is(':visible');

        // Đóng các dòng chi tiết khác đang mở (dạng accordion như KiotViet)
        $('.product-detail-row').not($detailRow).each(function () {
            const $other = $(this);
            $other.find('.product-detail-panel-wrap').slideUp(150, function () {
                $other.hide();
            });
        });
        $('.product-row').not(this).removeClass('selected');

        if (isCurrentlyOpen) {
            $wrap.slideUp(150, function () {
                $detailRow.hide();
            });
            $(this).removeClass('selected');
        } else {
            $(this).addClass('selected');
            $detailRow.show();
            $wrap.hide().slideDown(150);
        }
    });

    // Chuyển Tab bên trong chi tiết hàng hóa
    $(document).on('click', '.product-detail-tab-btn', function (e) {
        e.stopPropagation();
        const tabName = $(this).data('tab');
        const $panel = $(this).closest('.product-detail-panel');

        $panel.find('.product-detail-tab-btn').removeClass('active');
        $(this).addClass('active');

        $panel.find('.tab-pane-content').hide();
        $panel.find('.tab-' + tabName).fadeIn(120);
    });

    // Sao chép hàng hóa
    $(document).on('click', '.btn-copy-product', function (e) {
        e.stopPropagation();
        const id = $(this).data('id');
        $.ajax({
            url: '/HangHoa/GetItem/' + id,
            type: 'GET',
            success: function (res) {
                resetModalForm();
                $('#modalTitle').text('Thêm mới hàng hóa (Sao chép)');
                $('#formMaHang').val(0); // 0 để tạo mới
                $('#formMaHangNoiBo').val(res.maHangNoiBo ? res.maHangNoiBo + '_CP' : '');
                $('#formTenHang').val((res.tenHang || '') + ' (Copy)');
                $('#formMaNhom').val(res.maNhom);
                $('#formMaDvt').val(res.maDvt);
                $('#formQuyCach').val(res.quyCach || '');
                $('#formGiaBan').val(res.giaBanThamKhao || 0);
                $('#formGiaVon').val(res.giaVon || 0);
                $('#formTonToiThieu').val(res.tonToiThieu || 0);
                $('#formTonCaoNhat').val(res.tonCaoNhat ?? 999999999);
                $('#formViTri').val(res.viTri || '');
                $('#formTrongLuong').val(res.trongLuong || 0);
                $('#formDonViTrongLuong').val(res.donViTrongLuong || 'g');
                renderAttributeRows(res.thuocTinhJson, '#attributeRowsContainer', '#noAttributeAlert');
                $('#formTonKhoBanDau').val(0);
                $('#boxInitialStock').show();

                if (res.hinhAnhBase64) {
                    $('#imagePreview').attr('src', res.hinhAnhBase64).show();
                    $('#imagePlaceholder').hide();
                    $('#btnRemoveImage').show();
                    $('#formHinhAnhBase64').val(res.hinhAnhBase64);
                }

                if (res.trangThai === 'DANG_BAN') {
                    $('#statusActive').prop('checked', true);
                    $('#chkBanTrucTiep').prop('checked', true);
                } else {
                    $('#statusInactive').prop('checked', true);
                    $('#chkBanTrucTiep').prop('checked', false);
                }

                hangHoaModal.show();
            },
            error: function () {
                alert('Không thể tải thông tin hàng hóa để sao chép.');
            }
        });
    });

    // Hàm toàn cục xử lý bấm đánh dấu sao ở từng dòng hàng hóa (AJAX)
    window.toggleFavoriteProduct = function (e, id, el) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        const $cell = $(el);
        const $btn = $cell.hasClass('star-btn') ? $cell : $cell.find('.star-btn');
        if (!$btn.length || !id) return;

        $.ajax({
            url: '/HangHoa/ToggleFavorite',
            type: 'POST',
            data: { id: id },
            success: function (res) {
                if (res && res.success) {
                    if (res.isFavorite) {
                        $btn.addClass('starred')
                            .attr('title', 'Bỏ đánh dấu sao')
                            .html('<i class="bi bi-star-fill"></i>');
                    } else {
                        $btn.removeClass('starred')
                            .attr('title', 'Đánh dấu sao')
                            .html('<i class="bi bi-star"></i>');

                        // Nếu đang lọc chỉ xem hàng có sao, bỏ sao sẽ ẩn dòng này đi
                        if (isStarredFilterActive) {
                            const $tr = $btn.closest('tr');
                            const $detail = $('#detail-' + id);
                            $detail.remove();
                            $tr.fadeOut(250, function () {
                                $(this).remove();
                                if ($('#productTable tbody tr.product-row').length === 0) {
                                    loadTable();
                                }
                            });
                        }
                    }
                }
            },
            error: function (xhr) {
                console.error('Lỗi khi cập nhật đánh dấu sao:', xhr);
                alert('Có lỗi khi cập nhật đánh dấu sao.');
            }
        });
    };

    // Hàm toàn cục xử lý bấm ngôi sao ở Header để lọc nhanh hàng được đánh dấu sao
    window.toggleStarHeaderFilter = function (e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        isStarredFilterActive = !isStarredFilterActive;
        currentPage = 1;
        loadTable();
    };

    // Bắt thêm sự kiện click trực tiếp làm dự phòng (delegated listener)
    $(document).on('click', '.star-btn:not(#starHeaderFilter)', function (e) {
        const id = $(this).data('id');
        window.toggleFavoriteProduct(e, id, this);
    });

    $(document).on('click', '#starHeaderFilter', function (e) {
        window.toggleStarHeaderFilter(e);
    });

    function loadTable() {
        const q = $('#keywordSearch').val()?.trim() || '';
        const nhom = (filterState.nhom || []).map(x => x.val).join(',');
        const tonKho = $('#filterTonKho').val() || 'ALL';
        const nhaCungCap = (filterState.ncc || []).map(x => x.val).join(';');
        const viTri = (filterState.vitri || []).map(x => x.val).join(';');
        const loaiHang = (filterState.loaihang || []).map(x => x.val).join(';');

        let duKien = activeDuKienVal || 'ALL';
        if ($('#dkCustom').is(':checked') && duKien === 'ALL') {
            duKien = 'CUSTOM';
        }

        let tgTao = activeTgTaoVal || 'ALL';
        let tgTaoFrom = '';
        let tgTaoTo = '';
        if ($('#tgtCustom').is(':checked')) {
            tgTao = 'CUSTOM';
            tgTaoFrom = activeTgTaoFrom;
            tgTaoTo = activeTgTaoTo;
        }

        // Cập nhật chấm xanh indicator (inline-block nằm cùng hàng tiêu đề)
        $('#dotNhomHang').css('display', filterState.nhom.length > 0 ? 'inline-block' : 'none');
        $('#dotTonKho').css('display', tonKho !== 'ALL' ? 'inline-block' : 'none');
        $('#dotDuKien').css('display', duKien !== 'ALL' ? 'inline-block' : 'none');
        $('#dotTgTao').css('display', tgTao !== 'ALL' ? 'inline-block' : 'none');
        $('#dotNcc').css('display', filterState.ncc.length > 0 ? 'inline-block' : 'none');
        $('#dotViTri').css('display', filterState.vitri.length > 0 ? 'inline-block' : 'none');
        $('#dotLoaiHang').css('display', filterState.loaihang.length > 0 ? 'inline-block' : 'none');

        const hasAnyActiveFilter = filterState.nhom.length > 0 || tonKho !== 'ALL' || duKien !== 'ALL' || tgTao !== 'ALL' || filterState.ncc.length > 0 || filterState.vitri.length > 0 || filterState.loaihang.length > 0;
        $('#btnMobileFilter').toggleClass('has-filter', hasAnyActiveFilter);

        $.ajax({
            url: '/HangHoa/Filter',
            type: 'GET',
            data: {
                q: q,
                nhom: nhom,
                tonKhoFilter: tonKho,
                nhaCungCap: nhaCungCap,
                viTri: viTri,
                loaiHang: loaiHang,
                duKienFilter: duKien,
                tgTaoFilter: tgTao,
                tgTaoFrom: tgTaoFrom,
                tgTaoTo: tgTaoTo,
                daDanhDau: isStarredFilterActive,
                page: currentPage
            },
            beforeSend: function () {
                $('#productTableContainer').css('opacity', '0.6');
            },
            success: function (html) {
                $('#productTableContainer').html(html).css('opacity', '1');
            },
            error: function () {
                $('#productTableContainer').css('opacity', '1');
                alert('Có lỗi khi tải danh sách hàng hóa.');
            }
        });
    }
});
</script>
}
