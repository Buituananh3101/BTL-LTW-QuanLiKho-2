@model BTL_LTW_QuanLiKho_2.ViewModels.HangHoaIndexVM
@{
    ViewData["Title"] = "Hàng hóa";
}

<link rel="stylesheet" href="~/css/hang-hoa-form.css" asp-append-version="true" />

<div class="kiot-container position-relative" id="kiotContainer">
    <!-- CỘT BÊN TRÁI: TIÊU ĐỀ "HÀNG HÓA" + BỘ LỌC -->
    <aside class="kiot-sidebar-col" id="sidebarFilterCol">
        <!-- Header cho sidebar khi mở ở chế độ mobile/zoom in -->
        <div class="kiot-sidebar-mobile-header d-lg-none d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
            <div class="fw-bold fs-6 text-dark"><i class="bi bi-funnel me-1 text-primary"></i> Bộ lọc hàng hóa</div>
            <button type="button" class="btn-close" id="btnCloseSidebarMobile" aria-label="Đóng"></button>
        </div>

        <div class="kiot-sidebar-title d-none d-lg-flex">
            Hàng hóa
        </div>

        <div class="kiot-filter-box">
            <!-- 1. Nhóm hàng -->
            <div class="f-block position-relative">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h6 class="mb-0">Nhóm hàng <span class="filter-dot" id="dotNhomHang"></span></h6>
                    <a href="javascript:void(0)" class="small text-primary text-decoration-none fw-semibold" id="btnOpenQuickGroupModal">
                        Tạo mới
                    </a>
                </div>
                <div class="position-relative">
                    <div class="kiot-multiselect-box" id="boxNhomHang" data-filter="nhom">
                        <span class="kiot-ms-placeholder">Chọn nhóm hàng</span>
                    </div>
                    <div class="kiot-ms-dropdown shadow" id="dropdownNhomHang">
                        <div class="kiot-ms-search">
                            <input type="text" placeholder="Tìm kiếm nhóm hàng..." autocomplete="off" />
                        </div>
                        @foreach (var g in Model.NhomHangs)
                        {
                            <div class="kiot-ms-item" data-val="@g.MaNhom" data-name="@g.TenNhom">
                                <input type="checkbox" class="form-check-input" />
                                <span>@g.TenNhom</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 2. Tồn kho -->
            <div class="f-block position-relative">
                <h6>Tồn kho <span class="filter-dot" id="dotTonKho"></span></h6>
                <div class="text-muted small mb-1">Tiêu chí tồn</div>
                <div class="position-relative">
                    <div class="kiot-single-select-box" id="boxTonKho">
                        <span id="textTonKho">
                            @(Model.TonKhoFilter == "CON_HANG" ? "Còn hàng trong kho" :
                              Model.TonKhoFilter == "HET_HANG" ? "Hết hàng trong kho" :
                              Model.TonKhoFilter == "DUOI_DINH_MUC" ? "Dưới định mức tồn ⚠️" : "Tất cả")
                        </span>
                        <i class="bi bi-chevron-down kiot-select-chevron"></i>
                    </div>
                    <div class="kiot-ss-dropdown shadow" id="dropdownTonKho">
                        <div class="kiot-ss-item @(Model.TonKhoFilter == "ALL" || string.IsNullOrEmpty(Model.TonKhoFilter) ? "selected" : "")" data-val="ALL">
                            <span>Tất cả</span>
                            <i class="bi bi-check2 check-icon"></i>
                        </div>
                        <div class="kiot-ss-item @(Model.TonKhoFilter == "CON_HANG" ? "selected" : "")" data-val="CON_HANG">
                            <span>Còn hàng trong kho</span>
                            <i class="bi bi-check2 check-icon"></i>
                        </div>
                        <div class="kiot-ss-item @(Model.TonKhoFilter == "HET_HANG" ? "selected" : "")" data-val="HET_HANG">
                            <span>Hết hàng trong kho</span>
                            <i class="bi bi-check2 check-icon"></i>
                        </div>
                        <div class="kiot-ss-item @(Model.TonKhoFilter == "DUOI_DINH_MUC" ? "selected" : "")" data-val="DUOI_DINH_MUC">
                            <span>Dưới định mức tồn ⚠️</span>
                            <i class="bi bi-check2 check-icon"></i>
                        </div>
                    </div>
                </div>
                <select class="form-select filter-change d-none" id="filterTonKho">
                    <option value="ALL" selected="@(Model.TonKhoFilter == "ALL")">Tất cả</option>
                    <option value="CON_HANG" selected="@(Model.TonKhoFilter == "CON_HANG")">Còn hàng trong kho</option>
                    <option value="HET_HANG" selected="@(Model.TonKhoFilter == "HET_HANG")">Hết hàng trong kho</option>
                    <option value="DUOI_DINH_MUC" selected="@(Model.TonKhoFilter == "DUOI_DINH_MUC")">Dưới định mức tồn ⚠️</option>
                </select>
            </div>

            <!-- 3. Dự kiến hết hàng -->
            <div class="f-block position-relative">
                <h6>Dự kiến hết hàng <span class="filter-dot" id="dotDuKien"></span></h6>
                <div class="form-check mb-1">
                    <input class="form-check-input" type="radio" name="duKienFilter" id="dkAll" checked />
                    <label class="form-check-label d-flex justify-content-between align-items-center" for="dkAll" id="labelDkAll" style="cursor: pointer;">
                        <span id="textDkRange">Toàn thời gian</span>
                        <i class="bi bi-chevron-right text-muted small" id="btnOpenDkQuick"></i>
                    </label>
                </div>

                <!-- Popup chọn nhanh thời gian Dự kiến hết hàng (3 cột như Screenshot 3) -->
                <div class="quick-date-popup" id="popupDkQuick">
                    <div class="quick-date-grid">
                        <div class="quick-date-col">
                            <div class="quick-date-col-title">Theo ngày</div>
                            <div class="quick-date-btn" data-target="dk" data-val="NGAY_MAI">Ngày mai</div>
                            <div class="quick-date-btn" data-target="dk" data-val="NGAY_KIA">Ngày kia</div>
                            <div class="quick-date-btn" data-target="dk" data-val="3_NGAY">3 ngày tới</div>
                            <div class="quick-date-btn" data-target="dk" data-val="5_NGAY">5 ngày tới</div>
                            <div class="quick-date-btn" data-target="dk" data-val="7_NGAY">7 ngày tới</div>
                        </div>
                        <div class="quick-date-col">
                            <div class="quick-date-col-title">Theo tuần</div>
                            <div class="quick-date-btn" data-target="dk" data-val="TUAN_NAY">Tuần này</div>
                            <div class="quick-date-btn" data-target="dk" data-val="TUAN_TOI">Tuần tới</div>
                            <div class="quick-date-btn" data-target="dk" data-val="2_TUAN">2 tuần tới</div>
                        </div>
                        <div class="quick-date-col">
                            <div class="quick-date-col-title">Theo tháng</div>
                            <div class="quick-date-btn" data-target="dk" data-val="THANG_NAY">Tháng này</div>
                            <div class="quick-date-btn" data-target="dk" data-val="THANG_TOI">Tháng tới</div>
                            <div class="quick-date-btn" data-target="dk" data-val="30_NGAY">30 ngày tới</div>
                            <div class="quick-date-btn" data-target="dk" data-val="2_THANG">2 tháng tới</div>
                            <div class="quick-date-btn" data-target="dk" data-val="3_THANG">3 tháng tới</div>
                        </div>
                    </div>
                    <button type="button" class="quick-date-pill-all" data-target="dk" data-val="ALL">Toàn thời gian</button>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="duKienFilter" id="dkCustom" />
                    <label class="form-check-label d-flex justify-content-between align-items-center" for="dkCustom" style="cursor: pointer;">
                        <span id="textDkCustom">Tùy chỉnh</span>
                        <i class="bi bi-calendar3 text-muted small" id="btnOpenDkCalendar"></i>
                    </label>
                </div>

                <!-- Popup Lịch 2 tháng cạnh nhau cho Tùy chỉnh (Screenshot 2) -->
                <div class="dual-calendar-popup" id="popupDkCalendar">
                    <div class="dual-calendar-header">
                        Từ ngày: <span class="fw-bold text-primary" id="dkCalFromText">12/10/2026</span> - Đến ngày: <span class="fw-bold text-primary" id="dkCalToText">12/10/2026</span>
                    </div>
                    <div class="dual-calendar-body">
                        <!-- Tháng 1 -->
                        <div class="dual-cal-month">
                            <div class="dual-cal-nav">
                                <button type="button" class="btn-cal-prev" data-target="dk">‹</button>
                                <span id="dkMonthTitle1">Tháng 10 2026</span>
                                <button type="button" class="btn-cal-next" data-target="dk">›</button>
                            </div>
                            <table class="dual-cal-table">
                                <thead><tr><th>T2</th><th>T3</th><th>T4</th><th>T5</th><th>T6</th><th>T7</th><th>CN</th></tr></thead>
                                <tbody id="dkCalBody1"></tbody>
                            </table>
                        </div>
                        <!-- Tháng 2 -->
                        <div class="dual-cal-month">
                            <div class="dual-cal-nav">
                                <button type="button" class="btn-cal-prev" data-target="dk">‹</button>
                                <span id="dkMonthTitle2">Tháng 11 2026</span>
                                <button type="button" class="btn-cal-next" data-target="dk">›</button>
                            </div>
                            <table class="dual-cal-table">
                                <thead><tr><th>T2</th><th>T3</th><th>T4</th><th>T5</th><th>T6</th><th>T7</th><th>CN</th></tr></thead>
                                <tbody id="dkCalBody2"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="dual-calendar-footer">
                        <a href="javascript:void(0)" class="text-primary small text-decoration-none fw-bold btn-cal-today" data-target="dk">Hôm nay</a>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-3 btn-close-popup">Bỏ qua</button>
                            <button type="button" class="btn btn-primary btn-sm py-1 px-3 btn-apply-calendar" data-target="dk">Áp dụng</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. Thời gian tạo -->
            <div class="f-block position-relative">
                <h6>Thời gian tạo <span class="filter-dot" id="dotTgTao"></span></h6>
                <div class="form-check mb-1">
                    <input class="form-check-input" type="radio" name="tgTaoFilter" id="tgtAll" checked />
                    <label class="form-check-label d-flex justify-content-between align-items-center" for="tgtAll" id="labelTgtAll" style="cursor: pointer;">
                        <span id="textTgtRange">Toàn thời gian</span>
                        <i class="bi bi-chevron-right text-muted small" id="btnOpenTgtQuick"></i>
                    </label>
                </div>

                <!-- Popup chọn nhanh thời gian tạo -->
                <div class="quick-date-popup" id="popupTgtQuick">
                    <div class="quick-date-grid">
                        <div class="quick-date-col">
                            <div class="quick-date-col-title">Theo ngày</div>
                            <div class="quick-date-btn" data-target="tgt" data-val="HOM_NAY">Hôm nay</div>
                            <div class="quick-date-btn" data-target="tgt" data-val="HOM_QUA">Hôm qua</div>
                        </div>
                        <div class="quick-date-col">
                            <div class="quick-date-col-title">Theo tuần</div>
                            <div class="quick-date-btn" data-target="tgt" data-val="TUAN_NAY">Tuần này</div>
                            <div class="quick-date-btn" data-target="tgt" data-val="TUAN_TRUOC">Tuần trước</div>
                            <div class="quick-date-btn" data-target="tgt" data-val="7_NGAY">7 ngày qua</div>
                        </div>
                        <div class="quick-date-col">
                            <div class="quick-date-col-title">Theo tháng</div>
                            <div class="quick-date-btn" data-target="tgt" data-val="THANG_NAY">Tháng này</div>
                            <div class="quick-date-btn" data-target="tgt" data-val="THANG_TRUOC">Tháng trước</div>
                            <div class="quick-date-btn" data-target="tgt" data-val="30_NGAY">30 ngày qua</div>
                        </div>
                    </div>
                    <button type="button" class="quick-date-pill-all" data-target="tgt" data-val="ALL">Toàn thời gian</button>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="tgTaoFilter" id="tgtCustom" />
                    <label class="form-check-label d-flex justify-content-between align-items-center" for="tgtCustom" style="cursor: pointer;">
                        <span id="textTgtCustom">Tùy chỉnh</span>
                        <i class="bi bi-calendar3 text-muted small" id="btnOpenTgtCalendar"></i>
                    </label>
                </div>

                <!-- Popup Lịch 2 tháng cho Thời gian tạo (Screenshot 2) -->
                <div class="dual-calendar-popup" id="popupTgtCalendar">
                    <div class="dual-calendar-header">
                        Từ ngày: <span class="fw-bold text-primary" id="tgtCalFromText">12/10/2026</span> - Đến ngày: <span class="fw-bold text-primary" id="tgtCalToText">12/10/2026</span>
                    </div>
                    <div class="dual-calendar-body">
                        <!-- Tháng 1 -->
                        <div class="dual-cal-month">
                            <div class="dual-cal-nav">
                                <button type="button" class="btn-cal-prev" data-target="tgt">‹</button>
                                <span id="tgtMonthTitle1">Tháng 10 2026</span>
                                <button type="button" class="btn-cal-next" data-target="tgt">›</button>
                            </div>
                            <table class="dual-cal-table">
                                <thead><tr><th>T2</th><th>T3</th><th>T4</th><th>T5</th><th>T6</th><th>T7</th><th>CN</th></tr></thead>
                                <tbody id="tgtCalBody1"></tbody>
                            </table>
                        </div>
                        <!-- Tháng 2 -->
                        <div class="dual-cal-month">
                            <div class="dual-cal-nav">
                                <button type="button" class="btn-cal-prev" data-target="tgt">‹</button>
                                <span id="tgtMonthTitle2">Tháng 11 2026</span>
                                <button type="button" class="btn-cal-next" data-target="tgt">›</button>
                            </div>
                            <table class="dual-cal-table">
                                <thead><tr><th>T2</th><th>T3</th><th>T4</th><th>T5</th><th>T6</th><th>T7</th><th>CN</th></tr></thead>
                                <tbody id="tgtCalBody2"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="dual-calendar-footer">
                        <a href="javascript:void(0)" class="text-primary small text-decoration-none fw-bold btn-cal-today" data-target="tgt">Hôm nay</a>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-3 btn-close-popup">Bỏ qua</button>
                            <button type="button" class="btn btn-primary btn-sm py-1 px-3 btn-apply-calendar" data-target="tgt">Áp dụng</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. Nhà cung cấp -->
            <div class="f-block position-relative">
                <h6>Nhà cung cấp <span class="filter-dot" id="dotNcc"></span></h6>
                <div class="position-relative">
                    <div class="kiot-multiselect-box" id="boxNcc" data-filter="ncc">
                        <span class="kiot-ms-placeholder">Chọn nhà cung cấp</span>
                    </div>
                    <div class="kiot-ms-dropdown shadow" id="dropdownNcc">
                        <div class="kiot-ms-search">
                            <input type="text" placeholder="Tìm nhà cung cấp..." autocomplete="off" />
                        </div>
                        @foreach (var s in Model.DonViCapHangs)
                        {
                            <div class="kiot-ms-item" data-val="@s.TenDonVi" data-name="@s.TenDonVi">
                                <input type="checkbox" class="form-check-input" />
                                <span>@s.TenDonVi</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 6. Vị trí -->
            <div class="f-block position-relative">
                <h6>Vị trí <span class="filter-dot" id="dotViTri"></span></h6>
                <div class="position-relative">
                    <div class="kiot-multiselect-box" id="boxViTri" data-filter="vitri">
                        <span class="kiot-ms-placeholder">Chọn vị trí</span>
                    </div>
                    <div class="kiot-ms-dropdown shadow" id="dropdownViTri">
                        <div class="kiot-ms-search">
                            <input type="text" placeholder="Tìm vị trí..." autocomplete="off" />
                        </div>
                        @foreach (var vt in Model.ViTris)
                        {
                            <div class="kiot-ms-item" data-val="@vt" data-name="@vt">
                                <input type="checkbox" class="form-check-input" />
                                <span>@vt</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 7. Loại hàng -->
            <div class="f-block position-relative">
                <h6>Loại hàng <span class="filter-dot" id="dotLoaiHang"></span></h6>
                <div class="position-relative">
                    <div class="kiot-multiselect-box" id="boxLoaiHang" data-filter="loaihang">
                        <span class="kiot-ms-placeholder">Chọn loại hàng</span>
                    </div>
                    <div class="kiot-ms-dropdown shadow" id="dropdownLoaiHang">
                        <div class="kiot-ms-item" data-val="Hàng hóa" data-name="Hàng hóa">
                            <input type="checkbox" class="form-check-input" />
                            <span>Hàng hóa</span>
                        </div>
                        <div class="kiot-ms-item" data-val="Dịch vụ" data-name="Dịch vụ">
                            <input type="checkbox" class="form-check-input" />
                            <span>Dịch vụ</span>
                        </div>
                        <div class="kiot-ms-item" data-val="Combo - đóng gói" data-name="Combo - đóng gói">
                            <input type="checkbox" class="form-check-input" />
                            <span>Combo - đóng gói</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </aside>

    <!-- Backdrop che mờ khi mở bộ lọc trên mobile/zoom in -->
    <div class="kiot-sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Nút tròn thu gọn / mở rộng ở ranh giới giữa sidebar và bảng (KiotViet style - chỉ dùng cho desktop) -->
    <button type="button" class="kiot-sidebar-toggle-btn d-none d-lg-flex" id="btnToggleSidebar" title="Thu gọn bộ lọc (F4)">
        <i class="bi bi-chevron-left" id="sidebarToggleIcon"></i>
    </button>

    <!-- CỘT BÊN PHẢI: THANH TÌM KIẾM THẲNG HÀNG VỚI DANH SÁCH + BẢNG HÀNG HÓA -->
    <main class="kiot-main-col">
        <!-- Toolbar trên cùng: Thanh tìm kiếm thẳng hàng với list bảng bên dưới -->
        <div class="kiot-toolbar-row">
            <!-- Tiêu đề + Nút phễu bộ lọc trên mobile / zoom in (chuẩn theo ảnh mẫu KiotViet) -->
            <div class="kiot-mobile-title-wrap d-lg-none d-flex align-items-center gap-2">
                <span class="kiot-mobile-title fw-bold fs-6 text-dark">Hàng hóa</span>
                <button type="button" class="btn btn-sm btn-outline-primary kiot-btn-funnel" id="btnMobileFilter" title="Mở bộ lọc hàng hóa">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>

            <div class="kiot-search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="keywordSearch" class="form-control" placeholder="Theo mã, tên hàng" value="@Model.Q" autocomplete="off" />
                <i class="bi bi-arrow-left-right" title="Tìm kiếm nâng cao"></i>
            </div>

            <div class="kiot-actions-group">
                <!-- Dropdown + Tạo mới (Click vào bất kỳ vị trí nào của nút đều mở menu tùy chọn) -->
                <div class="dropdown">
                    <button class="btn btn-primary dropdown-toggle kiot-btn-create d-inline-flex align-items-center" type="button" id="btnDropdownCreate" data-bs-toggle="dropdown" aria-expanded="false" title="Thêm mới">
                        <i class="bi bi-plus-lg me-1"></i><span class="d-none d-md-inline">Tạo mới</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="btnDropdownCreate">
                        <li>
                            <a class="dropdown-item py-2" href="javascript:void(0)" id="btnOpenCreateModal">
                                <i class="bi bi-box-seam me-2 text-primary"></i>Thêm hàng hóa
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Nút Import & Xuất file cho Desktop -->
                <button type="button" class="btn btn-tool d-none d-md-inline-flex" onclick="alert('Tính năng Import file Excel');">
                    <i class="bi bi-box-arrow-in-down me-1"></i>Import file
                </button>
                <button type="button" class="btn btn-tool d-none d-md-inline-flex" onclick="alert('Tính năng xuất danh sách Excel');">
                    <i class="bi bi-box-arrow-up me-1"></i>Xuất file
                </button>

                <!-- Dropdown gom Import/Xuất trên Mobile/Zoom in (Icon bảng tính y hệt ảnh) -->
                <div class="dropdown d-inline-block d-md-none">
                    <button class="btn btn-tool" type="button" id="btnDropdownExcelMobile" data-bs-toggle="dropdown" aria-expanded="false" title="Nhập / Xuất Excel">
                        <i class="bi bi-table"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="btnDropdownExcelMobile">
                        <li>
                            <a class="dropdown-item py-2" href="javascript:void(0)" onclick="alert('Tính năng Import file Excel');">
                                <i class="bi bi-box-arrow-in-down me-2 text-primary"></i>Import file
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" href="javascript:void(0)" onclick="alert('Tính năng xuất danh sách Excel');">
                                <i class="bi bi-box-arrow-up me-2 text-success"></i>Xuất file
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- 3 icon phụ của KiotViet -->
                <button type="button" class="btn btn-tool d-none d-sm-inline-flex" title="Tải lại bảng" id="btnReloadTable">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button type="button" class="btn btn-tool" title="Cài đặt">
                    <i class="bi bi-gear"></i>
                </button>
                <button type="button" class="btn btn-tool" title="Trợ giúp" onclick="alert('Hướng dẫn sử dụng Quản lý Hàng hóa');">
                    <i class="bi bi-question-circle"></i>
                </button>
            </div>
        </div>

        <!-- Bảng danh sách hàng hóa -->
        <section id="content">
            <div id="productTableContainer">
                <partial name="_HangHoaTable" model="Model" />
            </div>
        </section>
    </main>
</div>

<!-- ========================================================================
     MODAL KIOTVIET: THÊM MỚI / CẬP NHẬT HÀNG HÓA CHUẨN PROTOTYPE (5 ẢNH CSDL)
     ======================================================================== -->
<partial name="_HangHoaModal" model="Model" />

<!-- ========================================================================
     MODAL TẠO NHANH NHÓM HÀNG
     ======================================================================== -->
<div class="modal fade" id="quickGroupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold">Tạo mới nhóm hàng</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <label class="form-label small fw-semibold text-muted mb-1">Tên nhóm hàng <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="quickGroupInput" placeholder="Ví dụ: Bánh kẹo, Nước giải khát…" />
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Bỏ qua</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnSaveQuickGroup">Lưu nhóm</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================
     MODAL XÁC NHẬN XÓA HÀNG HÓA
     ======================================================================== -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger">Xóa hàng hóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                Bạn có chắc chắn muốn xóa hàng hóa <strong id="deleteTargetName"></strong>? Thao tác này chỉ thực hiện được nếu hàng hóa chưa phát sinh giao dịch.
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Bỏ qua</button>
                <button type="button" class="btn btn-danger btn-sm" id="btnExecuteDelete">Đồng ý xóa</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function () {
    let currentPage = @Model.Page;
    let deleteId = 0;
    const groupModal = new bootstrap.Modal(document.getElementById('quickGroupModal'));

    // 1. Thu gọn / Mở rộng (Kéo vào / Kéo ra) sidebar bên trái
    let animTimer = null;
    function toggleSidebar(forceState) {
        const container = $('#kiotContainer');
        const isCollapsed = container.hasClass('sidebar-collapsed');
        const shouldCollapse = (typeof forceState === 'boolean') ? forceState : !isCollapsed;

        // Bật trạng thái đang chuyển động để khóa tràn nội dung, chuyển động êm ái
        clearTimeout(animTimer);
        container.addClass('sidebar-animating');
        animTimer = setTimeout(() => {
            container.removeClass('sidebar-animating');
        }, 420);

        if (shouldCollapse) {
            // Kéo vào (Thu gọn)
            container.addClass('sidebar-collapsed');
            $('#sidebarToggleIcon').removeClass('bi-chevron-left').addClass('bi-chevron-right');
            $('#btnToggleSidebar').attr('title', 'Mở rộng bộ lọc (F4)');
            localStorage.setItem('kiot_sidebar_state', 'collapsed');
        } else {
            // Kéo ra (Mở rộng)
            container.removeClass('sidebar-collapsed');
            $('#sidebarToggleIcon').removeClass('bi-chevron-right').addClass('bi-chevron-left');
            $('#btnToggleSidebar').attr('title', 'Thu gọn bộ lọc (F4)');
            localStorage.setItem('kiot_sidebar_state', 'expanded');
        }
    }

    // Khôi phục trạng thái thu gọn / mở rộng nếu có lưu
    if (localStorage.getItem('kiot_sidebar_state') === 'collapsed') {
        toggleSidebar(true);
    }

    // Bấm nút kéo mở / thu gọn - phản hồi tức thì và tin cậy 100%
    $('#btnToggleSidebar').on('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        toggleSidebar();
    });

    // Hover buffer cho nút thò thụt khi sidebar đang mở (chống giật/flicker)
    let toggleHoverTimer = null;
    $('#sidebarFilterCol, #btnToggleSidebar').on('mouseenter', function () {
        clearTimeout(toggleHoverTimer);
        $('#btnToggleSidebar').addClass('btn-visible');
    }).on('mouseleave', function () {
        clearTimeout(toggleHoverTimer);
        toggleHoverTimer = setTimeout(function () {
            if (!$('#sidebarFilterCol:hover').length && !$('#btnToggleSidebar:hover').length) {
                $('#btnToggleSidebar').removeClass('btn-visible');
            }
        }, 120);
    });

    // Phím tắt F4 để kéo vào / kéo ra
    $(document).on('keydown', function (e) {
        if (e.key === 'F4') {
            e.preventDefault();
            toggleSidebar();
        }
    });

    // Mở / đóng bộ lọc dạng drawer trên Mobile / Zoom in
    $('#btnMobileFilter').on('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        $('#sidebarFilterCol').addClass('show-mobile');
        $('#sidebarBackdrop').addClass('show');
    });

    function closeMobileSidebar() {
        $('#sidebarFilterCol').removeClass('show-mobile');
        $('#sidebarBackdrop').removeClass('show');
    }

    $('#btnCloseSidebarMobile, #sidebarBackdrop').on('click', function (e) {
        e.preventDefault();
        closeMobileSidebar();
    });

    // Filter states
    let activeDuKienVal = '@(Model.DuKienFilter ?? "ALL")';
    let activeTgTaoVal = '@(Model.TgTaoFilter ?? "ALL")';
    let activeTgTaoFrom = '';
    let activeTgTaoTo = '';
    let isStarredFilterActive = @(Model.DaDanhDauFilter ? "true" : "false");

    // Calendar state
    const todayObj = new Date();
    const calState = {
        tgt: {
            currentYear: todayObj.getFullYear(),
            currentMonth: todayObj.getMonth(),
            start: todayObj,
            end: todayObj
        },
        dk: {
            currentYear: todayObj.getFullYear(),
            currentMonth: todayObj.getMonth(),
            start: todayObj,
            end: todayObj
        }
    };

    function renderDualCalendar(target) {
        const y = calState[target].currentYear;
        const m = calState[target].currentMonth;
        renderMonth(target, 1, y, m);
        let y2 = y;
        let m2 = m + 1;
        if (m2 > 11) { m2 = 0; y2++; }
        renderMonth(target, 2, y2, m2);
        updateCalendarHeader(target);
    }

    function renderMonth(target, idx, year, month) {
        const prefix = target === 'tgt' ? '#tgt' : '#dk';
        $(`${prefix}MonthTitle${idx}`).text(`Tháng ${month + 1} ${year}`);
        const tbody = $(`${prefix}CalBody${idx}`).empty();

        const firstDayOfWeek = (new Date(year, month, 1).getDay() + 6) % 7; // 0=T2, 6=CN
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const daysInPrevMonth = new Date(year, month, 0).getDate();

        let tr = $('<tr>');
        let dayCount = 0;

        for (let i = 0; i < firstDayOfWeek; i++) {
            const d = daysInPrevMonth - firstDayOfWeek + i + 1;
            tr.append(`<td class="text-muted empty-day">${d}</td>`);
            dayCount++;
        }

        for (let day = 1; day <= daysInMonth; day++) {
            const curDate = new Date(year, month, day);
            const iso = curDate.getFullYear() + '-' + String(curDate.getMonth() + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');
            const td = $(`<td class="cal-day" data-target="${target}" data-iso="${iso}">${day}</td>`);

            const s = calState[target].start;
            const e = calState[target].end;
            if (s && e) {
                const curT = new Date(year, month, day).setHours(0,0,0,0);
                const sT = new Date(s).setHours(0,0,0,0);
                const eT = new Date(e).setHours(0,0,0,0);
                if (curT === sT && curT === eT) {
                    td.addClass('selected');
                } else if (curT === sT) {
                    td.addClass('range-start');
                } else if (curT === eT) {
                    td.addClass('range-end');
                } else if (curT > sT && curT < eT) {
                    td.addClass('in-range');
                }
            } else if (s) {
                const curT = new Date(year, month, day).setHours(0,0,0,0);
                const sT = new Date(s).setHours(0,0,0,0);
                if (curT === sT) td.addClass('selected');
            }

            tr.append(td);
            dayCount++;
            if (dayCount % 7 === 0) {
                tbody.append(tr);
                tr = $('<tr>');
            }
        }

        if (dayCount % 7 !== 0) {
            let nextDay = 1;
            while (dayCount % 7 !== 0) {
                tr.append(`<td class="text-muted empty-day">${nextDay++}</td>`);
                dayCount++;
            }
            tbody.append(tr);
        }
    }

    function updateCalendarHeader(target) {
        const prefix = target === 'tgt' ? '#tgt' : '#dk';
        const s = calState[target].start;
        const e = calState[target].end;
        if (s) {
            $(`${prefix}CalFromText`).text(formatDateVN(s));
            $(`${prefix}CalToText`).text(formatDateVN(e || s));
        }
    }

    function formatDateVN(d) {
        if (!d) return '';
        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        return `${day}/${month}/${d.getFullYear()}`;
    }

    function formatDateISO(d) {
        if (!d) return '';
        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        return `${d.getFullYear()}-${month}-${day}`;
    }

    // Init dual calendars
    renderDualCalendar('tgt');
    renderDualCalendar('dk');
    $('#dotTonKho').css('display', $('#filterTonKho').val() !== 'ALL' ? 'inline-block' : 'none');

    // Click on calendar day
    $(document).on('click', '.cal-day', function (e) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        const target = $(this).data('target');
        const iso = $(this).data('iso');
        const clicked = new Date(iso + 'T00:00:00');

        if (!calState[target].start || (calState[target].start && calState[target].end)) {
            calState[target].start = clicked;
            calState[target].end = null;
        } else {
            if (clicked < calState[target].start) {
                calState[target].start = clicked;
            } else {
                calState[target].end = clicked;
            }
        }
        renderDualCalendar(target);
    });

    // Calendar month navigation
    $(document).on('click', '.btn-cal-prev', function (e) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        const target = $(this).data('target');
        calState[target].currentMonth--;
        if (calState[target].currentMonth < 0) {
            calState[target].currentMonth = 11;
            calState[target].currentYear--;
        }
        renderDualCalendar(target);
    });

    $(document).on('click', '.btn-cal-next', function (e) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        const target = $(this).data('target');
        calState[target].currentMonth++;
        if (calState[target].currentMonth > 11) {
            calState[target].currentMonth = 0;
            calState[target].currentYear++;
        }
        renderDualCalendar(target);
    });

    // Calendar "Hôm nay"
    $(document).on('click', '.btn-cal-today', function (e) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        const target = $(this).data('target');
        const t = new Date();
        calState[target].currentYear = t.getFullYear();
        calState[target].currentMonth = t.getMonth();
        calState[target].start = t;
        calState[target].end = t;
        renderDualCalendar(target);
    });

    // Calendar "Áp dụng"
    $(document).on('click', '.btn-apply-calendar', function (e) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        const target = $(this).data('target');
        const s = calState[target].start || new Date();
        const eDate = calState[target].end || s;
        const rangeText = `${formatDateVN(s)} - ${formatDateVN(eDate)}`;

        if (target === 'tgt') {
            $('#popupTgtCalendar').hide();
            $('#tgtCustom').prop('checked', true);
            activeTgTaoVal = 'CUSTOM';
            activeTgTaoFrom = formatDateISO(s);
            activeTgTaoTo = formatDateISO(eDate);
            $('#textTgtRange').text(rangeText);
            $('#textTgtCustom').text(rangeText);
        } else {
            $('#popupDkCalendar').hide();
            $('#dkCustom').prop('checked', true);
            activeDuKienVal = 'CUSTOM';
            $('#textDkRange').text(rangeText);
            $('#textDkCustom').text(rangeText);
        }
        currentPage = 1;
        loadTable();
    });

    function toggleFloatingPopup(triggerElement, popupSelector) {
        const popup = $(popupSelector);
        if (popup.is(':visible')) {
            popup.hide();
            return;
        }
        $('.quick-date-popup, .dual-calendar-popup').hide();

        const trigger = $(triggerElement);
        const rect = trigger[0].getBoundingClientRect();
        const popupWidth = popup.outerWidth() || (popupSelector.includes('Calendar') ? 540 : 330);
        
        let left = rect.left;
        let top = rect.bottom + 6;

        const maxRight = $(window).width() - 10;
        if (left + popupWidth > maxRight) {
            left = maxRight - popupWidth;
        }
        if (left < 10) left = 10;

        const popupHeight = popup.outerHeight() || 300;
        if (top + popupHeight > $(window).height() - 10) {
            top = Math.max(10, rect.top - popupHeight - 6);
        }

        popup.css({
            position: 'fixed',
            top: top + 'px',
            left: left + 'px',
            zIndex: 1060
        }).show();
    }

    // 2. Mở Quick Date Popups cho Dự kiến & Thời gian tạo (Nổi fixed không bị che bởi scroll)
    $('#btnOpenDkQuick').on('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        $('#dkAll').prop('checked', true);
        toggleFloatingPopup(this, '#popupDkQuick');
    });

    $('#labelDkAll').on('click', function (e) {
        if ($(e.target).closest('#btnOpenDkQuick').length) return;
        e.stopPropagation();
        toggleFloatingPopup(this, '#popupDkQuick');
    });

    $('#btnOpenDkCalendar').on('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        $('#dkCustom').prop('checked', true);
        toggleFloatingPopup(this, '#popupDkCalendar');
    });

    $('#dkCustom').on('click', function (e) {
        e.stopPropagation();
        toggleFloatingPopup(this, '#popupDkCalendar');
    });

    $('#btnOpenTgtQuick').on('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        $('#tgtAll').prop('checked', true);
        toggleFloatingPopup(this, '#popupTgtQuick');
    });

    $('#labelTgtAll').on('click', function (e) {
        if ($(e.target).closest('#btnOpenTgtQuick').length) return;
        e.stopPropagation();
        toggleFloatingPopup(this, '#popupTgtQuick');
    });

    $('#btnOpenTgtCalendar').on('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        $('#tgtCustom').prop('checked', true);
        toggleFloatingPopup(this, '#popupTgtCalendar');
    });

    $('#tgtCustom').on('click', function (e) {
        e.stopPropagation();
        toggleFloatingPopup(this, '#popupTgtCalendar');
    });

    // Tự động đóng popup ngày khi cuộn bộ lọc bên trái
    $('.kiot-filter-box').on('scroll', function () {
        $('.quick-date-popup, .dual-calendar-popup').hide();
    });

    // Reset khi click radio "Toàn thời gian"
    $('#dkAll').on('change', function () {
        if ($(this).is(':checked')) {
            activeDuKienVal = 'ALL';
            $('#textDkRange').text('Toàn thời gian');
            $('#textDkCustom').text('Tùy chỉnh');
            $('#popupDkQuick .quick-date-btn, #popupDkQuick .quick-date-pill-all').removeClass('active');
            currentPage = 1;
            loadTable();
        }
    });

    $('#tgtAll').on('change', function () {
        if ($(this).is(':checked')) {
            activeTgTaoVal = 'ALL';
            activeTgTaoFrom = '';
            activeTgTaoTo = '';
            $('#textTgtRange').text('Toàn thời gian');
            $('#textTgtCustom').text('Tùy chỉnh');
            $('#popupTgtQuick .quick-date-btn, #popupTgtQuick .quick-date-pill-all').removeClass('active');
            currentPage = 1;
            loadTable();
        }
    });

    // Chọn option trong Quick Date Popup
    $(document).on('click', '.quick-date-btn, .quick-date-pill-all', function (e) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        const target = $(this).data('target');
        const val = $(this).data('val');
        const text = $(this).text();
        if (target === 'dk') {
            activeDuKienVal = val;
            $('#textDkRange').text(text);
            $('#popupDkQuick').hide();
            $('#dkAll').prop('checked', true);
            $('#popupDkQuick').find('.quick-date-btn, .quick-date-pill-all').removeClass('active');
            $(this).addClass('active');
        } else {
            activeTgTaoVal = val;
            activeTgTaoFrom = '';
            activeTgTaoTo = '';
            $('#textTgtRange').text(text);
            $('#popupTgtQuick').hide();
            $('#tgtAll').prop('checked', true);
            $('#popupTgtQuick').find('.quick-date-btn, .quick-date-pill-all').removeClass('active');
            $(this).addClass('active');
        }
        currentPage = 1;
        loadTable();
    });

    // Đóng popup lịch khi bấm Bỏ qua
    $(document).on('click', '.btn-close-popup', function (e) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        $('.dual-calendar-popup').hide();
    });

    // 3. Multi-select Tags Dropdown cho Nhóm hàng, Nhà cung cấp, Vị trí, Loại hàng (KiotViet style)
    const filterState = {
        nhom: [],     // array of { val: '1', name: 'Bánh' }
        ncc: [],      // array of { val: 'Công ty Pharmedic', name: 'Công ty Pharmedic' }
        vitri: [],    // array of { val: 'Kho trung tâm', name: 'Kho trung tâm' }
        loaihang: []  // array of { val: 'Hàng hóa', name: 'Hàng hóa' }
    };

    function escapeHtml(text) {
        if (!text) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    const filterPlaceholders = {
        nhom: 'Chọn nhóm hàng',
        ncc: 'Chọn nhà cung cấp',
        vitri: 'Chọn vị trí',
        loaihang: 'Chọn loại hàng'
    };

    const filterDotSelectors = {
        nhom: '#dotNhomHang',
        ncc: '#dotNcc',
        vitri: '#dotViTri',
        loaihang: '#dotLoaiHang'
    };

    function renderMultiSelectBox(key) {
        const boxId = key === 'nhom' ? '#boxNhomHang' :
                      key === 'ncc' ? '#boxNcc' :
                      key === 'vitri' ? '#boxViTri' : '#boxLoaiHang';
        const dropdownId = key === 'nhom' ? '#dropdownNhomHang' :
                           key === 'ncc' ? '#dropdownNcc' :
                           key === 'vitri' ? '#dropdownViTri' : '#dropdownLoaiHang';

        const box = $(boxId);
        const dropdown = $(dropdownId);
        const selected = filterState[key] || [];
        const placeholder = filterPlaceholders[key];
        const dot = $(filterDotSelectors[key]);

        // Cập nhật chấm xanh indicator
        dot.css('display', selected.length > 0 ? 'inline-block' : 'none');

        // Cập nhật trạng thái checkbox & selected trong dropdown
        dropdown.find('.kiot-ms-item').each(function () {
            const val = String($(this).data('val'));
            const isSel = selected.some(x => String(x.val) === val);
            $(this).toggleClass('selected', isSel);
            $(this).find('input[type="checkbox"]').prop('checked', isSel);
        });

        // Chưa chọn mục nào: hiển thị placeholder
        if (selected.length === 0) {
            box.html(`<span class="kiot-ms-placeholder">${placeholder}</span>`);
            return;
        }

        // Đã chọn: hiển thị tối đa 3 thẻ, nếu quá 3 thẻ thì thẻ thứ 4 là "+n khác"
        let html = '';
        const maxVisible = 3;

        if (selected.length <= maxVisible) {
            selected.forEach(item => {
                html += `
                    <span class="kiot-pill-tag" data-val="${escapeHtml(item.val)}">
                        <span class="tag-text">${escapeHtml(item.name)}</span>
                        <span class="tag-remove" title="Bỏ chọn">&times;</span>
                    </span>
                `;
            });
        } else {
            for (let i = 0; i < maxVisible; i++) {
                const item = selected[i];
                html += `
                    <span class="kiot-pill-tag" data-val="${escapeHtml(item.val)}">
                        <span class="tag-text">${escapeHtml(item.name)}</span>
                        <span class="tag-remove" title="Bỏ chọn">&times;</span>
                    </span>
                `;
            }
            const remaining = selected.length - maxVisible;
            const otherNames = selected.slice(maxVisible).map(x => x.name).join(', ');
            html += `
                <span class="kiot-pill-more" title="${escapeHtml(otherNames)}">+${remaining} khác</span>
            `;
        }

        box.html(html);
    }

    function checkSidebarDropdownDirection(box, dropdown) {
        if (!box.length || !dropdown.length) return;

        const boxRect = box[0].getBoundingClientRect();
        const filterBox = box.closest('.kiot-filter-box');
        
        let containerBottom = $(window).height();
        let containerTop = 0;

        if (filterBox.length) {
            const filterRect = filterBox[0].getBoundingClientRect();
            containerBottom = Math.min(filterRect.bottom, $(window).height());
            containerTop = Math.max(filterRect.top, 0);
        }

        const spaceBelow = containerBottom - boxRect.bottom;
        const spaceAbove = boxRect.top - containerTop;

        const neededHeight = 220; // Chiều cao tối đa cần thiết của dropdown

        if (spaceBelow < neededHeight && spaceAbove > spaceBelow) {
            dropdown.addClass('drop-up');
            const maxH = Math.min(250, Math.max(120, spaceAbove - 10));
            dropdown.css('max-height', maxH + 'px');
        } else {
            dropdown.removeClass('drop-up');
            const maxH = Math.min(250, Math.max(120, spaceBelow - 10));
            dropdown.css('max-height', maxH + 'px');
        }
    }

    function setupMultiSelect(boxId, dropdownId, key) {
        const box = $(boxId);
        const dropdown = $(dropdownId);

        // Click box: mở/đóng dropdown
        box.on('click', function (e) {
            if ($(e.target).closest('.tag-remove').length) return;
            e.stopPropagation();
            $('.kiot-ms-dropdown').not(dropdown).removeClass('show drop-up').css('max-height', '');
            $('.kiot-multiselect-box').not(box).removeClass('open');
            $('.quick-date-popup, .dual-calendar-popup').hide();

            const willShow = !dropdown.hasClass('show');
            if (willShow) {
                checkSidebarDropdownDirection(box, dropdown);
                dropdown.addClass('show');
                box.addClass('open');
                dropdown.find('.kiot-ms-search input').focus();
            } else {
                dropdown.removeClass('show drop-up').css('max-height', '');
                box.removeClass('open');
            }
        });

        // Click nút x trên pill tag: gỡ bỏ item
        box.on('click', '.tag-remove', function (e) {
            e.stopPropagation();
            const val = String($(this).closest('.kiot-pill-tag').data('val'));
            filterState[key] = (filterState[key] || []).filter(x => String(x.val) !== val);
            renderMultiSelectBox(key);
            currentPage = 1;
            loadTable();
        });

        // Click vào badge +n khác: mở dropdown
        box.on('click', '.kiot-pill-more', function (e) {
            e.stopPropagation();
            $('.kiot-ms-dropdown').not(dropdown).removeClass('show drop-up').css('max-height', '');
            checkSidebarDropdownDirection(box, dropdown);
            dropdown.addClass('show');
            box.addClass('open');
        });

        // Click item trong dropdown: chọn/bỏ chọn
        dropdown.on('click', '.kiot-ms-item', function (e) {
            e.stopPropagation();

            const val = String($(this).data('val'));
            const name = $(this).data('name') || $(this).text().trim();
            const idx = (filterState[key] || []).findIndex(x => String(x.val) === val);

            if (idx >= 0) {
                filterState[key].splice(idx, 1);
            } else {
                filterState[key].push({ val: val, name: name });
            }

            renderMultiSelectBox(key);
            currentPage = 1;
            loadTable();
        });

        // Tìm kiếm nhanh trong dropdown
        dropdown.find('.kiot-ms-search input').on('input', function (e) {
            e.stopPropagation();
            const term = $(this).val().trim().toLowerCase();
            dropdown.find('.kiot-ms-item').each(function () {
                const text = ($(this).data('name') || $(this).text()).toLowerCase();
                if (!term || text.includes(term)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });
    }

