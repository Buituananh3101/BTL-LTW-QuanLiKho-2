@model BTL_LTW_QuanLiKho_2.Models.HangHoa
<dl class="row goods-info mb-0">
<dt class="col-sm-4">Mã hàng</dt><dd class="col-sm-8">@Model.MaHangNoiBo</dd>
<dt class="col-sm-4">Tên hàng hóa</dt><dd class="col-sm-8">@Model.TenHang</dd>
<dt class="col-sm-4">Nhóm hàng</dt><dd class="col-sm-8">@Model.MaNhomNavigation?.TenNhom</dd>
<dt class="col-sm-4">Đơn vị tính</dt><dd class="col-sm-8">@Model.MaDvtNavigation?.TenDvt</dd>
<dt class="col-sm-4">Giá tham khảo</dt><dd class="col-sm-8">@Model.GiaBanThamKhao.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</dd>
<dt class="col-sm-4">Quy cách</dt><dd class="col-sm-8">@(Model.QuyCach ?? "—")</dd>
<dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8">@(Model.TrangThai == "DANG_BAN" ? "Đang bán" : Model.TrangThai == "NGUNG_BAN" ? "Ngừng bán" : Model.TrangThai)</dd>
</dl>
