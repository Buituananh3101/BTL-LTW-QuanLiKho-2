@model BTL_LTW_QuanLiKho_2.ViewModels.Common.KiotMultiSelectVM
@{
    var id = Model?.Id ?? "";
    var boxId = "box" + id;
    var dropdownId = "dropdown" + id;
    var dotId = !string.IsNullOrEmpty(Model?.DotId) ? Model.DotId : ("dot" + id);
    var searchPlaceholder = !string.IsNullOrEmpty(Model?.SearchPlaceholder)
        ? Model.SearchPlaceholder
        : $"Tìm {Model?.Title?.ToLower() ?? ""}...";
}

<div class="f-block position-relative">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h6 class="mb-0">@Model?.Title <span class="filter-dot" id="@dotId"></span></h6>
        @if (!string.IsNullOrEmpty(Model?.HeaderActionText))
        {
            <a href="javascript:void(0)" class="small text-primary text-decoration-none fw-semibold" id="@Model.HeaderActionId">
                @Model.HeaderActionText
            </a>
        }
    </div>
    <div class="position-relative">
        <div class="kiot-multiselect-box" id="@boxId" data-filter="@Model?.DataFilter">
            <span class="kiot-ms-placeholder">@Model?.Placeholder</span>
        </div>
        <div class="kiot-ms-dropdown shadow" id="@dropdownId">
            @if (Model?.HasSearch == true)
            {
                <div class="kiot-ms-search">
                    <input type="text" placeholder="@searchPlaceholder" autocomplete="off" />
                </div>
            }
            @if (Model?.Items != null)
            {
                foreach (var item in Model.Items)
                {
                    <div class="kiot-ms-item @(item.Selected ? "selected" : "")" data-val="@item.Value" data-name="@item.Text">
                        <input type="checkbox" class="form-check-input" @(item.Selected ? "checked" : "") />
                        <span class="kiot-ms-text">@item.Text</span>
                        @if (Model?.AllowEdit == true)
                        {
                            <button type="button" class="kiot-item-edit-btn hh-item-edit-btn" data-id="@item.Value" data-name="@item.Text" data-type="@Model.Id.ToLower()" title="Sửa @(Model.Title.ToLower())" aria-label="Sửa @item.Text">
                                <i class="bi bi-pencil" style="font-size:12px;pointer-events:none;"></i>
                            </button>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>
