<header class="topbar">
  <div class="d-flex align-items-center gap-3">
    <a class="brand" asp-controller="HangHoa" asp-action="Index">
      <span class="brand-logo"><i class="bi bi-box-seam"></i></span>
      <span>KhoPro</span>
    </a>

    <!-- Warehouse Switcher (ViewComponent) -->
    @await Component.InvokeAsync("WarehouseSwitcher")
  </div>

  <div class="topbar-right">
    <a href="#" title="Hỗ trợ"><i class="bi bi-chat-left-text"></i>Hỗ trợ</a>
    <a href="#" title="Góp ý"><i class="bi bi-pencil-square"></i>Góp ý</a>
    <a href="#" class="bell" title="Thông báo">
      <i class="bi bi-bell-fill fs-6"></i>
      <span class="dot">2</span>
    </a>
    <a href="#" title="Cài đặt"><i class="bi bi-gear-fill fs-6"></i></a>
    @if (User.Identity?.IsAuthenticated == true)
    {
      <div class="dropdown">
        <button class="btn btn-link text-decoration-none dropdown-toggle d-flex align-items-center gap-2 p-0 user-btn" type="button" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
          <span class="avatar"><i class="bi bi-person-fill"></i></span>
          <span class="fw-semibold small user-name">@User.GetTenHienThi()</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenuBtn">
          <li class="px-3 py-2 border-bottom">
            <div class="fw-bold small text-dark">@User.GetTenHienThi()</div>
            <div class="text-muted smaller" style="font-size: 11px;">@User.GetVaiTro()</div>
          </li>
          <li>
            <a class="dropdown-item small text-danger py-2" asp-controller="Account" asp-action="LogoutGet">
              <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
            </a>
          </li>
        </ul>
      </div>
    }
    else
    {
      <a asp-controller="Account" asp-action="Login" class="user-login-link text-decoration-none d-flex align-items-center gap-2" title="Đăng nhập">
        <span class="avatar"><i class="bi bi-person"></i></span>
        <span class="fw-semibold small user-name">Đăng nhập</span>
      </a>
    }
  </div>
</header>

<script>
function switchWorkingWarehouse(whId) {
    fetch('/Account/SwitchWarehouse?warehouseId=' + whId, { method: 'POST' })
        .then(() => window.location.reload());
}
</script>
