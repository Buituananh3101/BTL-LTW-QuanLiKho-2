@* ========================================================================
   _PromptModal.cshtml - Modal con dùng chung toàn hệ thống
   Phục vụ: Thêm mới nhanh hoặc Sửa trực tiếp (✎) / Xóa (Vị trí, Nhóm hàng, ĐVT, NCC, KH...)
   Gọi bằng JavaScript 1 dòng: AppPrompt.open({ title, label, value, showDelete, onSave, onDelete });
   ======================================================================== *@

<div class="kp-prompt-ov" id="kpPromptOv" role="dialog" aria-modal="true" aria-labelledby="kpPromptTitle">
    <div class="kp-prompt-modal">
        <div class="kp-prompt-head">
            <h3 id="kpPromptTitle">Tạo mới</h3>
            <button type="button" class="btn-close" id="kpPromptClose" aria-label="Đóng"></button>
        </div>
        <div class="kp-prompt-body">
            <div class="mb-2">
                <label for="kpPromptInput" class="form-label fw-semibold text-secondary small" id="kpPromptLabel">Tên <span class="text-danger ms-1">*</span></label>
                <input type="text" id="kpPromptInput" class="form-control" autocomplete="off" />
                <div class="invalid-feedback" id="kpPromptErr" style="display: none;">Vui lòng nhập thông tin.</div>
            </div>
        </div>
        <div class="kp-prompt-foot">
            <div>
                <button type="button" class="btn btn-outline-danger btn-sm" id="kpPromptDelete" style="display: none;">
                    <i class="bi bi-trash me-1"></i>Xóa
                </button>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light btn-sm px-3" id="kpPromptCancel">Bỏ qua</button>
                <button type="button" class="btn btn-primary btn-sm px-3" id="kpPromptSave">Lưu</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận xóa / thông báo dùng chung toàn hệ thống (chuẩn chuyên nghiệp, hiển thị chính giữa màn hình) -->
<div class="kp-confirm-ov" id="kpConfirmOv" role="dialog" aria-modal="true" aria-labelledby="kpConfirmTitleText">
    <div class="kp-confirm-modal">
        <div class="kp-confirm-head">
            <h3 id="kpConfirmTitle" class="d-flex align-items-center gap-2 m-0" style="color: #dc2626; font-size: 18px; font-weight: 700;">
                <i class="bi bi-trash" id="kpConfirmIcon" style="font-size: 19px;"></i>
                <span id="kpConfirmTitleText">Xóa</span>
            </h3>
            <button type="button" class="btn-close" id="kpConfirmClose" aria-label="Đóng"></button>
        </div>
        <div class="kp-confirm-body" id="kpConfirmBody">
            <div id="kpConfirmMsg"></div>
        </div>
        <div class="kp-confirm-foot">
            <button type="button" class="btn btn-outline-secondary" id="kpConfirmCancel">Bỏ qua</button>
            <button type="button" class="btn btn-danger" id="kpConfirmOk">Đồng ý xóa</button>
        </div>
    </div>
</div>

