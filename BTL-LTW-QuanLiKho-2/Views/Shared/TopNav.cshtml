@inject BTL_LTW_QuanLiKho_2.Models.QuanLyKhoPhuQuocLtwContext dbContext
@{
    var currentWhId = Context.Session.GetInt32("CurrentWarehouseId") ?? 1;
    var warehouses = dbContext.Khos.Where(k => k.TrangThai == "HOAT_DONG").OrderBy(k => k.MaKho).ToList();
    var currentWh = warehouses.FirstOrDefault(w => w.MaKho == currentWhId) ?? warehouses.FirstOrDefault();
}
<nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
    <a class="navbar-brand ps-3 fw-bold" asp-controller="PhieuKiemKe" asp-action="Index">
        <span class="text-primary">Kiot</span>Kho
    </a>
    <button class="btn btn-link btn-sm order-1 order-lg-0 me-3 me-lg-0 text-white" id="sidebarToggle" type="button" aria-label="Ẩn hoặc hiện menu">☰</button>

    <!-- Warehouse Switcher -->
    <div class="dropdown ms-3">
        <button class="btn btn-sm btn-outline-light dropdown-toggle d-flex align-items-center gap-1" type="button" id="warehouseSwitcherBtn" data-bs-toggle="dropdown" aria-expanded="false">
            <span>🏢</span>
            <strong>@(currentWh?.TenKho ?? "Chọn kho")</strong>
        </button>
        <ul class="dropdown-menu shadow" aria-labelledby="warehouseSwitcherBtn">
            <li class="dropdown-header small text-uppercase">Chọn kho làm việc</li>
            @foreach (var wh in warehouses)
            {
                <li>
                    <a class="dropdown-item d-flex justify-content-between align-items-center @(wh.MaKho == currentWhId ? "active fw-bold" : "")" 
                       href="#" onclick="changeWorkingWarehouse(@wh.MaKho); return false;">
                        <span>@wh.TenKho</span>
                        @if (wh.MaKho == currentWhId)
                        {
                            <span>✔</span>
                        }
                    </a>
                </li>
            }
        </ul>
    </div>

    <div class="ms-auto me-3 d-flex align-items-center gap-3 text-white-50 small">
        <span class="d-none d-md-inline">👤 Trần Thị Kho (Thủ kho)</span>
    </div>
</nav>

<script>
function changeWorkingWarehouse(whId) {
    fetch('/PhieuKiemKe/SwitchWarehouse?warehouseId=' + whId, { method: 'POST' })
        .then(() => window.location.reload());
}
</script>
