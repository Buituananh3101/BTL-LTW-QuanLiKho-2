@model BTL_LTW_QuanLiKho_2.ViewModels.ChuyenKho.ChuyenKhoIndexVM
@using System.Globalization
@{
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
}

<div class="kiot-table-scroll-body">
    <table class="tbl" id="transferTable" style="width: max-content; min-width: 760px;">
        <thead>
            <tr>
                <th style="width: 36px; min-width: 36px;" class="text-center th-checkbox">
                    <input class="form-check-input" type="checkbox" id="selectAllRows" @(!Model.PagedData.Items.Any() ? "disabled" : "") />
                </th>
                <th style="width: 36px; min-width: 36px; cursor: pointer;" class="text-center th-star" onclick="toggleStarHeaderFilter(event)">
                    <span class="star-btn star-header-filter @(Model.Filter.DaDanhDau ? "starred" : "")" id="starHeaderFilter" title="@(Model.Filter.DaDanhDau ? "Bỏ lọc sao (Hiển thị tất cả)" : "Lọc danh sách phiếu được đánh dấu sao")">
                        <i class="bi @(Model.Filter.DaDanhDau ? "bi-star-fill" : "bi-star")"></i>
                    </span>
                </th>
                <th data-col="maphieu" style="width: 140px; min-width: 140px;" class="sortable-th @(Model.Filter.SortBy == "maphieu" ? (Model.Filter.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Mã chuyển hàng">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Mã chuyển hàng</span>
                            @if (Model.Filter.SortBy == "maphieu" && Model.Filter.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.Filter.SortBy == "maphieu" && Model.Filter.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="ngaylap" style="width: 135px; min-width: 135px;" class="sortable-th @(Model.Filter.SortBy == "ngaylap" ? (Model.Filter.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Thời gian">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Thời gian</span>
                            @if (Model.Filter.SortBy == "ngaylap" && Model.Filter.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.Filter.SortBy == "ngaylap" && Model.Filter.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="khonguon" style="width: 155px; min-width: 155px;" class="sortable-th @(Model.Filter.SortBy == "khonguon" ? (Model.Filter.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Từ kho">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Từ kho</span>
                            @if (Model.Filter.SortBy == "khonguon" && Model.Filter.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.Filter.SortBy == "khonguon" && Model.Filter.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="khodich" style="width: 155px; min-width: 155px;" class="sortable-th @(Model.Filter.SortBy == "khodich" ? (Model.Filter.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Tới kho">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Tới kho</span>
                            @if (Model.Filter.SortBy == "khodich" && Model.Filter.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.Filter.SortBy == "khodich" && Model.Filter.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="ngaychuyen" style="width: 135px; min-width: 135px;" class="sortable-th @(Model.Filter.SortBy == "ngaychuyen" ? (Model.Filter.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Ngày chuyển">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Ngày chuyển</span>
                            @if (Model.Filter.SortBy == "ngaychuyen" && Model.Filter.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.Filter.SortBy == "ngaychuyen" && Model.Filter.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="ngaynhan" style="width: 135px; min-width: 135px;" class="sortable-th @(Model.Filter.SortBy == "ngaynhan" ? (Model.Filter.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Ngày nhận">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Ngày nhận</span>
                            @if (Model.Filter.SortBy == "ngaynhan" && Model.Filter.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.Filter.SortBy == "ngaynhan" && Model.Filter.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="slchuyen" style="width: 105px; min-width: 105px;" class="num r text-end sortable-th @(Model.Filter.SortBy == "slchuyen" ? (Model.Filter.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo SL chuyển">
                    <div class="th-content justify-content-end">
                        <span class="th-title-wrap">
                            <span class="th-text">SL chuyển</span>
                            @if (Model.Filter.SortBy == "slchuyen" && Model.Filter.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.Filter.SortBy == "slchuyen" && Model.Filter.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="slnhan" style="width: 105px; min-width: 105px;" class="num r text-end sortable-th @(Model.Filter.SortBy == "slnhan" ? (Model.Filter.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo SL nhận">
                    <div class="th-content justify-content-end">
                        <span class="th-title-wrap">
                            <span class="th-text">SL nhận</span>
                            @if (Model.Filter.SortBy == "slnhan" && Model.Filter.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.Filter.SortBy == "slnhan" && Model.Filter.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="giatri" style="width: 135px; min-width: 135px;" class="num r text-end sortable-th @(Model.Filter.SortBy == "giatri" ? (Model.Filter.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Giá trị chuyển">
                    <div class="th-content justify-content-end">
                        <span class="th-title-wrap">
                            <span class="th-text">Giá trị chuyển</span>
                            @if (Model.Filter.SortBy == "giatri" && Model.Filter.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.Filter.SortBy == "giatri" && Model.Filter.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="ghi" style="width: 160px; min-width: 160px;" class="sortable-th @(Model.Filter.SortBy == "ghi" ? (Model.Filter.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Ghi chú">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Ghi chú</span>
                            @if (Model.Filter.SortBy == "ghi" && Model.Filter.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.Filter.SortBy == "ghi" && Model.Filter.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="st" style="width: 120px; min-width: 120px;" class="text-center sortable-th @(Model.Filter.SortBy == "st" ? (Model.Filter.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Trạng thái">
                    <div class="th-content justify-content-center">
                        <span class="th-title-wrap">
                            <span class="th-text">Trạng thái</span>
                            @if (Model.Filter.SortBy == "st" && Model.Filter.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.Filter.SortBy == "st" && Model.Filter.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
            </tr>
        </thead>
        <tbody>
            <!-- Dòng tổng hợp (Summary row) cuộn tự nhiên cùng nội dung bảng khớp Hàng hóa -->
            <tr class="summary-row">
                <td class="text-center"></td>
                <td class="text-center"></td>
                <td data-col="maphieu"></td>
                <td data-col="ngaylap"></td>
                <td data-col="khonguon"></td>
                <td data-col="khodich"></td>
                <td data-col="ngaychuyen"></td>
                <td data-col="ngaynhan"></td>
                <td data-col="slchuyen" class="num text-end fw-bold text-dark">@Model.TongSlChuyenTong.ToString("N0", viCulture)</td>
                <td data-col="slnhan" class="num text-end fw-bold text-dark">@Model.TongSlNhanTong.ToString("N0", viCulture)</td>
                <td data-col="giatri" class="num text-end fw-bold text-dark">@Model.TongGiaTriTong.ToString("N0", viCulture)</td>
                <td data-col="ghi"></td>
                <td data-col="st"></td>
            </tr>

            @if (!Model.PagedData.Items.Any())
            {
                <tr>
                    <td colspan="13" class="text-center py-5">
                        <div class="empty d-block py-5 text-center">
                            <div class="ico mb-3"><i class="bi bi-inbox fs-1 text-primary"></i></div>
                            <h5 class="fw-bold">Không tìm thấy phiếu chuyển hàng</h5>
                            <p class="text-muted mb-0 small">Không tìm thấy giao dịch nào phù hợp với bộ lọc hiện tại.<br />Nhấn <a href="javascript:void(0)" id="resetF" class="text-primary text-decoration-none fw-semibold">vào đây</a> để xóa bộ lọc và tiếp tục tìm kiếm.</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.PagedData.Items)
                {
                    <tr class="product-row tbl-row" data-id="@item.MaPhieuChuyen" title="Nhấn để xem chi tiết phiếu chuyển">
                        <td class="text-center cell-checkbox" onclick="event.stopPropagation();">
                            <input class="form-check-input row-select" type="checkbox" value="@item.MaPhieuChuyen" />
                        </td>
                        <td class="text-center cell-star" style="cursor: pointer;" onclick="toggleFavoriteTransfer(event, @item.MaPhieuChuyen, this)">
                            <span class="star-btn @(item.DaDanhDau ? "starred" : "")" data-id="@item.MaPhieuChuyen" title="@(item.DaDanhDau ? "Bỏ đánh dấu sao" : "Đánh dấu sao")">
                                <i class="bi @(item.DaDanhDau ? "bi-star-fill" : "bi-star")"></i>
                            </span>
                        </td>
                        <td data-col="maphieu">
                            <span class="text-break">@item.MaPhieuHienThi</span>
                        </td>
                        <td data-col="ngaylap">
                            @item.NgayLap.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td data-col="khonguon">
                            @item.TenKhoNguon
                        </td>
                        <td data-col="khodich">
                            @item.TenKhoDich
                        </td>
                        <td data-col="ngaychuyen">
                            @(item.ThoiDiemXuat?.ToString("dd/MM/yyyy HH:mm") ?? "---")
                        </td>
                        <td data-col="ngaynhan">
                            @(item.ThoiDiemNhan?.ToString("dd/MM/yyyy HH:mm") ?? "---")
                        </td>
                        <td data-col="slchuyen" class="num text-end">
                            @item.TongSoLuongChuyen.ToString("N0", viCulture)
                        </td>
                        <td data-col="slnhan" class="num text-end">
                            @(item.TrangThai == "DA_NHAN" ? item.TongSoLuongNhan.ToString("N0", viCulture) : "---")
                        </td>
                        <td data-col="giatri" class="num text-end text-dark">
                            @item.TongGiaTriChuyen.ToString("N0", viCulture)
                        </td>
                        <td data-col="ghi" class="text-truncate" style="max-width: 160px;" title="@item.GhiChu">
                            @(string.IsNullOrWhiteSpace(item.GhiChu) ? "---" : item.GhiChu)
                        </td>
                        <td data-col="st" class="text-center">
                            <span class="@item.BadgeClass">@item.TenTrangThai</span>
                        </td>
                    </tr>

                    <!-- Khối chi tiết bung ra (Inline Drawer / Accordion) giống Kiểm tồn -->
                    <tr class="product-detail-row dtl" id="dtl-@item.MaPhieuChuyen" style="display: none;">
                        <td colspan="13" class="p-0">
                            <div class="product-detail-panel-wrap" style="display: none;">
                                <div class="product-detail-panel dp" data-d="@item.MaPhieuChuyen">
                                    <div class="dp-tabs"><button type="button" class="dp-tab active" data-tab="info">Thông tin</button></div>
                                    <div class="kk-detail-fixed-wrap kiot-detail-fixed-wrap">
                                        <h2 class="d-flex align-items-center gap-2">
                                            <span class="fw-bold" style="font-size: 18px; color: #1e293b;">@item.MaPhieuHienThi</span>
                                            @if (item.TrangThai == "DA_NHAN")
                                            {
                                                <span class="badge bg-success-subtle text-success border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Đã nhận</span>
                                            }
                                            else if (item.TrangThai == "DA_XUAT")
                                            {
                                                <span class="badge bg-primary-subtle text-primary border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Đang chuyển</span>
                                            }
                                            else if (item.TrangThai == "HUY")
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Đã hủy</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Phiếu tạm</span>
                                            }
                                        </h2>
                                        <div class="meta text-muted small mt-2">
                                            <span>Từ kho: <strong class="text-dark">@item.TenKhoNguon</strong></span>
                                            <span>Tới kho: <strong class="text-dark">@item.TenKhoDich</strong></span>
                                            <span>Người tạo: <strong class="text-dark">@item.TenNguoiLap</strong></span>
                                            <span>Ngày tạo: @item.NgayLap.ToString("dd/MM/yyyy HH:mm")</span>
                                            <i class="br"></i>
                                            <span>Người chuyển: <strong class="text-dark">@(item.TenNguoiXuat ?? "---")</strong></span>
                                            <span>Ngày chuyển: @(item.ThoiDiemXuat?.ToString("dd/MM/yyyy HH:mm") ?? "---")</span>
                                            <span>Người nhận: <strong class="text-dark">@(item.TenNguoiNhan ?? "---")</strong></span>
                                            <span>Ngày nhận: @(item.ThoiDiemNhan?.ToString("dd/MM/yyyy HH:mm") ?? "---")</span>
                                        </div>

                                        <table class="dtl-tbl table table-sm table-bordered mt-3 mb-0" style="background: #fff;">
                                            <thead style="background: #f8fafc;">
                                                <tr>
                                                    <th style="width: 140px; font-weight: 600; font-size: 13px; color: #334155;">Mã hàng</th>
                                                    <th style="font-weight: 600; font-size: 13px; color: #334155;">Tên hàng</th>
                                                    <th style="width: 80px; font-weight: 600; font-size: 13px; color: #334155;">ĐVT</th>
                                                    <th class="r text-end" style="width: 110px; font-weight: 600; font-size: 13px; color: #334155;">SL chuyển</th>
                                                    <th class="r text-end" style="width: 110px; font-weight: 600; font-size: 13px; color: #334155;">SL nhận</th>
                                                    <th class="r text-end" style="width: 120px; font-weight: 600; font-size: 13px; color: #334155;">Giá vốn</th>
                                                    <th class="r text-end" style="width: 130px; font-weight: 600; font-size: 13px; color: #334155;">Thành tiền</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr class="fin">
                                                    <td><input class="form-control form-control-sm dtl-search-code" placeholder="Tìm mã hàng" style="border-radius: 4px; border: 1px solid #d1d5db; height: 28px; font-size: 12.5px;"></td>
                                                    <td><input class="form-control form-control-sm dtl-search-name" placeholder="Tìm tên hàng" style="border-radius: 4px; border: 1px solid #d1d5db; height: 28px; font-size: 12.5px;"></td>
                                                    <td colspan="5" class="bg-transparent border-0"></td>
                                                </tr>
                                            </tbody>
                                            <tbody class="dl">
                                                @if (item.Lines.Any())
                                                {
                                                    foreach (var l in item.Lines)
                                                    {
                                                        <tr class="dtl-line-row" data-hang-id="@l.MaHang" data-code="@l.MaHangNoiBo.ToLower()" data-name="@l.TenHang.ToLower()" data-qty="@l.SoLuong">
                                                            <td><span class="text-break">@l.MaHangNoiBo</span></td>
                                                            <td>@l.TenHang</td>
                                                            <td>@l.TenDvt</td>
                                                            <td class="r text-end">@l.SoLuong.ToString("N0", viCulture)</td>
                                                            <td class="r text-end @(item.TrangThai == "DA_NHAN" && l.SoLuongNhan < l.SoLuong ? "text-danger fw-bold" : "")">
                                                                @(item.TrangThai == "DA_NHAN" ? (l.SoLuongNhan?.ToString("N0", viCulture) ?? "0") : "---")
                                                            </td>
                                                            <td class="r text-end">@l.DonGiaChuyen.ToString("N0", viCulture)</td>
                                                            <td class="r text-end">@l.ThanhTien.ToString("N0", viCulture)</td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr><td colspan="7" class="text-muted text-center py-3">Không có hàng nào trong phiếu.</td></tr>
                                                }
                                            </tbody>
                                        </table>

                                        @if (item.CoNhanThieu)
                                        {
                                            <div class="alert alert-warning py-2 px-3 small mt-3 mb-0 border-warning d-flex align-items-center gap-2 rounded-2">
                                                <i class="bi bi-exclamation-triangle-fill text-warning fs-6"></i>
                                                <div>
                                                    Nhận thiếu <b class="text-danger">@item.ChenhLechThieu.ToString("N0", viCulture)</b> sản phẩm so với số lượng chuyển.
                                                    @if (!string.IsNullOrWhiteSpace(item.GhiChuNhan))
                                                    {
                                                        <span class="ms-1">Lý do: <i>@item.GhiChuNhan</i></span>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (item.TrangThai == "DA_XUAT" && Model.CurrentKhoId != item.MaKhoDich && Model.CurrentKhoId != 0)
                                        {
                                            <div class="alert alert-info py-2 px-3 small mt-3 mb-0 border-info d-flex align-items-center gap-2 rounded-2">
                                                <i class="bi bi-info-circle-fill text-info fs-6"></i>
                                                <div>Phiếu đang chuyển tới <b>@item.TenKhoDich</b>. Chọn kho đó ở góc trên bên phải để nhận hàng.</div>
                                            </div>
                                        }

                                        <!-- Khối Ghi chú + Tổng kết số liệu bên phải -->
                                        <div class="dp-bottom d-flex gap-4 align-items-start mt-3">
                                            <div class="flex-grow-1" style="min-width: 250px;">
                                                <textarea class="form-control dp-note" style="height: 105px; resize: none; border: 1px solid #d1d5db; border-radius: 6px; font-size: 13.5px;" @(item.TrangThai == "HUY" ? "disabled" : "") placeholder="Ghi chú">@item.GhiChu</textarea>
                                            </div>
                                            <div class="sums" style="flex: 0 0 280px; width: 280px;">
                                                <div class="d-flex justify-content-between py-1">
                                                    <span class="text-muted" style="font-size: 13.5px;">Tổng SL chuyển</span>
                                                    <span class="text-dark" style="font-size: 13.5px;">@item.TongSoLuongChuyen.ToString("N0", viCulture)</span>
                                                </div>
                                                @if (item.TrangThai == "DA_NHAN")
                                                {
                                                    <div class="d-flex justify-content-between py-1">
                                                        <span class="text-muted" style="font-size: 13.5px;">Tổng SL nhận</span>
                                                        <span class="text-dark" style="font-size: 13.5px;">@item.TongSoLuongNhan.ToString("N0", viCulture)</span>
                                                    </div>
                                                    @if (item.ChenhLechThieu > 0)
                                                    {
                                                        <div class="d-flex justify-content-between py-1">
                                                            <span class="text-muted" style="font-size: 13.5px;">Chênh lệch thiếu</span>
                                                            <span class="text-danger fw-semibold" style="font-size: 13.5px;">-@item.ChenhLechThieu.ToString("N0", viCulture)</span>
                                                        </div>
                                                    }
                                                }
                                                <div class="d-flex justify-content-between py-1 border-top mt-1 pt-1">
                                                    <span class="text-muted" style="font-size: 13.5px;">Tổng giá trị chuyển</span>
                                                    <span class="text-dark fw-bold" style="font-size: 13.5px;">@item.TongGiaTriChuyen.ToString("N0", viCulture)</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Hàng nút hành động -->
                                        <div class="dp-actions d-flex align-items-center gap-2 mt-3 pt-3 border-top">
                                            @if (item.TrangThai == "NHAP")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-cancel-doc btn-cancel-transfer" data-id="@item.MaPhieuChuyen" data-code="@item.MaPhieuHienThi" data-status="NHAP">
                                                    <i class="bi bi-trash me-1"></i>Hủy
                                                </button>
                                            }
                                            else if (item.TrangThai == "DA_XUAT")
                                            {
                                                bool canCancelSent = Model.CurrentKhoId == item.MaKhoNguon || Model.CurrentKhoId == 0;
                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-cancel-doc btn-cancel-transfer" data-id="@item.MaPhieuChuyen" data-code="@item.MaPhieuHienThi" data-status="DA_XUAT" @(!canCancelSent ? "disabled title=\"Chỉ kho gửi mới có quyền hủy chuyển để thu hồi hàng\"" : "")>
                                                    <i class="bi bi-x-circle me-1"></i>Hủy chuyển
                                                </button>
                                            }
                                            <a href="@Url.Action("Create", "ChuyenKho", new { copyId = item.MaPhieuChuyen })" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-copy me-1"></i>Sao chép
                                            </a>
                                            <a href="@Url.Action("Export", "ChuyenKho", new { type = "detail", id = item.MaPhieuChuyen })" class="btn btn-sm btn-outline-secondary" target="_blank">
                                                <i class="bi bi-box-arrow-up me-1"></i>Xuất file
                                            </a>
                                            <span class="ms-auto"></span>
                                            @if (item.TrangThai != "HUY")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-save-note" data-id="@item.MaPhieuChuyen">
                                                    <i class="bi bi-floppy me-1"></i>Lưu
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print();">
                                                <i class="bi bi-printer me-1"></i>In
                                            </button>
                                            @if (item.TrangThai == "NHAP")
                                            {
                                                bool canSend = Model.CurrentKhoId == item.MaKhoNguon || Model.CurrentKhoId == 0;
                                                <a href="@Url.Action("Edit", "ChuyenKho", new { id = item.MaPhieuChuyen })" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil-square me-1"></i>Mở phiếu
                                                </a>
                                                <button type="button" class="btn btn-sm btn-primary btn-send-transfer" data-id="@item.MaPhieuChuyen" data-code="@item.MaPhieuHienThi" @(!canSend ? "disabled title=\"Chỉ kho gửi mới chuyển hàng được\"" : "")>
                                                    <i class="bi bi-truck me-1"></i>Chuyển hàng
                                                </button>
                                            }
                                            else if (item.TrangThai == "DA_XUAT")
                                            {
                                                bool canRecv = Model.CurrentKhoId == item.MaKhoDich || Model.CurrentKhoId == 0;
                                                <button type="button" class="btn btn-sm btn-success btn-open-receive" data-id="@item.MaPhieuChuyen" data-code="@item.MaPhieuHienThi" data-from="@item.TenKhoNguon" @(!canRecv ? "disabled title=\"Chọn kho nhận ở góc trên để nhận hàng\"" : "")>
                                                    <i class="bi bi-box-arrow-in-down me-1"></i>Nhận hàng
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Phân trang đáy bảng dùng chung component _Pagination.cshtml của hệ thống -->
@await Html.PartialAsync("_Pagination", Model.PagedData, new ViewDataDictionary(ViewData) { { "ItemLabel", "phiếu chuyển" } })
