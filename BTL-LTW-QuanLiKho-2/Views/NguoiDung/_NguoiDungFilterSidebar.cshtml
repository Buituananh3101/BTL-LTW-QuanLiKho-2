@model BTL_LTW_QuanLiKho_2.ViewModels.NguoiDung.NguoiDungIndexVM
@using BTL_LTW_QuanLiKho_2.ViewModels.Common

<!-- CỘT BÊN TRÁI: TIÊU ĐỀ "NGƯỜI DÙNG" + BỘ LỌC LEGO chuẩn chuyên nghiệp -->
<aside class="kp-sidebar-col" id="sidebarFilterCol">
    <!-- Header cho sidebar khi mở ở chế độ mobile / zoom in -->
    <div class="kp-sidebar-mobile-header d-lg-none d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
        <div class="fw-bold fs-6 text-dark"><i class="bi bi-funnel me-1 text-primary"></i> Bộ lọc người dùng</div>
        <button type="button" class="btn-close" id="btnCloseSidebarMobile" aria-label="Đóng"></button>
    </div>

    <div class="kp-sidebar-title d-none d-lg-flex">
        Người dùng
    </div>

    <div class="kp-filter-box">
        <!-- 1. Vai trò người dùng -->
        <partial name="_MultiSelectFilter" model='new MultiSelectVM("VaiTro", "vaitro", "Vai trò", "Chọn vai trò", false) {
            Items = Model.VaiTroList.Select(v => new MultiSelectItemVM(v.MaVaiTro.ToString(), v.TenVaiTro)).ToList()
        }' />

        <!-- 2. Chi nhánh kho làm việc -->
        <partial name="_MultiSelectFilter" model='new MultiSelectVM("Kho", "kho", "Kho làm việc", "Chọn chi nhánh kho", true) {
            Items = Model.KhoList.Select(k => new MultiSelectItemVM(k.MaKho.ToString(), k.TenKho)).ToList()
        }' />

        <!-- 3. Trạng thái tài khoản -->
        <partial name="_StatusFilter" model='new StatusFilterVM("Trạng thái", "dotTrangThai", new List<StatusOptionVM> {
            new("HOAT_DONG", "Đang hoạt động", true),
            new("KHOA", "Đang bị khóa")
        })' />
    </div>
</aside>
