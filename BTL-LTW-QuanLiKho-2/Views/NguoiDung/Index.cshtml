@model BTL_LTW_QuanLiKho_2.ViewModels.NguoiDung.NguoiDungIndexVM
@{
    ViewData["Title"] = "Quản lý Người dùng & Phân quyền";
}

<link rel="stylesheet" href="~/css/hang-hoa-form.css" asp-append-version="true" />
<style>
    .user-kho-ms-item.selected {
        background-color: #eff6ff;
    }
    .user-kho-ms-item:hover {
        background-color: #f1f5f9;
    }
    .user-kho-select-box {
        min-height: 40px;
        border-color: #d1d5db;
        border-radius: 8px;
    }
    .user-kho-ms-item .badge {
        flex: 0 0 auto !important;
        width: auto !important;
        margin-left: auto !important;
        white-space: nowrap !important;
    }
    #userModalOv,
    #pwdModalOv {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 20px !important;
    }
    #userModalOv .hh-modal,
    #pwdModalOv .hh-modal {
        margin: auto !important;
    }
</style>

<div class="kp-container position-relative" id="kpContainer" data-sort-by="@Model.SortBy" data-sort-dir="@Model.SortDir">
    <!-- 1. CỘT BÊN TRÁI: TIÊU ĐỀ + BỘ LỌC LEGO chuẩn chuyên nghiệp -->
    <partial name="_NguoiDungFilterSidebar" model="Model" />

    <!-- Backdrop che mờ khi mở bộ lọc trên mobile/zoom in -->
    <div class="kp-sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Nút tròn thu gọn / mở rộng ở ranh giới giữa sidebar và bảng (Phím tắt F4) -->
    <button type="button" class="kp-sidebar-toggle-btn d-none d-lg-flex" id="btnToggleSidebar" title="Thu gọn bộ lọc (F4)">
        <i class="bi bi-chevron-left" id="sidebarToggleIcon"></i>
    </button>

    <!-- 2. CỘT BÊN PHẢI: TOOLBAR + BẢNG DỮ LIỆU NGƯỜI DÙNG -->
    <main class="kp-main-col">
        <!-- Toolbar trên cùng: Thanh tìm kiếm thẳng hàng với bảng bên dưới -->
        <div class="kp-toolbar-row">
            <!-- Tiêu đề + Nút phễu bộ lọc trên mobile -->
            <div class="kp-mobile-title-wrap d-lg-none d-flex align-items-center gap-2">
                <span class="kp-mobile-title fw-bold fs-6 text-dark">Người dùng</span>
                <button type="button" class="btn btn-sm btn-outline-primary kp-btn-funnel" id="btnMobileFilter" title="Mở bộ lọc">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>

            <!-- Ô tìm kiếm nhanh F3 -->
            <div class="kp-search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="keywordSearch" class="form-control" placeholder="Theo tên đăng nhập, tên nhân viên, điện thoại (F3)" value="@Model.Filter.Q" autocomplete="off" />
            </div>

            <!-- Nhóm nút hành động chuyên nghiệp -->
            <div class="kp-actions-group">
                <!-- Nút + Người dùng -->
                <button type="button" class="btn btn-primary d-inline-flex align-items-center" id="btnOpenCreateUserModal" title="Thêm mới người dùng & phân quyền">
                    <i class="bi bi-plus-lg me-1"></i><span>Người dùng</span>
                </button>

                <!-- Nút tải lại bảng -->
                <button type="button" class="btn btn-tool" title="Tải lại bảng" id="btnReloadTable">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>

                <!-- Trợ giúp (F1) -->
                <button type="button" class="btn btn-tool btn-help" id="btnHelp" title="Hướng dẫn sử dụng (F1)">
                    <i class="bi bi-question-circle"></i>
                </button>
            </div>
        </div>

        <!-- Bảng danh sách người dùng nạp AJAX -->
        <section id="content">
            <div id="userTableContainer">
                <partial name="_NguoiDungTable" model="Model.PagedData" />
            </div>
        </section>
    </main>
</div>

<!-- ========================================================================
     CÁC MODAL THÊM/SỬA NGƯỜI DÙNG VÀ ĐỔI MẬT KHẨU
     ======================================================================== -->
<partial name="_NguoiDungModal" model="Model" />
<partial name="_DoiMatKhauModal" />

@section Scripts {
    <script src="~/js/app-filter.js" asp-append-version="true"></script>
    <script src="~/js/nguoi-dung-index.js" asp-append-version="true"></script>
}
