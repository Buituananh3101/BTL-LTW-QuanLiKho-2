@model BTL_LTW_QuanLiKho_2.ViewModels.NhapHang.NhapHangIndexVM
@using System.Globalization
@{
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
}

<div class="kiot-table-scroll-body">
    <table class="tbl" id="receiptTable">
        <thead>
            <tr>
                <th style="width: 36px;" class="text-center th-checkbox">
                    <input class="form-check-input" type="checkbox" id="chkAll" @(!Model.PagedData.Items.Any() ? "disabled" : "") />
                </th>
                <th style="width: 36px; cursor: pointer;" class="text-center th-star" onclick="toggleStarHeaderFilter(event)">
                    <span class="star-btn star-header-filter @(Model.DaDanhDauFilter ? "starred" : "")" id="starHeaderFilter" title="@(Model.DaDanhDauFilter ? "Bỏ lọc sao (Hiển thị tất cả)" : "Lọc danh sách phiếu được đánh dấu sao")">
                        <i class="bi @(Model.DaDanhDauFilter ? "bi-star-fill" : "bi-star")"></i>
                    </span>
                </th>
                <th data-col="ma" style="width: 140px;" class="sortable-th @(Model.SortBy == "ma" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Mã nhập hàng">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Mã nhập hàng</span>
                            @if (Model.SortBy == "ma" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "ma" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tg" style="width: 150px;" class="sortable-th @(Model.SortBy == "tg" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Thời gian">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Thời gian</span>
                            @if (Model.SortBy == "tg" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "tg" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="mancc" style="width: 130px;" class="sortable-th @(Model.SortBy == "ncc" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Nhà cung cấp">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Mã nhà CC</span>
                        </span>
                    </div>
                </th>
                <th data-col="ncc" style="width: 250px;" class="sortable-th @(Model.SortBy == "ncc" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Nhà cung cấp">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Nhà cung cấp</span>
                            @if (Model.SortBy == "ncc" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "ncc" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="cantra" style="width: 140px;" class="num r text-end sortable-th @(Model.SortBy == "cantra" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Cần trả NCC">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Cần trả NCC</span>
                            @if (Model.SortBy == "cantra" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "cantra" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="st" style="width: 140px;" class="sortable-th @(Model.SortBy == "st" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Trạng thái">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Trạng thái</span>
                            @if (Model.SortBy == "st" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "st" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PagedData.Items.Any())
            {
                <tr class="summary-row" style="background-color: #f8fafc; font-weight: 600;">
                    <td class="w-chk"></td>
                    <td class="w-star"></td>
                    <td data-col="ma"></td>
                    <td data-col="tg"></td>
                    <td data-col="mancc"></td>
                    <td data-col="ncc" class="text-end text-muted small">Tổng trang:</td>
                    <td data-col="cantra" class="num r text-end text-primary fw-bold">@Model.PagedData.Items.Sum(p => p.CanTraNcc).ToString("N0", viCulture)</td>
                    <td data-col="st"></td>
                </tr>
            }

            @if (!Model.PagedData.Items.Any())
            {
                <tr>
                    <td colspan="8" class="p-0">
                        <div class="empty d-block py-5 text-center">
                            <div class="ico mb-3"><i class="bi bi-inbox fs-1 text-primary"></i></div>
                            <h5 class="fw-bold">Không tìm thấy phiếu nhập hàng</h5>
                            <p class="text-muted mb-0 small">Không tìm thấy giao dịch nào phù hợp với bộ lọc hiện tại.<br />Nhấn <a href="javascript:void(0)" id="resetF" class="text-primary text-decoration-none fw-semibold">vào đây</a> để xóa bộ lọc và tiếp tục tìm kiếm.</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.PagedData.Items)
                {
                    <tr class="product-row tbl-row" data-id="@item.MaPhieuNhap" title="Nhấn để xem chi tiết phiếu nhập">
                        <td class="w-chk text-center cell-checkbox" onclick="event.stopPropagation();">
                            <input class="form-check-input row-select" type="checkbox" data-sel="@item.MaPhieuNhap" value="@item.MaPhieuNhap">
                        </td>
                        <td class="w-star text-center cell-star" style="cursor: pointer;" onclick="toggleFavoriteReceipt(event, @item.MaPhieuNhap, this)">
                            <span class="star-btn @(item.DaDanhDau ? "starred" : "")" data-id="@item.MaPhieuNhap" title="@(item.DaDanhDau ? "Bỏ đánh dấu sao" : "Đánh dấu sao")">
                                <i class="bi @(item.DaDanhDau ? "bi-star-fill" : "bi-star")"></i>
                            </span>
                        </td>
                        <td data-col="ma"><span class="text-primary fw-medium">@item.MaPhieuHienThi</span></td>
                        <td data-col="tg">@item.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-col="mancc">@(item.MaNcc ?? (!string.IsNullOrEmpty(item.TenNcc) ? ("NCC" + (item.MaDonViCapHang?.ToString("D5") ?? "")) : "---"))</td>
                        <td data-col="ncc" class="text-truncate" style="max-width: 250px;" title="@item.TenNcc">@(item.TenNcc ?? "---")</td>
                        <td data-col="cantra" class="num r text-end fw-semibold">@item.CanTraNcc.ToString("N0", viCulture)</td>
                        <td data-col="st">
                            <span class="@item.BadgeClass">@item.TenTrangThai</span>
                        </td>
                    </tr>

                    <!-- Khối chi tiết bung ra (Inline Drawer / Accordion) -->
                    <tr class="product-detail-row dtl" id="dtl-@item.MaPhieuNhap" style="display: none;">
                        <td colspan="8" class="p-0 border-0">
                            <div class="product-detail-panel-wrap" style="display: none;">
                                <div class="product-detail-panel dp shadow-sm receipt-detail-fixed-wrap" data-d="@item.MaPhieuNhap">
                                    <div class="dp-tabs">
                                        <button type="button" class="dp-tab active" data-tab="info">Thông tin</button>
                                    </div>
                                    <h2 class="d-flex align-items-center gap-2 mt-2">
                                        <span class="fw-bold" style="font-size: 18px; color: #1e293b;">@item.MaPhieuHienThi</span>
                                        <span class="@item.BadgeClass">@item.TenTrangThai</span>
                                    </h2>

                                    <!-- 3 Cột thuộc tính phiếu nhập -->
                                    <div class="receipt-attr-grid mt-3">
                                        <div class="receipt-attr-col">
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span class="text-muted small">Mã nhà cung cấp:</span>
                                                <span class="fw-medium small">@(item.MaNcc ?? "---")</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span class="text-muted small">Nhà cung cấp:</span>
                                                <span class="fw-semibold text-primary small text-truncate" style="max-width: 190px;" title="@item.TenNcc">@(item.TenNcc ?? "---")</span>
                                            </div>
                                        </div>
                                        <div class="receipt-attr-col">
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span class="text-muted small">Người tạo:</span>
                                                <span class="fw-medium small">@item.TenNguoiLap</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span class="text-muted small">Ngày tạo:</span>
                                                <span class="fw-medium small">@item.NgayLap.ToString("dd/MM/yyyy HH:mm")</span>
                                            </div>
                                        </div>
                                        <div class="receipt-attr-col">
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span class="text-muted small">Kho nhập:</span>
                                                <span class="fw-medium small">@item.TenKho</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span class="text-muted small">Số hóa đơn:</span>
                                                <span class="fw-medium small">@(item.SoHoaDon ?? "---")</span>
                                            </div>
                                            @if (item.NgayXacNhan.HasValue)
                                            {
                                                <div class="d-flex justify-content-between py-1 border-bottom">
                                                    <span class="text-muted small">Ngày nhập:</span>
                                                    <span class="fw-medium small">@item.NgayXacNhan.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Bảng các mặt hàng nhập -->
                                    <table class="dtl-tbl table table-sm table-bordered mt-3 mb-0" style="background: #fff;">
                                        <thead style="background: #f8fafc;">
                                            <tr>
                                                <th style="width: 140px; font-weight: 600; font-size: 13px; color: #334155;">Mã hàng</th>
                                                <th style="font-weight: 600; font-size: 13px; color: #334155;">Tên hàng</th>
                                                <th class="r text-end" style="width: 100px; font-weight: 600; font-size: 13px; color: #334155;">Số lượng</th>
                                                <th class="r text-end" style="width: 120px; font-weight: 600; font-size: 13px; color: #334155;">Đơn giá</th>
                                                <th class="r text-end" style="width: 110px; font-weight: 600; font-size: 13px; color: #334155;">Giảm giá</th>
                                                <th class="r text-end" style="width: 130px; font-weight: 600; font-size: 13px; color: #334155;">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody class="dl">
                                            @if (item.Lines.Any())
                                            {
                                                foreach (var l in item.Lines)
                                                {
                                                    <tr class="dtl-line-row">
                                                        <td><span class="text-break fw-medium">@l.MaHangNoiBo</span></td>
                                                        <td>@l.TenHang</td>
                                                        <td class="r text-end">@l.SoLuong.ToString("N0", viCulture) @l.TenDvt</td>
                                                        <td class="r text-end">@l.DonGiaNhap.ToString("N0", viCulture)</td>
                                                        <td class="r text-end">@l.GiamGia.ToString("N0", viCulture)</td>
                                                        <td class="r text-end fw-semibold">@l.ThanhTien.ToString("N0", viCulture)</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="6" class="text-muted text-center py-3">Không có hàng nào trong phiếu.</td></tr>
                                            }
                                        </tbody>
                                    </table>

                                    <!-- Khối Ghi chú + Tổng kết số liệu bên phải -->
                                    <div class="dp-bottom d-flex gap-4 align-items-start mt-3">
                                        <div class="flex-grow-1" style="min-width: 250px;">
                                            <textarea class="form-control dp-note" style="height: 105px; resize: none; border: 1px solid #d1d5db; border-radius: 6px; font-size: 13.5px;" @(item.TrangThai == "HUY" || item.TrangThai == "DA_HUY" ? "disabled" : "") placeholder="Ghi chú">@item.GhiChu</textarea>
                                        </div>
                                        <div class="sums" style="flex: 0 0 280px; width: 280px;">
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="text-muted" style="font-size: 13.5px;">Tổng số lượng:</span>
                                                <span class="text-dark fw-medium" style="font-size: 13.5px;">@item.TongSoLuong.ToString("N0", viCulture)</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="text-muted" style="font-size: 13.5px;">Tổng tiền hàng:</span>
                                                <span class="text-dark fw-medium" style="font-size: 13.5px;">@item.TongTien.ToString("N0", viCulture)</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="text-muted" style="font-size: 13.5px;">Giảm giá phiếu nhập:</span>
                                                <span class="text-dark fw-medium" style="font-size: 13.5px;">@item.GiamGia.ToString("N0", viCulture)</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 border-top pt-2">
                                                <span class="fw-bold" style="font-size: 14px; color: #0f172a;">Cần trả NCC:</span>
                                                <span class="fw-bold text-primary" style="font-size: 15px;">@item.CanTraNcc.ToString("N0", viCulture)</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Hàng nút hành động -->
                                    <div class="dp-actions d-flex align-items-center gap-2 mt-3 pt-3 border-top">
                                        @if (item.TrangThai != "HUY" && item.TrangThai != "DA_HUY")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-cancel-doc" data-id="@item.MaPhieuNhap" data-code="@item.MaPhieuHienThi" data-status="@item.TrangThai">
                                                <i class="bi bi-trash me-1"></i>Hủy
                                            </button>
                                        }
                                        <a href="@Url.Action("Create", "NhapHang", new { copyId = item.MaPhieuNhap })" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-copy me-1"></i>Sao chép
                                        </a>
                                        <a href="@Url.Action("Export", "NhapHang", new { type = "detail", id = item.MaPhieuNhap })" class="btn btn-sm btn-outline-secondary" target="_blank">
                                            <i class="bi bi-box-arrow-up me-1"></i>Xuất file
                                        </a>
                                        <span class="ms-auto"></span>
                                        @if (item.TrangThai != "HUY" && item.TrangThai != "DA_HUY")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-save-note" data-id="@item.MaPhieuNhap">
                                                <i class="bi bi-floppy me-1"></i>Lưu
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print();">
                                            <i class="bi bi-printer me-1"></i>In
                                        </button>
                                        @if (item.TrangThai == "NHAP" || item.TrangThai == "PHIEU_TAM")
                                        {
                                            <a href="@Url.Action("Edit", "NhapHang", new { id = item.MaPhieuNhap })" class="btn btn-sm btn-primary">
                                                <i class="bi bi-pencil-square me-1"></i>Mở phiếu
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Details", "NhapHang", new { id = item.MaPhieuNhap })" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye me-1"></i>Chi tiết
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Phân trang đáy bảng dùng chung component _Pagination.cshtml -->
@await Html.PartialAsync("_Pagination", Model.PagedData, new ViewDataDictionary(ViewData) { { "ItemLabel", "phiếu nhập" } })
