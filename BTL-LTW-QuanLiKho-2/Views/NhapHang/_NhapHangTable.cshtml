@model BTL_LTW_QuanLiKho_2.ViewModels.NhapHang.NhapHangIndexVM
@using System.Globalization
@{
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
}

<div class="kiot-table-scroll-body">
    <table class="tbl" id="receiptTable" style="width: max-content; min-width: 760px;">
        <thead>
            <tr>
                <th style="width: 36px; min-width: 36px;" class="text-center th-checkbox">
                    <input class="form-check-input" type="checkbox" id="selectAllRows" @(!Model.PagedData.Items.Any() ? "disabled" : "") />
                </th>
                <th style="width: 36px; min-width: 36px; cursor: pointer;" class="text-center th-star" onclick="toggleStarHeaderFilter(event)">
                    <span class="star-btn star-header-filter @(Model.DaDanhDauFilter ? "starred" : "")" id="starHeaderFilter" title="@(Model.DaDanhDauFilter ? "Bỏ lọc sao (Hiển thị tất cả)" : "Lọc danh sách phiếu được đánh dấu sao")">
                        <i class="bi @(Model.DaDanhDauFilter ? "bi-star-fill" : "bi-star")"></i>
                    </span>
                </th>
                <th data-col="ma" style="width: 140px; min-width: 140px;" class="sortable-th @(Model.SortBy == "ma" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Mã nhập hàng">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Mã nhập hàng</span>
                            @if (Model.SortBy == "ma" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "ma" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="matra" style="width: 145px; min-width: 145px;" class="sortable-th @(Model.SortBy == "matra" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Mã trả hàng nhập">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Mã trả hàng nhập</span>
                            @if (Model.SortBy == "matra" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "matra" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tg" style="width: 150px; min-width: 150px;" class="sortable-th @(Model.SortBy == "tg" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Thời gian">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Thời gian</span>
                            @if (Model.SortBy == "tg" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "tg" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tgtao" style="width: 150px; min-width: 150px;" class="sortable-th @(Model.SortBy == "tgtao" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Thời gian tạo">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Thời gian tạo</span>
                            @if (Model.SortBy == "tgtao" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "tgtao" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="ngaycapnhat" style="width: 150px; min-width: 150px;" class="sortable-th @(Model.SortBy == "ngaycapnhat" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Ngày cập nhật">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Ngày cập nhật</span>
                            @if (Model.SortBy == "ngaycapnhat" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "ngaycapnhat" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="mancc" style="width: 130px; min-width: 130px;" class="sortable-th @(Model.SortBy == "mancc" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Mã NCC">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Mã NCC</span>
                            @if (Model.SortBy == "mancc" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "mancc" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="ncc" style="width: 250px; min-width: 250px;" class="col-product-name sortable-th @(Model.SortBy == "ncc" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Nhà cung cấp">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Nhà cung cấp</span>
                            @if (Model.SortBy == "ncc" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "ncc" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="chinhanh" style="width: 140px; min-width: 140px;" class="sortable-th @(Model.SortBy == "chinhanh" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Chi nhánh">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Chi nhánh</span>
                            @if (Model.SortBy == "chinhanh" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "chinhanh" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="nguoinhap" style="width: 140px; min-width: 140px;" class="sortable-th @(Model.SortBy == "nguoinhap" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Người nhập">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Người nhập</span>
                            @if (Model.SortBy == "nguoinhap" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "nguoinhap" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="nguoitao" style="width: 140px; min-width: 140px;" class="sortable-th @(Model.SortBy == "nguoitao" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Người tạo">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Người tạo</span>
                            @if (Model.SortBy == "nguoitao" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "nguoitao" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tongsl" style="width: 120px; min-width: 120px;" class="num sortable-th @(Model.SortBy == "tongsl" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Tổng số lượng">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Tổng số lượng</span>
                            @if (Model.SortBy == "tongsl" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "tongsl" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="slmathang" style="width: 130px; min-width: 130px;" class="num sortable-th @(Model.SortBy == "slmathang" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Số lượng mặt hàng">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">SL mặt hàng</span>
                            @if (Model.SortBy == "slmathang" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "slmathang" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tongtien" style="width: 140px; min-width: 140px;" class="num sortable-th @(Model.SortBy == "tongtien" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Tổng tiền hàng">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Tổng tiền hàng</span>
                            @if (Model.SortBy == "tongtien" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "tongtien" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="giamgia" style="width: 120px; min-width: 120px;" class="num sortable-th @(Model.SortBy == "giamgia" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Giảm giá">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Giảm giá</span>
                            @if (Model.SortBy == "giamgia" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "giamgia" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="cantra" style="width: 140px; min-width: 140px;" class="num sortable-th @(Model.SortBy == "cantra" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Cần trả NCC">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Cần trả NCC</span>
                            @if (Model.SortBy == "cantra" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "cantra" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="chietkhautt" style="width: 140px; min-width: 140px;" class="num" title="Chiết khấu thanh toán">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">CK thanh toán</span>
                        </span>
                    </div>
                </th>
                <th data-col="tiendatra" style="width: 140px; min-width: 140px;" class="num" title="Tiền đã trả NCC">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Tiền đã trả NCC</span>
                        </span>
                    </div>
                </th>
                <th data-col="ghi" style="width: 180px; min-width: 180px;">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Ghi chú</span>
                        </span>
                    </div>
                </th>
                <th data-col="st" style="width: 135px; min-width: 135px;" class="text-center sortable-th @(Model.SortBy == "st" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Trạng thái">
                    <div class="th-content justify-content-center">
                        <span class="th-title-wrap">
                            <span class="th-text">Trạng thái</span>
                            @if (Model.SortBy == "st" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "st" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="sohoadon" style="width: 140px; min-width: 140px;" class="sortable-th @(Model.SortBy == "sohoadon" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Số hóa đơn đầu vào">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Số HĐ đầu vào</span>
                            @if (Model.SortBy == "sohoadon" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "sohoadon" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.PagedData.Items.Any())
            {
                <tr class="empty-row">
                    <td colspan="22" class="p-0">
                        <div class="empty d-block py-5 text-center">
                            <div class="ico mb-3"><i class="bi bi-inbox fs-1 text-primary"></i></div>
                            <h5 class="fw-bold">Không tìm thấy phiếu nhập hàng</h5>
                            <p class="text-muted mb-0 small">Không tìm thấy giao dịch nào phù hợp với bộ lọc hiện tại.<br />Nhấn <a href="javascript:void(0)" id="resetF" class="text-primary text-decoration-none fw-semibold">vào đây</a> để xóa bộ lọc và tiếp tục tìm kiếm.</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.PagedData.Items)
                {
                    <tr class="product-row tbl-row" data-id="@item.MaPhieuNhap" title="Nhấn để xem chi tiết phiếu nhập">
                        <td class="text-center cell-checkbox" onclick="event.stopPropagation();">
                            <input class="form-check-input row-select" type="checkbox" value="@item.MaPhieuNhap" />
                        </td>
                        <td class="text-center cell-star" style="cursor: pointer;" onclick="toggleFavoriteReceipt(event, @item.MaPhieuNhap, this)">
                            <span class="star-btn @(item.DaDanhDau ? "starred" : "")" data-id="@item.MaPhieuNhap" title="@(item.DaDanhDau ? "Bỏ đánh dấu sao" : "Đánh dấu sao")">
                                <i class="bi @(item.DaDanhDau ? "bi-star-fill" : "bi-star")"></i>
                            </span>
                        </td>
                        <td data-col="ma">
                            <span class="text-break">@item.MaPhieuHienThi</span>
                        </td>
                        <td data-col="matra">
                            @(item.MaDatHangNhap ?? "---")
                        </td>
                        <td data-col="tg">
                            @item.NgayLap.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td data-col="tgtao">
                            @item.NgayLap.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td data-col="ngaycapnhat">
                            @((item.NgayXacNhan ?? item.NgayLap).ToString("dd/MM/yyyy HH:mm"))
                        </td>
                        <td data-col="mancc">
                            @(item.MaNcc ?? (!string.IsNullOrEmpty(item.TenNcc) ? ("NCC" + (item.MaDonViCapHang?.ToString("D5") ?? "")) : "---"))
                        </td>
                        <td data-col="ncc" class="cell-product-name">
                            <div class="product-name-text">@(item.TenNcc ?? "---")</div>
                        </td>
                        <td data-col="chinhanh">
                            @item.TenKho
                        </td>
                        <td data-col="nguoinhap">
                            @(item.TenNguoiXacNhan ?? "---")
                        </td>
                        <td data-col="nguoitao">
                            @item.TenNguoiLap
                        </td>
                        <td data-col="tongsl" class="num">
                            @item.TongSoLuong.ToString("N0", viCulture)
                        </td>
                        <td data-col="slmathang" class="num">
                            @item.Lines.Count.ToString("N0", viCulture)
                        </td>
                        <td data-col="tongtien" class="num text-dark">
                            @item.TongTien.ToString("N0", viCulture)
                        </td>
                        <td data-col="giamgia" class="num text-muted">
                            @item.GiamGia.ToString("N0", viCulture)
                        </td>
                        <td data-col="cantra" class="num fw-bold text-dark">
                            @item.CanTraNcc.ToString("N0", viCulture)
                        </td>
                        <td data-col="chietkhautt" class="num text-muted">0</td>
                        <td data-col="tiendatra" class="num text-dark">
                            @((item.TrangThai == "DA_XAC_NHAN" || item.TrangThai == "HOAN_THANH" ? item.CanTraNcc : 0).ToString("N0", viCulture))
                        </td>
                        <td data-col="ghi" class="text-truncate" style="max-width: 180px;" title="@item.GhiChu">
                            @(string.IsNullOrWhiteSpace(item.GhiChu) ? "---" : item.GhiChu)
                        </td>
                        <td data-col="st" class="text-center">
                            <span class="@item.BadgeClass">@item.TenTrangThai</span>
                        </td>
                        <td data-col="sohoadon">
                            @(string.IsNullOrWhiteSpace(item.SoHoaDon) ? "---" : item.SoHoaDon)
                        </td>
                    </tr>

                    <!-- Khối chi tiết bung ra (Inline Drawer / Accordion chuẩn KiotViet) -->
                    <tr class="product-detail-row dtl" id="dtl-@item.MaPhieuNhap" style="display: none;">
                        <td colspan="22" class="p-0">
                            <div class="product-detail-panel-wrap" style="display: none;">
                                <div class="product-detail-panel dp shadow-sm" data-d="@item.MaPhieuNhap">
                                    <div class="dp-tabs"><button type="button" class="dp-tab active" data-tab="info">Thông tin</button></div>
                                    <div class="kk-detail-fixed-wrap kiot-detail-fixed-wrap">
                                        <h2 class="d-flex align-items-center gap-2">
                                            <span class="fw-bold" style="font-size: 18px; color: #1e293b;">@item.MaPhieuHienThi</span>
                                            @if (item.TrangThai == "DA_XAC_NHAN" || item.TrangThai == "HOAN_THANH")
                                            {
                                                <span class="badge bg-success-subtle text-success border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Đã nhập hàng</span>
                                            }
                                            else if (item.TrangThai == "HUY" || item.TrangThai == "DA_HUY")
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Đã hủy</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary-subtle text-primary border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Phiếu tạm</span>
                                            }
                                        </h2>
                                        <div class="meta text-muted small mt-2">
                                            <span>Mã NCC: <strong class="text-dark">@(item.MaNcc ?? (!string.IsNullOrEmpty(item.TenNcc) ? ("NCC" + (item.MaDonViCapHang?.ToString("D5") ?? "")) : "---"))</strong></span>
                                            <span>Nhà cung cấp: <strong class="text-primary">@(item.TenNcc ?? "---")</strong></span>
                                            <span>Người tạo: <strong class="text-dark">@item.TenNguoiLap</strong></span>
                                            <span>Ngày tạo: @item.NgayLap.ToString("dd/MM/yyyy HH:mm")</span>
                                            <span>Kho nhập: <strong class="text-dark">@item.TenKho</strong></span>
                                            @if (!string.IsNullOrWhiteSpace(item.SoHoaDon))
                                            {
                                                <span>Số HĐ: <strong class="text-dark">@item.SoHoaDon</strong></span>
                                            }
                                            @if (item.NgayXacNhan.HasValue)
                                            {
                                                <i class="br"></i>
                                                <span>Người nhập: <strong class="text-dark">@(item.TenNguoiXacNhan ?? item.TenNguoiLap)</strong></span>
                                                <span>Ngày nhập: @item.NgayXacNhan.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                            }
                                        </div>

                                        <!-- Bảng các mặt hàng nhập -->
                                        <table class="dtl-tbl table table-sm table-bordered mt-3 mb-0" style="background: #fff;">
                                            <thead style="background: #f8fafc;">
                                                <tr>
                                                    <th style="width: 160px; font-weight: 600; font-size: 13px; color: #334155;">Mã hàng</th>
                                                    <th style="font-weight: 600; font-size: 13px; color: #334155;">Tên hàng</th>
                                                    <th class="num text-end" style="width: 120px; font-weight: 600; font-size: 13px; color: #334155;">Số lượng</th>
                                                    <th class="num text-end" style="width: 125px; font-weight: 600; font-size: 13px; color: #334155;">Đơn giá</th>
                                                    <th class="num text-end" style="width: 110px; font-weight: 600; font-size: 13px; color: #334155;">Giảm giá</th>
                                                    <th class="num text-end" style="width: 135px; font-weight: 600; font-size: 13px; color: #334155;">Thành tiền</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr class="fin">
                                                    <td><input class="form-control form-control-sm dtl-search-code" placeholder="Tìm mã hàng" style="border-radius: 4px; border: 1px solid #d1d5db; height: 28px; font-size: 12.5px;"></td>
                                                    <td><input class="form-control form-control-sm dtl-search-name" placeholder="Tìm tên hàng" style="border-radius: 4px; border: 1px solid #d1d5db; height: 28px; font-size: 12.5px;"></td>
                                                    <td colspan="4" class="bg-transparent border-0"></td>
                                                </tr>
                                            </tbody>
                                            <tbody class="dl">
                                                @if (item.Lines.Any())
                                                {
                                                    foreach (var l in item.Lines)
                                                    {
                                                        <tr class="dtl-line-row" data-code="@l.MaHangNoiBo.ToLower()" data-name="@l.TenHang.ToLower()">
                                                            <td><span class="text-break fw-medium text-primary">@l.MaHangNoiBo</span></td>
                                                            <td>@l.TenHang</td>
                                                            <td class="num text-end">@l.SoLuong.ToString("N0", viCulture) @l.TenDvt</td>
                                                            <td class="num text-end">@l.DonGiaNhap.ToString("N0", viCulture)</td>
                                                            <td class="num text-end">@l.GiamGia.ToString("N0", viCulture)</td>
                                                            <td class="num text-end fw-semibold text-dark">@l.ThanhTien.ToString("N0", viCulture)</td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr><td colspan="6" class="text-muted text-center py-3">Không có hàng nào trong phiếu.</td></tr>
                                                }
                                            </tbody>
                                        </table>

                                        <!-- Khối Ghi chú + Tổng kết số liệu bên phải -->
                                        <div class="dp-bottom d-flex gap-4 align-items-start mt-3">
                                            <div class="flex-grow-1" style="min-width: 250px;">
                                                <textarea class="form-control dp-note" style="height: 105px; resize: none; border: 1px solid #d1d5db; border-radius: 6px; font-size: 13.5px;" @(item.TrangThai == "HUY" || item.TrangThai == "DA_HUY" ? "disabled" : "") placeholder="Ghi chú">@item.GhiChu</textarea>
                                            </div>
                                            <div class="sums" style="flex: 0 0 280px; width: 280px;">
                                                <div class="d-flex justify-content-between py-1">
                                                    <span class="text-muted" style="font-size: 13.5px;">Tổng số lượng:</span>
                                                    <span class="text-dark fw-medium" style="font-size: 13.5px;">@item.TongSoLuong.ToString("N0", viCulture)</span>
                                                </div>
                                                <div class="d-flex justify-content-between py-1">
                                                    <span class="text-muted" style="font-size: 13.5px;">Tổng tiền hàng:</span>
                                                    <span class="text-dark fw-medium" style="font-size: 13.5px;">@item.TongTien.ToString("N0", viCulture)</span>
                                                </div>
                                                <div class="d-flex justify-content-between py-1">
                                                    <span class="text-muted" style="font-size: 13.5px;">Giảm giá phiếu nhập:</span>
                                                    <span class="text-dark fw-medium" style="font-size: 13.5px;">@item.GiamGia.ToString("N0", viCulture)</span>
                                                </div>
                                                <div class="d-flex justify-content-between py-1 border-top pt-2">
                                                    <span class="fw-bold" style="font-size: 14px; color: #0f172a;">Cần trả NCC:</span>
                                                    <span class="fw-bold text-primary" style="font-size: 16px;">@item.CanTraNcc.ToString("N0", viCulture)</span>
                                                </div>
                                                <div class="d-flex justify-content-between py-1">
                                                    <span class="text-muted" style="font-size: 13.5px;">Tiền đã trả NCC:</span>
                                                    <span class="text-dark fw-medium" style="font-size: 13.5px;">@((item.TrangThai == "DA_XAC_NHAN" || item.TrangThai == "HOAN_THANH" ? item.CanTraNcc : 0).ToString("N0", viCulture))</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Hàng nút hành động -->
                                        <div class="dp-actions d-flex align-items-center gap-2 mt-3 pt-3 border-top">
                                            @if (item.TrangThai != "HUY" && item.TrangThai != "DA_HUY")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-cancel-doc" data-id="@item.MaPhieuNhap" data-code="@item.MaPhieuHienThi" data-status="@item.TrangThai">
                                                    <i class="bi bi-trash me-1"></i>Hủy
                                                </button>
                                            }
                                            <a href="@Url.Action("Create", "NhapHang", new { copyId = item.MaPhieuNhap })" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-copy me-1"></i>Sao chép
                                            </a>
                                            <a href="@Url.Action("Export", "NhapHang", new { type = "detail", id = item.MaPhieuNhap })" class="btn btn-sm btn-outline-secondary" target="_blank">
                                                <i class="bi bi-box-arrow-up me-1"></i>Xuất file
                                            </a>
                                            <span class="ms-auto"></span>
                                            @if (item.TrangThai != "HUY" && item.TrangThai != "DA_HUY")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-save-note" data-id="@item.MaPhieuNhap">
                                                    <i class="bi bi-floppy me-1"></i>Lưu
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print();">
                                                <i class="bi bi-printer me-1"></i>In
                                            </button>
                                            @if (item.TrangThai == "NHAP" || item.TrangThai == "PHIEU_TAM")
                                            {
                                                <a href="@Url.Action("Edit", "NhapHang", new { id = item.MaPhieuNhap })" class="btn btn-sm btn-primary">
                                                    <i class="bi bi-pencil-square me-1"></i>Mở phiếu
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@Url.Action("Details", "NhapHang", new { id = item.MaPhieuNhap })" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye me-1"></i>Xem chi tiết
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Phân trang đáy bảng dùng chung component _Pagination.cshtml của hệ thống -->
@await Html.PartialAsync("_Pagination", Model.PagedData, new ViewDataDictionary(ViewData) { { "ItemLabel", "phiếu nhập" } })
