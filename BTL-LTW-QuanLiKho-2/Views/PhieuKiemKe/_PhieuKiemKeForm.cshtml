@model BTL_LTW_QuanLiKho_2.ViewModels.PhieuKiemKeFormVM

<link href="~/css/kiem-kho.css" rel="stylesheet" asp-append-version="true" />

<div class="kk-container" id="kkFormApp"
     data-search-url="@Url.Action("SearchProducts", "PhieuKiemKe")"
     data-group-url="@Url.Action("GetProductsByGroup", "PhieuKiemKe")"
     data-save-draft-url="@Url.Action("SaveDraft", "PhieuKiemKe")"
     data-complete-url="@Url.Action("Complete", "PhieuKiemKe")"
     data-index-url="@Url.Action("Index", "PhieuKiemKe")"
     data-is-readonly="@(Model.IsReadOnly ? "true" : "false")">

    <div class="form-wrap" id="formWrap">
        <!-- VÙNG CHÍNH BÊN TRÁI (Bảng kiểm hàng & Công cụ) -->
        <div class="f-main">
            <div class="f-top">
                <a href="@Url.Action("Index", "PhieuKiemKe")" class="back" id="fBack" title="Quay lại danh sách" aria-label="Quay lại">
                    <i class="bi bi-arrow-left fs-5"></i>
                </a>
                <h1 class="page-title" style="font-size: 20px; font-weight: 700; margin: 0; color: #1f2937;">
                    @(Model.IsReadOnly ? "Chi tiết phiếu kiểm kho" : (Model.MaPhieuKiemKe > 0 ? "Sửa phiếu kiểm kho" : "Kiểm kho"))
                </h1>

                @if (!Model.IsReadOnly)
                {
                    <div class="searchbox focus-w relw">
                        <i class="bi bi-search search-icon"></i>
                        <input id="fSearch" placeholder="Tìm hàng hóa theo mã hoặc tên (F3)" autocomplete="off">
                        <span class="tail">
                            <button type="button" class="btn-tail" id="btnGrp" title="Chọn hàng theo nhóm">
                                <i class="bi bi-grid-3x3-gap"></i>
                            </button>
                        </span>
                        <div class="pop suggest shadow-sm" id="suggest"></div>
                    </div>
                }

                <div class="tools relw">
                    @if (!Model.IsReadOnly)
                    {
                        <button type="button" class="btn btn-tool" id="tImport" title="Nhập từ file Excel/CSV">
                            <i class="bi bi-box-arrow-in-down"></i>
                        </button>
                    }
                    <button type="button" class="btn btn-tool" id="tEye" title="Ẩn/hiện cột">
                        <i class="bi bi-view-list"></i>
                    </button>
                    <button type="button" class="btn btn-tool" id="tNote" title="Lưu ý khi kiểm kho">
                        <i class="bi bi-info-circle"></i>
                    </button>

                    <div class="pop colmenu shadow-sm" id="fCols">
                        <label><input type="checkbox" data-fc="dvt" checked> ĐVT</label>
                        <label><input type="checkbox" data-fc="gt" checked> Giá trị lệch</label>
                    </div>

                    <div class="pop notes shadow-sm" id="notes">
                        <b><i class="bi bi-info-circle text-primary me-1"></i>Lưu ý khi kiểm kho</b>
                        <ul>
                            <li>Phiếu tạm <b>không</b> làm thay đổi tồn kho sổ sách.</li>
                            <li>Khi <b>Hoàn thành</b>, hệ thống đọc lại tồn hiện tại rồi tự động sinh phiếu điều chỉnh cân bằng kho.</li>
                            <li>Dòng <b>Chưa kiểm</b> (bỏ trống Thực tế) được bỏ qua, tồn giữ nguyên.</li>
                            <li>Phiếu đã cân bằng không thể sửa hoặc hủy.</li>
                            <li>Chọn lại cùng một hàng sẽ tự động cộng thêm 1 vào số Thực tế.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 4 Tabs lọc hiển thị danh sách kiểm -->
            <div class="tabs" id="tabs">
                <button type="button" class="tab on" data-t="all">Tất cả (0)</button>
                <button type="button" class="tab" data-t="khop">Khớp (0)</button>
                <button type="button" class="tab" data-t="lech">Lệch (0)</button>
                <button type="button" class="tab" data-t="chua">Chưa kiểm (0)</button>
            </div>

            <!-- Khối bảng lưới hàng hóa kiểm -->
            <div class="grid-card" id="gridCard">
                <!-- Nội dung bảng sẽ được vẽ linh hoạt bởi phieu-kiem-ke-form.js -->
            </div>
        </div>

        <!-- NÚT TRÒN THU GỌN / MỞ RỘNG PANEL PHẢI (Đặt ngoài aside.f-panel để không bao giờ bị cắt cụm) -->
        <button type="button" class="panel-toggle" id="pTg" title="Thu gọn / mở rộng thông tin (Phím tắt F4)">
            <i class="bi bi-chevron-right" id="pTgIcon"></i>
        </button>

        <!-- PANEL BÊN PHẢI (Thông tin chứng từ & Hành động) -->
        <aside class="f-panel" id="panel">
            <div class="f-panel-inner">
                <!-- Người tạo & Ngày giờ kiểm -->
                <div class="pr">
                    <span class="l">
                        <i class="bi bi-person text-secondary me-1"></i>@(string.IsNullOrEmpty(Model.TenNguoiLap) ? "admin" : Model.TenNguoiLap)
                    </span>
                    <div class="v relw">
                        <input class="inp" id="fDate" value="@Model.ThoiDiemChot.ToString("dd/MM/yyyy HH:mm")" 
                               @(Model.IsReadOnly ? "disabled" : "") autocomplete="off" style="max-width:166px;height:34px;color:#4b5563;cursor:pointer;" title="Nhấp để chọn ngày giờ kiểm kho">
                        <div class="pop dtpop shadow-sm" id="dtPop"></div>
                    </div>
                </div>

                <!-- Mã kiểm kho -->
                <div class="pr">
                    <label for="fCode">Mã kiểm kho</label>
                    <div class="v">
                        <input class="inp" id="fCode" 
                               value="@(Model.MaPhieuKiemKe > 0 ? (!string.IsNullOrWhiteSpace(Model.MaPhieu) ? Model.MaPhieu : Model.MaPhieuHienThi) : (Model.MaPhieu ?? ""))" 
                               placeholder="Mã phiếu tự động" 
                               @(Model.IsReadOnly ? "disabled" : "") 
                               autocomplete="off" style="max-width:166px;height:34px;color:#4b5563;text-transform:uppercase;">
                    </div>
                </div>

                <!-- Kho kiểm -->
                <div class="pr">
                    <label>Kho kiểm</label>
                    <span class="v text-primary fw-semibold">@Model.TenKho</span>
                </div>

                <!-- Trạng thái -->
                <div class="pr">
                    <span class="l">Trạng thái</span>
                    <span class="v left">
                        @if (Model.TrangThai == "DA_DIEU_CHINH")
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Đã cân bằng kho</span>
                        }
                        else if (Model.TrangThai == "HUY")
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Đã hủy</span>
                        }
                        else
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Phiếu tạm</span>
                        }
                    </span>
                </div>

                <!-- Tổng kết số liệu -->
                <div id="sums"></div>

                <!-- Ô ghi chú -->
                <textarea id="fNote" @(Model.IsReadOnly ? "disabled" : "") placeholder="Ghi chú">@Model.GhiChu</textarea>

                <!-- Widget Kiểm gần đây -->
                <div class="recent shadow-sm">
                    <h5>Kiểm gần đây</h5>
                    <ul id="recent">
                        <li class="muted">Chưa có thao tác</li>
                    </ul>
                </div>

                <!-- 2 Nút hành động lớn -->
                @if (!Model.IsReadOnly)
                {
                    <div class="f-actions">
                        <button type="button" class="save" id="bSave" title="Lưu tạm phiếu kiểm (Phím F9)">
                            <i class="bi bi-floppy fs-5 mb-1"></i>
                            <span>Lưu tạm (F9)</span>
                        </button>
                        <button type="button" class="done" id="bDone" title="Cân bằng kho (Phím F10)">
                            <i class="bi bi-check-lg fs-5 mb-1"></i>
                            <span>Cân bằng kho (F10)</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="alert alert-info py-2 small mb-0">
                        Phiếu kiểm này đã được cân bằng kho vào lúc <strong>@(Model.NgayCanBang?.ToString("dd/MM/yyyy HH:mm"))</strong> bởi <strong>@Model.TenNguoiCanBang</strong> và không thể chỉnh sửa.
                    </div>
                }
            </div>
        </aside>
    </div>
</div>

<!-- Modal chung (Chuẩn KiotViet, hiển thị chính giữa màn hình) -->
<div class="ov" id="ov">
    <div class="modal-box" role="dialog" aria-modal="true">
        <div class="modal-head">
            <h3 id="mTitle" class="d-flex align-items-center gap-2 m-0">
                <i class="bi bi-trash" id="mIcon" style="display: none; font-size: 19px;"></i>
                <span id="mTitleText"></span>
            </h3>
            <button type="button" class="btn-close" id="mClose" aria-label="Đóng"></button>
        </div>
        <div class="mb" id="mBody"></div>
        <div class="mf" id="mFoot"></div>
    </div>
</div>

<!-- Toast thông báo -->
<div class="toast-box" id="toast"></div>

<!-- Input file ẩn cho Import CSV / Excel -->
<input type="file" id="fileIn" accept=".csv,.xlsx,.xls" hidden>

<!-- Dữ liệu khởi tạo nạp an toàn từ Razor ViewModel -->
@{
    var groupsList = new List<object>();
    if (ViewBag.NhomHangs != null)
    {
        var groups = (IEnumerable<BTL_LTW_QuanLiKho_2.Models.NhomHang>)ViewBag.NhomHangs;
        groupsList = groups.Select(g => (object)new { id = g.MaNhom, name = g.TenNhom }).ToList();
    }

    var linesList = (Model.Lines ?? new List<BTL_LTW_QuanLiKho_2.ViewModels.PhieuKiemKeLineVM>()).Select(l => new
    {
        pid = l.MaHang,
        code = l.MaHangNoiBo ?? "",
        name = l.TenHang ?? "",
        unit = l.TenDvt ?? "",
        group = l.TenNhom ?? "",
        sys = l.SoLuongTheoSo,
        act = l.SoLuongThucTe,
        cost = l.DonGia
    }).ToList();

    var configObj = new
    {
        id = Model.MaPhieuKiemKe,
        code = !string.IsNullOrWhiteSpace(Model.MaPhieu) ? Model.MaPhieu : (Model.MaPhieuKiemKe > 0 ? Model.MaPhieuHienThi : ""),
        warehouseId = Model.MaKho,
        created = Model.ThoiDiemChot.ToString("yyyy-MM-ddTHH:mm:ss"),
        note = Model.GhiChu ?? "",
        isReadOnly = Model.IsReadOnly,
        groups = groupsList,
        lines = linesList
    };

    var configJson = System.Text.Json.JsonSerializer.Serialize(configObj, new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    });
}
<script id="stockTakeConfig" type="application/json">
@Html.Raw(configJson)
</script>

