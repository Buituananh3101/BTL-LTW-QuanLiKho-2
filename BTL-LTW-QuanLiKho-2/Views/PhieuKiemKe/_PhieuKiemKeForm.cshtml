<div class="kk-container" id="kkFormApp"
     data-search-url="@Url.Action("SearchProducts", "PhieuKiemKe")"
     data-group-url="@Url.Action("GetProductsByGroup", "PhieuKiemKe")"
     data-save-draft-url="@Url.Action("SaveDraft", "PhieuKiemKe")"
     data-complete-url="@Url.Action("Complete", "PhieuKiemKe")"
     data-index-url="@Url.Action("Index", "PhieuKiemKe")"
     data-is-readonly="@(Model.IsReadOnly ? "true" : "false")">

    <div class="form-wrap">
        <!-- VÙNG CHÍNH BÊN TRÁI (Bảng kiểm hàng & Công cụ) -->
        <div class="f-main">
            <div class="f-top">
                <a href="@Url.Action("Index", "PhieuKiemKe")" class="back" id="fBack" title="Quay lại danh sách" aria-label="Quay lại">
                    <svg class="ic"><use href="#i-back"/></svg>
                </a>
                <h1 class="page-title" style="font-size: 22px">
                    @(Model.IsReadOnly ? "Chi tiết phiếu kiểm kho" : (Model.MaPhieuKiemKe > 0 ? "Sửa phiếu kiểm kho" : "Kiểm kho"))
                </h1>

                @if (!Model.IsReadOnly)
                {
                    <div class="searchbox focus-w relw">
                        <svg class="ic"><use href="#i-search"/></svg>
                        <input id="fSearch" placeholder="Tìm hàng hóa theo mã hoặc tên (F3)" autocomplete="off">
                        <span class="tail">
                            <button type="button" id="btnGrp" title="Chọn hàng theo nhóm">
                                <svg class="ic"><use href="#i-grid"/></svg>
                            </button>
                            <button type="button" id="btnQuick" title="Thêm nhanh hàng hóa mới">
                                <svg class="ic"><use href="#i-plus"/></svg>
                            </button>
                        </span>
                        <div class="pop suggest" id="suggest"></div>
                    </div>
                }

                <div class="tools relw">
                    @if (!Model.IsReadOnly)
                    {
                        <button type="button" class="btn" id="tImport" title="Nhập từ file Excel/CSV">
                            <svg class="ic"><use href="#i-import"/></svg>
                        </button>
                    }
                    <button type="button" class="btn" id="tPrint" title="In phiếu" onclick="window.print();">
                        <svg class="ic"><use href="#i-print"/></svg>
                    </button>
                    <button type="button" class="btn" id="tEye" title="Ẩn/hiện cột">
                        <svg class="ic"><use href="#i-eye"/></svg>
                    </button>
                    <button type="button" class="btn" id="tNote" title="Lưu ý khi kiểm kho">
                        <svg class="ic"><use href="#i-excl"/></svg>
                    </button>

                    <div class="pop colmenu" id="fCols">
                        <label><input type="checkbox" data-fc="dvt" checked> ĐVT</label>
                        <label><input type="checkbox" data-fc="gt" checked> Giá trị lệch</label>
                    </div>

                    <div class="pop notes" id="notes">
                        <b>Lưu ý khi kiểm kho</b>
                        <ul>
                            <li>Phiếu tạm <b>không</b> làm thay đổi tồn kho sổ sách.</li>
                            <li>Khi <b>Hoàn thành</b>, hệ thống đọc lại tồn hiện tại rồi tự động sinh phiếu điều chỉnh cân bằng kho.</li>
                            <li>Dòng <b>Chưa kiểm</b> (bỏ trống Thực tế) được bỏ qua, tồn giữ nguyên.</li>
                            <li>Phiếu đã cân bằng không thể sửa hoặc hủy.</li>
                            <li>Chọn lại cùng một hàng sẽ tự động cộng thêm 1 vào số Thực tế.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 4 Tabs lọc hiển thị danh sách kiểm -->
            <div class="tabs" id="tabs">
                <button type="button" class="tab on" data-t="all">Tất cả (0)</button>
                <button type="button" class="tab" data-t="khop">Khớp (0)</button>
                <button type="button" class="tab" data-t="lech">Lệch (0)</button>
                <button type="button" class="tab" data-t="chua">Chưa kiểm (0)</button>
            </div>

            <!-- Khối bảng lưới hàng hóa kiểm -->
            <div class="grid-card" id="gridCard">
                <!-- Nội dung bảng sẽ được vẽ linh hoạt bởi phieu-kiem-ke-form.js -->
            </div>
        </div>

        <!-- PANEL BÊN PHẢI (Thông tin chứng từ & Hành động) -->
        <aside class="f-panel" id="panel">
            <button type="button" class="panel-toggle" id="pTg" title="Thu gọn / mở rộng">
                <svg class="ic"><use href="#i-chev-r"/></svg>
            </button>

            <!-- Người tạo & Ngày giờ kiểm -->
            <div class="pr">
                <span class="l">
                    <svg class="ic"><use href="#i-user"/></svg> &nbsp;@(string.IsNullOrEmpty(Model.TenNguoiLap) ? "admin" : Model.TenNguoiLap)
                </span>
                <div class="v relw">
                    <input class="inp" id="fDate" value="@Model.ThoiDiemChot.ToString("dd/MM/yyyy HH:mm")" 
                           @(Model.IsReadOnly ? "disabled" : "") autocomplete="off" style="max-width:166px;height:34px;color:#4b5563">
                    <div class="pop dtpop" id="dtPop"></div>
                </div>
            </div>

            <!-- Mã kiểm kho -->
            <div class="pr">
                <label>Mã kiểm kho</label>
                <div class="v">
                    <input class="inp" disabled value="@(Model.MaPhieuKiemKe > 0 ? Model.MaPhieuHienThi : "")" placeholder="Mã phiếu tự động">
                </div>
            </div>

            <!-- Kho kiểm -->
            <div class="pr">
                <label>Kho kiểm</label>
                <span class="v" style="color: var(--blue);">@Model.TenKho</span>
            </div>

            <!-- Trạng thái -->
            <div class="pr">
                <span class="l">Trạng thái</span>
                <span class="v left">
                    @if (Model.TrangThai == "DA_DIEU_CHINH")
                    {
                        <span class="badge s1">Đã cân bằng kho</span>
                    }
                    else if (Model.TrangThai == "HUY")
                    {
                        <span class="badge s2">Đã hủy</span>
                    }
                    else
                    {
                        <span class="badge s0">Phiếu tạm</span>
                    }
                </span>
            </div>

            <!-- Tổng kết số liệu -->
            <div id="sums"></div>

            <!-- Ô ghi chú -->
            <textarea id="fNote" @(Model.IsReadOnly ? "disabled" : "") placeholder="Ghi chú">@Model.GhiChu</textarea>

            <!-- Widget Kiểm gần đây -->
            <div class="recent">
                <h5>Kiểm gần đây</h5>
                <ul id="recent">
                    <li class="muted">Chưa có thao tác</li>
                </ul>
            </div>

            <!-- 2 Nút hành động lớn -->
            @if (!Model.IsReadOnly)
            {
                <div class="f-actions">
                    <button type="button" class="save" id="bSave" title="Lưu tạm phiếu kiểm (Phím F9)">
                        <svg class="ic"><use href="#i-save"/></svg>
                        <span>Lưu tạm (F9)</span>
                    </button>
                    <button type="button" class="done" id="bDone" title="Cân bằng kho (Phím F10)">
                        <svg class="ic"><use href="#i-check"/></svg>
                        <span>Cân bằng kho (F10)</span>
                    </button>
                </div>
            }
            else
            {
                <div class="alert alert-info py-2 small mb-0">
                    Phiếu kiểm này đã được cân bằng kho vào lúc <strong>@(Model.NgayCanBang?.ToString("dd/MM/yyyy HH:mm"))</strong> bởi <strong>@Model.TenNguoiCanBang</strong> và không thể chỉnh sửa.
                </div>
            }
        </aside>
    </div>
</div>

<!-- Modal chung -->
<div class="ov" id="ov">
    <div class="modal-box" role="dialog" aria-modal="true">
        <h3 id="mTitle"></h3>
        <div class="mb" id="mBody"></div>
        <div class="mf" id="mFoot"></div>
    </div>
</div>

<!-- Toast thông báo -->
<div class="toast-box" id="toast"></div>

<!-- Input file ẩn cho Import CSV / Excel -->
<input type="file" id="fileIn" accept=".csv,.xlsx,.xls" hidden>

<!-- Dữ liệu khởi tạo nạp an toàn từ Razor ViewModel -->
<script id="stockTakeConfig" type="application/json">
{
    "id": @Model.MaPhieuKiemKe,
    "code": "@Model.MaPhieuHienThi",
    "warehouseId": @Model.MaKho,
    "created": "@Model.ThoiDiemChot.ToString("yyyy-MM-ddTHH:mm:ss")",
    "note": "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.GhiChu ?? ""))",
    "isReadOnly": @(Model.IsReadOnly ? "true" : "false"),
    "groups": [
        @if (ViewBag.NhomHangs != null)
        {
            var groups = (IEnumerable<BTL_LTW_QuanLiKho_2.Models.NhomHang>)ViewBag.NhomHangs;
            var groupItems = groups.Select(g => $"{{\"id\":{g.MaNhom},\"name\":\"{Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(g.TenNhom))}\"}}");
            @Html.Raw(string.Join(",", groupItems))
        }
    ],
    "lines": [
        @if (Model.Lines != null && Model.Lines.Any())
        {
            var lineItems = Model.Lines.Select(l => $"{{\"pid\":{l.MaHang},\"code\":\"{Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(l.MaHangNoiBo))}\",\"name\":\"{Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(l.TenHang))}\",\"unit\":\"{Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(l.TenDvt))}\",\"group\":\"{Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(l.TenNhom))}\",\"sys\":{l.SoLuongTheoSo},\"act\":{(l.SoLuongThucTe.HasValue ? l.SoLuongThucTe.Value.ToString() : "null")},\"cost\":{l.DonGia}}}");
            @Html.Raw(string.Join(",", lineItems))
        }
    ]
}
</script>
