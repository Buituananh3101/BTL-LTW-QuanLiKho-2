@model BTL_LTW_QuanLiKho_2.ViewModels.PhieuKiemKeFormVM
@{
    ViewData["Title"] = Model.MaPhieuKiemKe > 0 ? "Sửa phiếu kiểm kho" : "Lập phiếu kiểm kho";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<partial name="_PhieuKiemKeForm" model="Model" />

@section Scripts {
<script>
$(document).ready(function () {
    const dataConfig = window.stockTakeData;
    let recentLogs = [];
    let activeTab = 'ALL';

    // Toggle thu gọn/mở rộng panel phải
    $('#toggleRightPanelBtn').on('click', function () {
        const rightCol = $('#formRightCol');
        const leftCol = $('#formLeftCol');

        rightCol.toggleClass('collapsed');
        if (rightCol.hasClass('collapsed')) {
            leftCol.removeClass('col-lg-9').addClass('col-12');
            $('#toggleRightIcon').text('◀');
        } else {
            leftCol.removeClass('col-12').addClass('col-lg-9');
            $('#toggleRightIcon').text('▶');
        }
    });

    // Phím tắt F3: focus vào ô tìm kiếm hàng hóa
    $(document).on('keydown', function (e) {
        if (e.key === 'F3') {
            e.preventDefault();
            $('#productSearchInput').focus().select();
        }
    });

    // Autocomplete tìm kiếm hàng hóa
    let searchTimeout = null;
    $('#productSearchInput').on('input', function () {
        const q = $(this).val().trim();
        clearTimeout(searchTimeout);

        if (q.length === 0) {
            $('#autocompleteDropdown').hide();
            return;
        }

        searchTimeout = setTimeout(function () {
            $.ajax({
                url: '/PhieuKiemKe/SearchProducts',
                type: 'GET',
                data: { q: q, warehouseId: dataConfig.maKho },
                success: function (items) {
                    renderAutocomplete(items);
                }
            });
        }, 200);
    });

    // Đóng dropdown khi click ngoài
    $(document).on('click', function (e) {
        if (!$(e.target).closest('.kk-search-wrapper').length) {
            $('#autocompleteDropdown').hide();
        }
    });

    function renderAutocomplete(items) {
        const dropdown = $('#autocompleteDropdown');
        dropdown.empty();

        if (!items || items.length === 0) {
            dropdown.append('<div class="p-3 text-center text-muted small">Không tìm thấy hàng hóa phù hợp</div>');
            dropdown.show();
            return;
        }

        items.forEach(function (item) {
            const html = `
                <div class="kk-autocomplete-item" data-id="${item.maHang}" data-code="${item.maHangNoiBo}" 
                     data-name="${item.tenHang}" data-unit="${item.tenDvt}" data-group="${item.tenNhom}" 
                     data-stock="${item.tonKho}" data-cost="${item.gia}">
                    <div class="d-flex align-items-center">
                        <div class="kk-item-thumb">📦</div>
                        <div>
                            <div class="fw-bold text-dark">${item.tenHang}</div>
                            <div class="small text-muted">${item.maHangNoiBo} · ${item.tenDvt}</div>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Tồn: <strong class="text-primary">${formatNumber(item.tonKho)}</strong></div>
                        <div class="small text-muted">Giá: ${formatNumber(item.gia)} đ</div>
                    </div>
                </div>
            `;
            dropdown.append(html);
        });

        dropdown.show();
    }

    // Khi chọn sản phẩm từ dropdown gợi ý
    $(document).on('click', '.kk-autocomplete-item', function () {
        const id = $(this).data('id');
        const code = $(this).data('code');
        const name = $(this).data('name');
        const unit = $(this).data('unit');
        const group = $(this).data('group');
        const stock = parseFloat($(this).data('stock')) || 0;
        const cost = parseFloat($(this).data('cost')) || 0;

        addProductRow(id, code, name, unit, group, stock, cost);

        $('#autocompleteDropdown').hide();
        $('#productSearchInput').val('').focus();
    });

    // Hàm thêm hoặc cập nhật hàng hóa vào bảng
    function addProductRow(id, code, name, unit, group, stock, cost, defaultActual = 1) {
        $('#emptyTableRow').remove();

        const existingRow = $(`#stockTakeTableBody tr[data-id="${id}"]`);

        if (existingRow.length > 0) {
            // Sản phẩm đã có trong bảng: tăng Thực tế lên +1
            const actualInput = existingRow.find('.row-actual-input');
            let currentVal = actualInput.val() === '' ? 0 : parseFloat(actualInput.val());
            let newVal = currentVal + 1;
            actualInput.val(newVal);

            // Highlight dòng và cuộn đến
            existingRow.removeClass('kk-row-updated');
            void existingRow[0].offsetWidth; // trigger reflow
            existingRow.addClass('kk-row-updated');
            existingRow[0].scrollIntoView({ behavior: 'smooth', block: 'nearest' });

            // Ghi nhật ký "Kiểm gần đây"
            addRecentLog('edit', `${name} (${currentVal} → ${newVal})`);

            updateRowCalculations(existingRow);
        } else {
            // Thêm mới: prepend lên đầu bảng
            const actualVal = defaultActual !== null ? defaultActual : '';
            const newRow = $(`
                <tr class="stock-take-row kk-row-updated" data-id="${id}" data-cost="${cost}" data-system="${stock}">
                    <td class="text-center">
                        <button type="button" class="btn btn-link text-danger p-0 btn-remove-row" title="Xóa dòng">🗑</button>
                    </td>
                    <td class="text-center row-stt">1</td>
                    <td><span class="fw-bold text-primary">${code}</span></td>
                    <td>
                        <div class="fw-semibold text-dark">${name}</div>
                        <small class="text-muted">${group}</small>
                    </td>
                    <td>${unit}</td>
                    <td class="text-end fw-semibold">${formatNumber(stock)}</td>
                    <td class="text-end">
                        <input type="number" min="0" step="1" class="form-control form-control-sm kk-input-actual text-end d-inline-block row-actual-input" 
                               value="${actualVal}" placeholder="---" />
                    </td>
                    <td class="text-end fw-bold row-diff-qty">---</td>
                    <td class="text-end fw-bold row-diff-amount">---</td>
                </tr>
            `);

            $('#stockTakeTableBody').prepend(newRow);

            // Ghi nhật ký "Kiểm gần đây"
            addRecentLog('add', `${name} (${actualVal !== '' ? actualVal : 'chưa kiểm'})`);

            updateRowCalculations(newRow);
            reindexRows();
        }

        updateSummaryAndTabs();
        filterRowsByActiveTab();
    }

    // Nhập số lượng thực tế trực tiếp
    $(document).on('input', '.row-actual-input', function () {
        const row = $(this).closest('tr');
        const name = row.find('td:nth-child(4) .fw-semibold').text();
        const val = $(this).val();

        updateRowCalculations(row);
        updateSummaryAndTabs();
        filterRowsByActiveTab();

        addRecentLog('edit', `${name} (${val !== '' ? val : 'chưa kiểm'})`);
    });

    // Xóa dòng
    $(document).on('click', '.btn-remove-row', function () {
        const row = $(this).closest('tr');
        row.remove();

        if ($('#stockTakeTableBody tr').length === 0) {
            $('#stockTakeTableBody').append(`
                <tr id="emptyTableRow">
                    <td colspan="9" class="text-center py-5 text-muted">
                        <p class="mb-1">Chưa có hàng hóa nào trong phiếu kiểm.</p>
                        <small>Gõ mã hoặc tên vào ô tìm kiếm (F3) hoặc bấm "Nhóm hàng" để thêm.</small>
                    </td>
                </tr>
            `);
        }

        reindexRows();
        updateSummaryAndTabs();
    });

    // Đánh lại số thứ tự STT
    function reindexRows() {
        $('#stockTakeTableBody tr.stock-take-row').each(function (idx) {
            $(this).find('.row-stt').text(idx + 1);
        });
    }

    // Tính toán trên từng dòng
    function updateRowCalculations(row) {
        const systemStock = parseFloat(row.data('system')) || 0;
        const cost = parseFloat(row.data('cost')) || 0;
        const actualInput = row.find('.row-actual-input');
        const actualValStr = actualInput.val().trim();

        const diffQtyCell = row.find('.row-diff-qty');
        const diffAmountCell = row.find('.row-diff-amount');

        if (actualValStr === '') {
            diffQtyCell.html('<span class="text-muted">---</span>');
            diffAmountCell.html('<span class="text-muted">---</span>');
        } else {
            const actual = parseFloat(actualValStr) || 0;
            const diff = actual - systemStock;
            const amount = diff * cost;

            const diffClass = diff > 0 ? 'text-success' : (diff < 0 ? 'text-danger' : 'text-muted');
            const diffSign = diff > 0 ? '+' : '';

            diffQtyCell.html(`<span class="${diffClass}">${diffSign}${formatNumber(diff)}</span>`);
            diffAmountCell.html(`<span class="${diffClass}">${diffSign}${formatNumber(amount)}</span>`);
        }
    }

    // Cập nhật tổng và 4 tabs đếm
    function updateSummaryAndTabs() {
        let totalActual = 0;
        let totalDiff = 0;
        let totalDiffAmount = 0;

        let countAll = 0;
        let countKhop = 0;
        let countLech = 0;
        let countChuaKiem = 0;

        $('#stockTakeTableBody tr.stock-take-row').each(function () {
            countAll++;
            const systemStock = parseFloat($(this).data('system')) || 0;
            const cost = parseFloat($(this).data('cost')) || 0;
            const actualValStr = $(this).find('.row-actual-input').val().trim();

            if (actualValStr === '') {
                countChuaKiem++;
            } else {
                const actual = parseFloat(actualValStr) || 0;
                const diff = actual - systemStock;
                totalActual += actual;
                totalDiff += diff;
                totalDiffAmount += (diff * cost);

                if (diff === 0) {
                    countKhop++;
                } else {
                    countLech++;
                }
            }
        });

        $('#countAll').text(countAll);
        $('#countKhop').text(countKhop);
        $('#countLech').text(countLech);
        $('#countChuaKiem').text(countChuaKiem);

        $('#lblTotalActual').text(formatNumber(totalActual));

        const diffClass = totalDiff > 0 ? 'text-success' : (totalDiff < 0 ? 'text-danger' : 'text-muted');
        const diffSign = totalDiff > 0 ? '+' : '';
        $('#lblTotalDiff').removeClass('text-success text-danger text-muted').addClass(diffClass)
                          .text(`${diffSign}${formatNumber(totalDiff)}`);

        $('#lblTotalDiffAmount').text(`${formatNumber(totalDiffAmount)} đ`);
    }

    // 4 Tabs click handler: Lọc trực tiếp trên client
    $('.kk-tab-btn').on('click', function () {
        $('.kk-tab-btn').removeClass('active');
        $(this).addClass('active');

        activeTab = $(this).data('tab');
        filterRowsByActiveTab();
    });

    function filterRowsByActiveTab() {
        $('#stockTakeTableBody tr.stock-take-row').each(function () {
            const systemStock = parseFloat($(this).data('system')) || 0;
            const actualValStr = $(this).find('.row-actual-input').val().trim();

            if (activeTab === 'ALL') {
                $(this).show();
            } else if (activeTab === 'KHOP') {
                if (actualValStr !== '' && (parseFloat(actualValStr) - systemStock) === 0) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            } else if (activeTab === 'LECH') {
                if (actualValStr !== '' && (parseFloat(actualValStr) - systemStock) !== 0) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            } else if (activeTab === 'CHUA_KIEM') {
                if (actualValStr === '') {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            }
        });
    }

    // Ghi nhật ký "Kiểm gần đây"
    function addRecentLog(type, text) {
        $('#emptyRecentLog').remove();
        const icon = type === 'add' ? '⎘' : '✏';
        const itemHtml = `
            <div class="kk-recent-item">
                <span class="text-primary">${icon}</span>
                <span class="text-truncate">${text}</span>
            </div>
        `;
        $('#recentLogList').prepend(itemHtml);

        const currentCount = $('#recentLogList .kk-recent-item').length;
        $('#recentLogCount').text(currentCount);

        // Giữ tối đa 15 dòng
        if (currentCount > 15) {
            $('#recentLogList .kk-recent-item:last-child').remove();
        }
    }

    // Mở modal Nhóm hàng (nút Lưới)
    $('#btnGroupModal').on('click', function () {
        const modal = new bootstrap.Modal(document.getElementById('groupModal'));
        modal.show();
    });

    $('#btnConfirmLoadGroup').on('click', function () {
        const groupId = parseInt($('#selectGroup').val()) || 0;
        $.ajax({
            url: '/PhieuKiemKe/GetProductsByGroup',
            type: 'GET',
            data: { groupId: groupId, warehouseId: dataConfig.maKho },
            success: function (items) {
                $('#groupModal').modal('hide');
                if (items && items.length > 0) {
                    items.forEach(function (item) {
                        // Thêm vào phiếu ở trạng thái Chưa kiểm (actual = null)
                        addProductRow(item.maHang, item.maHangNoiBo, item.tenHang, item.tenDvt, item.tenNhom, item.tonKho, item.gia, null);
                    });
                }
            }
        });
    });

    // Thu thập dữ liệu form gửi lên server
    function collectFormData() {
        const lines = [];
        $('#stockTakeTableBody tr.stock-take-row').each(function () {
            const maHang = parseInt($(this).data('id'));
            const system = parseFloat($(this).data('system')) || 0;
            const cost = parseFloat($(this).data('cost')) || 0;
            const actualValStr = $(this).find('.row-actual-input').val().trim();
            const actual = actualValStr !== '' ? parseFloat(actualValStr) : null;

            lines.push({
                maHang: maHang,
                soLuongTheoSo: system,
                soLuongThucTe: actual,
                donGia: cost
            });
        });

        return {
            maPhieuKiemKe: dataConfig.maPhieuKiemKe,
            maKho: dataConfig.maKho,
            maNvlap: dataConfig.maNvlap,
            thoiDiemChot: $('#pkkDateInput').val(),
            ghiChu: $('#pkkNote').val(),
            lines: lines
        };
    }

    // Nút Lưu tạm
    $('#btnSaveDraft').on('click', function () {
        const payload = collectFormData();
        if (payload.lines.length === 0) {
            alert('Vui lòng thêm ít nhất một hàng hóa vào phiếu kiểm.');
            return;
        }

        const btn = $(this);
        btn.prop('disabled', true).text('Đang lưu...');

        $.ajax({
            url: '/PhieuKiemKe/SaveDraft',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                alert(res.message);
                window.location.href = '/PhieuKiemKe/Index';
            },
            error: function (xhr) {
                btn.prop('disabled', false).text('💾 Lưu tạm');
                alert('Lỗi: ' + (xhr.responseJSON?.message || 'Không thể lưu tạm.'));
            }
        });
    });

    // Nút Hoàn thành (Cân bằng kho)
    $('#btnComplete').on('click', function () {
        const payload = collectFormData();
        if (payload.lines.length === 0) {
            alert('Vui lòng thêm ít nhất một hàng hóa vào phiếu kiểm.');
            return;
        }

        const uncounted = payload.lines.filter(x => x.soLuongThucTe === null).length;
        if (uncounted > 0) {
            $('#uncountedCount').text(uncounted);
            $('#uncountedWarning').show();
        } else {
            $('#uncountedWarning').hide();
        }

        const modal = new bootstrap.Modal(document.getElementById('confirmCompleteModal'));
        modal.show();
    });

    $('#btnExecuteComplete').on('click', function () {
        const payload = collectFormData();
        const btn = $(this);
        btn.prop('disabled', true).text('Đang cân bằng...');

        $.ajax({
            url: '/PhieuKiemKe/Complete',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                $('#confirmCompleteModal').modal('hide');
                alert(res.message);
                window.location.href = '/PhieuKiemKe/Details/' + res.id;
            },
            error: function (xhr) {
                btn.prop('disabled', false).text('Đồng ý Cân bằng');
                alert('Lỗi: ' + (xhr.responseJSON?.message || 'Không thể cân bằng kho.'));
            }
        });
    });

    function formatNumber(val) {
        if (val === null || val === undefined) return '0';
        return new Intl.NumberFormat('vi-VN').format(val);
    }
});
</script>
}
