@model BTL_LTW_QuanLiKho_2.ViewModels.PhieuKiemKeIndexVM
@using System.Globalization
@{
    var viCulture = CultureInfo.GetCultureInfo("vi-VN");
}

<div class="kiot-table-scroll-body">
    <table class="tbl" id="stockTakeTable" style="width: max-content; min-width: 760px;">
        <thead>
            <tr>
                <th style="width: 36px;" class="text-center th-checkbox">
                    <input class="form-check-input" type="checkbox" id="chkAll" @(!Model.Items.Any() ? "disabled" : "") />
                </th>
                <th style="width: 36px; cursor: pointer;" class="text-center th-star" onclick="toggleStarHeaderFilter(event)">
                    <span class="star-btn star-header-filter @(Model.DaDanhDauFilter ? "starred" : "")" id="starHeaderFilter" title="@(Model.DaDanhDauFilter ? "Bỏ lọc sao (Hiển thị tất cả)" : "Lọc danh sách phiếu được đánh dấu sao")">
                        <i class="bi @(Model.DaDanhDauFilter ? "bi-star-fill" : "bi-star")"></i>
                    </span>
                </th>
                <th data-col="ma" style="width: 130px; min-width: 130px;" class="sortable-th @(Model.SortBy == "ma" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Mã kiểm kho">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Mã kiểm kho</span>
                            @if (Model.SortBy == "ma" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "ma" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tg" style="width: 145px; min-width: 145px;" class="sortable-th @(Model.SortBy == "tg" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Thời gian">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Thời gian</span>
                            @if (Model.SortBy == "tg" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "tg" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tt" style="width: 110px; min-width: 110px;" class="num r text-end sortable-th @(Model.SortBy == "tt" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Tổng thực tế">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Tổng thực tế</span>
                            @if (Model.SortBy == "tt" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "tt" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="cl" style="width: 120px; min-width: 120px;" class="num r text-end sortable-th @(Model.SortBy == "cl" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Tổng chênh lệch">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Tổng chênh lệch</span>
                            @if (Model.SortBy == "cl" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "cl" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="tang" style="width: 110px; min-width: 110px;" class="num r text-end sortable-th @(Model.SortBy == "tang" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo SL lệch tăng">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">SL lệch tăng</span>
                            @if (Model.SortBy == "tang" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "tang" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="giam" style="width: 110px; min-width: 110px;" class="num r text-end sortable-th @(Model.SortBy == "giam" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo SL lệch giảm">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">SL lệch giảm</span>
                            @if (Model.SortBy == "giam" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "giam" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="cb" style="width: 145px; min-width: 145px;" class="sortable-th @(Model.SortBy == "cb" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Ngày cân bằng">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Ngày cân bằng</span>
                            @if (Model.SortBy == "cb" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "cb" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="slt" style="width: 100px; min-width: 100px;" class="num r text-end sortable-th @(Model.SortBy == "slt" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo SL thực tế">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">SL thực tế</span>
                            @if (Model.SortBy == "slt" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "slt" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="ghi" style="width: 180px; min-width: 180px;" class="sortable-th @(Model.SortBy == "ghi" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Ghi chú">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Ghi chú</span>
                            @if (Model.SortBy == "ghi" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "ghi" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="st" style="width: 135px; min-width: 135px;" class="sortable-th @(Model.SortBy == "st" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Trạng thái">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Trạng thái</span>
                            @if (Model.SortBy == "st" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "st" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
                <th data-col="kho" style="width: 130px; min-width: 130px;" class="sortable-th @(Model.SortBy == "kho" ? (Model.SortDir == "asc" ? "is-sorted sorted-asc" : "is-sorted sorted-desc") : "")" title="Nhấn để sắp xếp theo Kho">
                    <div class="th-content">
                        <span class="th-title-wrap">
                            <span class="th-text">Kho</span>
                            @if (Model.SortBy == "kho" && Model.SortDir == "asc") { <span class="sort-icon"><i class="bi bi-arrow-up"></i></span> }
                            else if (Model.SortBy == "kho" && Model.SortDir == "desc") { <span class="sort-icon"><i class="bi bi-arrow-down"></i></span> }
                        </span>
                    </div>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="13" class="p-0">
                        <div class="empty d-block py-5 text-center">
                            <div class="ico mb-3"><i class="bi bi-inbox fs-1 text-primary"></i></div>
                            <h5 class="fw-bold">Không tìm thấy phiếu kiểm kho</h5>
                            <p class="text-muted mb-0 small">Không tìm thấy giao dịch nào phù hợp với bộ lọc hiện tại.<br />Nhấn <a href="javascript:void(0)" id="resetF" class="text-primary text-decoration-none fw-semibold">vào đây</a> để xóa bộ lọc và tiếp tục tìm kiếm.</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    <tr class="product-row tbl-row" data-id="@item.MaPhieuKiemKe" title="Nhấn để xem chi tiết phiếu kiểm kho">
                        <td class="w-chk text-center cell-checkbox" onclick="event.stopPropagation();">
                            <input class="form-check-input row-select" type="checkbox" data-sel="@item.MaPhieuKiemKe" value="@item.MaPhieuKiemKe">
                        </td>
                        <td class="w-star text-center cell-star" style="cursor: pointer;" onclick="toggleFavoriteStockTake(event, @item.MaPhieuKiemKe, this)">
                            <span class="star-btn @(item.DaDanhDau ? "starred" : "")" data-id="@item.MaPhieuKiemKe" title="@(item.DaDanhDau ? "Bỏ đánh dấu sao" : "Đánh dấu sao")">
                                <i class="bi @(item.DaDanhDau ? "bi-star-fill" : "bi-star")"></i>
                            </span>
                        </td>
                        <td data-col="ma"><span class="text-break">@item.MaPhieuHienThi</span></td>
                        <td data-col="tg">@item.ThoiDiemChot.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-col="tt" class="r text-end">@item.TongThucTe.ToString("N0", viCulture)</td>
                        <td data-col="cl" class="r text-end">
                            @(item.TongChenhLech > 0 ? "+" : "")@item.TongChenhLech.ToString("N0", viCulture)
                        </td>
                        <td data-col="tang" class="r text-end">@(item.SlLechTang > 0 ? "+" + item.SlLechTang.ToString("N0", viCulture) : "0")</td>
                        <td data-col="giam" class="r text-end">@(item.SlLechGiam > 0 ? "-" + item.SlLechGiam.ToString("N0", viCulture) : "0")</td>
                        <td data-col="cb">@(item.NgayCanBang.HasValue ? item.NgayCanBang.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                        <td data-col="slt" class="r text-end">@item.TongThucTe.ToString("N0", viCulture)</td>
                        <td data-col="ghi" class="note text-truncate" title="@item.GhiChu">@item.GhiChu</td>
                        <td data-col="st">
                            @if (item.TrangThai == "DA_DIEU_CHINH")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Đã cân bằng kho</span>
                            }
                            else if (item.TrangThai == "HUY")
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Đã hủy</span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Phiếu tạm</span>
                            }
                        </td>
                        <td data-col="kho">@item.TenKho</td>
                    </tr>

                    <!-- Khối chi tiết bung ra (Inline Drawer / Accordion) -->
                    <tr class="product-detail-row dtl" id="dtl-@item.MaPhieuKiemKe" style="display: none;">
                        <td colspan="13" class="p-0">
                            <div class="product-detail-panel-wrap" style="display: none;">
                                <div class="product-detail-panel dp shadow-sm" data-d="@item.MaPhieuKiemKe">
                                    <div class="dp-tabs"><button type="button" class="dp-tab active" data-tab="info">Thông tin</button></div>
                                    <div class="kk-detail-fixed-wrap kiot-detail-fixed-wrap">
                                        <h2 class="d-flex align-items-center gap-2">
                                            <span class="fw-bold" style="font-size: 18px; color: #1e293b;">@item.MaPhieuHienThi</span>
                                            @if (item.TrangThai == "DA_DIEU_CHINH")
                                            {
                                                <span class="badge bg-success-subtle text-success border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Đã cân bằng kho</span>
                                            }
                                            else if (item.TrangThai == "HUY")
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Đã hủy</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary-subtle text-primary border-0 px-2 py-1 rounded-pill" style="font-weight: 500; font-size: 12px;">Phiếu tạm</span>
                                            }
                                        </h2>
                                        <div class="meta text-muted small mt-2">
                                            <span>Người tạo: <strong class="text-dark">@item.TenNguoiLap</strong></span>
                                            <span>Ngày tạo: @item.ThoiDiemChot.ToString("dd/MM/yyyy HH:mm")</span>
                                            <i class="br"></i>
                                            @if (item.TrangThai == "DA_DIEU_CHINH")
                                            {
                                                <span>Người cân bằng: <strong class="text-dark">@item.TenNguoiLap</strong></span>
                                                <span>Ngày cân bằng: @(item.NgayCanBang?.ToString("dd/MM/yyyy HH:mm"))</span>
                                            }
                                        </div>

                                        <table class="dtl-tbl table table-sm table-bordered mt-3 mb-0" style="background: #fff;">
                                            <thead style="background: #f8fafc;">
                                                <tr>
                                                    <th style="width: 180px; font-weight: 600; font-size: 13px; color: #334155;">Mã hàng</th>
                                                    <th style="font-weight: 600; font-size: 13px; color: #334155;">Tên hàng</th>
                                                    <th class="r text-end" style="width: 120px; font-weight: 600; font-size: 13px; color: #334155;">Tồn kho</th>
                                                    <th class="r text-end" style="width: 120px; font-weight: 600; font-size: 13px; color: #334155;">Thực tế</th>
                                                    <th class="r text-end" style="width: 120px; font-weight: 600; font-size: 13px; color: #334155;">SL lệch</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr class="fin">
                                                    <td><input class="form-control form-control-sm dtl-search-code" placeholder="Tìm mã hàng" style="border-radius: 4px; border: 1px solid #d1d5db; height: 28px; font-size: 12.5px;"></td>
                                                    <td><input class="form-control form-control-sm dtl-search-name" placeholder="Tìm tên hàng" style="border-radius: 4px; border: 1px solid #d1d5db; height: 28px; font-size: 12.5px;"></td>
                                                    <td colspan="3" class="bg-transparent border-0"></td>
                                                </tr>
                                            </tbody>
                                            <tbody class="dl">
                                                @if (item.Lines.Any())
                                                {
                                                    foreach (var l in item.Lines)
                                                    {
                                                        var diff = l.SlChenhLech;
                                                        <tr class="dtl-line-row" data-code="@l.MaHangNoiBo.ToLower()" data-name="@l.TenHang.ToLower()">
                                                            <td><span class="text-break">@l.MaHangNoiBo</span></td>
                                                            <td>@l.TenHang</td>
                                                            <td class="r text-end">@l.SoLuongTheoSo.ToString("N0", viCulture)</td>
                                                            <td class="r text-end">
                                                                @if (l.SoLuongThucTe.HasValue)
                                                                {
                                                                    @l.SoLuongThucTe.Value.ToString("N0", viCulture)
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">Chưa kiểm</span>
                                                                }
                                                            </td>
                                                            <td class="r text-end">
                                                                @(diff.HasValue ? diff.Value.ToString("N0", viCulture) : "")
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr><td colspan="5" class="text-muted text-center py-3">Không có hàng nào trong phiếu.</td></tr>
                                                }
                                            </tbody>
                                        </table>

                                        <!-- Khối Ghi chú + Tổng kết số liệu bên phải -->
                                        <div class="dp-bottom d-flex gap-4 align-items-start mt-3">
                                            <div class="flex-grow-1" style="min-width: 250px;">
                                                <textarea class="form-control dp-note" style="height: 105px; resize: none; border: 1px solid #d1d5db; border-radius: 6px; font-size: 13.5px;" @(item.TrangThai == "HUY" ? "disabled" : "") placeholder="Ghi chú">@item.GhiChu</textarea>
                                            </div>
                                            <div class="sums" style="flex: 0 0 280px; width: 280px;">
                                                <div class="d-flex justify-content-between py-1">
                                                    <span class="text-muted" style="font-size: 13.5px;">Số lượng thực tế</span>
                                                    <span class="text-dark" style="font-size: 13.5px;">@item.TongThucTe.ToString("N0", viCulture)</span>
                                                </div>
                                                <div class="d-flex justify-content-between py-1">
                                                    <span class="text-muted" style="font-size: 13.5px;">Số lượng lệch tăng</span>
                                                    <span class="text-dark" style="font-size: 13.5px;">@(item.SlLechTang > 0 ? item.SlLechTang.ToString("N0", viCulture) : "0")</span>
                                                </div>
                                                <div class="d-flex justify-content-between py-1">
                                                    <span class="text-muted" style="font-size: 13.5px;">Số lượng lệch giảm</span>
                                                    <span class="text-dark" style="font-size: 13.5px;">@(item.SlLechGiam > 0 ? "-" + item.SlLechGiam.ToString("N0", viCulture) : "0")</span>
                                                </div>
                                                <div class="d-flex justify-content-between py-1">
                                                    <span class="text-muted" style="font-size: 13.5px;">Số lượng chênh lệch</span>
                                                    <span class="text-dark" style="font-size: 13.5px;">@item.TongChenhLech.ToString("N0", viCulture)</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Hàng nút hành động -->
                                        <div class="dp-actions d-flex align-items-center gap-2 mt-3 pt-3 border-top">
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-cancel-doc" data-id="@item.MaPhieuKiemKe" data-code="@item.MaPhieuHienThi" data-status="@item.TrangThai">
                                                <i class="bi bi-trash me-1"></i>Hủy
                                            </button>
                                            <a href="@Url.Action("Create", "PhieuKiemKe", new { copyId = item.MaPhieuKiemKe })" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-copy me-1"></i>Sao chép
                                            </a>
                                            <a href="@Url.Action("Export", "PhieuKiemKe", new { type = "detail", id = item.MaPhieuKiemKe })" class="btn btn-sm btn-outline-secondary" target="_blank">
                                                <i class="bi bi-box-arrow-up me-1"></i>Xuất file
                                            </a>
                                            <span class="ms-auto"></span>
                                            @if (item.TrangThai != "HUY")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-save-note" data-id="@item.MaPhieuKiemKe">
                                                    <i class="bi bi-floppy me-1"></i>Lưu
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print();">
                                                <i class="bi bi-printer me-1"></i>In
                                            </button>
                                            @if (item.TrangThai == "NHAP")
                                            {
                                                <a href="@Url.Action("Edit", "PhieuKiemKe", new { id = item.MaPhieuKiemKe })" class="btn btn-sm btn-primary">
                                                    <i class="bi bi-pencil-square me-1"></i>Mở phiếu
                                                </a>
                                            }
                                        </div>
                                    </div>
                            </div>
                        </div>
                    </td>
                </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Phân trang đáy bảng dùng chung component _Pagination.cshtml của hệ thống -->
@await Html.PartialAsync("_Pagination", Model.PagedData, new ViewDataDictionary(ViewData) { { "ItemLabel", "phiếu kiểm" } })
