@model BTL_LTW_QuanLiKho_2.ViewModels.PhieuKiemKeIndexVM
@using BTL_LTW_QuanLiKho_2.ViewModels.Common

<!-- CỘT BÊN TRÁI: TIÊU ĐỀ "PHIẾU KIỂM KHO" + 3 KHỐI BỘ LỌC chuyên nghiệp (MODULAR LEGO) -->
<aside class="kp-sidebar-col" id="sidebarFilterCol">
    <!-- Header cho sidebar khi mở ở chế độ mobile/zoom in -->
    <div class="kp-sidebar-mobile-header d-lg-none d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
        <div class="fw-bold fs-6 text-dark"><i class="bi bi-funnel me-1 text-primary"></i> Bộ lọc phiếu kiểm kho</div>
        <button type="button" class="btn-close" id="btnCloseSidebarMobile" aria-label="Đóng"></button>
    </div>

    <!-- Tiêu đề sidebar Desktop -->
    <div class="kp-sidebar-title d-none d-lg-flex">
        Phiếu kiểm kho
    </div>

    <div class="kp-filter-box" id="side">
        <!-- 1. Thời gian -->
        <partial name="_DateFilter" model='new DateFilterVM("date", "Thời gian", false)' />

        <!-- 2. Trạng thái chứng từ -->
        <partial name="_StatusFilter" model='new StatusFilterVM("Trạng thái", "dotSt", new() {
            new("NHAP", "Phiếu tạm", Model.Filter.Statuses.Contains("NHAP")),
            new("DA_DIEU_CHINH", "Đã cân bằng kho", Model.Filter.Statuses.Contains("DA_DIEU_CHINH")),
            new("HUY", "Đã hủy", Model.Filter.Statuses.Contains("HUY"))
        })' />

        <!-- 3. Người tạo -->
        <partial name="_MultiSelectFilter" model='new MultiSelectVM("NguoiTao", "nguoitao", "Người tạo", "Chọn người tạo", true, "dotUser") {
            Items = Model.Creators.Select(c => new MultiSelectItemVM(c.MaNv.ToString(), c.TenNv)).ToList()
        }' />
    </div>
</aside>
