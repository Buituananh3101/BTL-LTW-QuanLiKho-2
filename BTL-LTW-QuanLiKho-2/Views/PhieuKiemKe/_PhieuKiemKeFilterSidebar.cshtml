@model BTL_LTW_QuanLiKho_2.ViewModels.PhieuKiemKeIndexVM

<!-- CỘT BÊN TRÁI: TIÊU ĐỀ "KIỂM KHO" + 3 KHỐI BỘ LỌC KIOTVIET -->
<aside class="kiot-sidebar-col" id="sidebarFilterCol">
    <!-- Header cho sidebar khi mở ở chế độ mobile/zoom in -->
    <div class="kiot-sidebar-mobile-header d-lg-none d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
        <div class="fw-bold fs-6 text-dark"><i class="bi bi-funnel me-1 text-primary"></i> Bộ lọc kiểm kho</div>
        <button type="button" class="btn-close" id="btnCloseSidebarMobile" aria-label="Đóng"></button>
    </div>

    <!-- Tiêu đề sidebar Desktop -->
    <div class="kiot-sidebar-title d-none d-lg-flex">
        Kiểm kho
    </div>

    <div class="kiot-filter-box" id="side">
        <!-- 1. Thời gian tạo -->
        <div class="f-block position-relative">
            <h6>Thời gian <span class="filter-dot" id="dotDate"></span></h6>
            <div class="form-check mb-1">
                <input class="form-check-input" type="radio" name="dm" id="rdPreset" checked />
                <label class="form-check-label d-flex justify-content-between align-items-center" for="rdPreset" id="labelPreset" style="cursor: pointer;">
                    <span id="presetTxt">Tháng này</span>
                    <i class="bi bi-chevron-right text-muted small" id="btnOpenQuickDate"></i>
                </label>
            </div>

            <!-- Popup chọn nhanh thời gian (chuẩn KiotViet 3 cột giống Danh sách Hàng hóa) -->
            <div class="quick-date-popup" id="popupQuickDate">
                <div class="quick-date-grid">
                    <div class="quick-date-col">
                        <div class="quick-date-col-title">Theo ngày</div>
                        <div class="quick-date-btn" data-val="homnay">Hôm nay</div>
                        <div class="quick-date-btn" data-val="homqua">Hôm qua</div>
                    </div>
                    <div class="quick-date-col">
                        <div class="quick-date-col-title">Theo tuần</div>
                        <div class="quick-date-btn" data-val="tuannay">Tuần này</div>
                        <div class="quick-date-btn" data-val="tuantruoc">Tuần trước</div>
                        <div class="quick-date-btn" data-val="7ngay">7 ngày qua</div>
                    </div>
                    <div class="quick-date-col">
                        <div class="quick-date-col-title">Theo tháng</div>
                        <div class="quick-date-btn active" data-val="thangnay">Tháng này</div>
                        <div class="quick-date-btn" data-val="thangtruoc">Tháng trước</div>
                        <div class="quick-date-btn" data-val="30ngay">30 ngày qua</div>
                    </div>
                </div>
                <div class="quick-date-grid mt-2">
                    <div class="quick-date-col">
                        <div class="quick-date-col-title">Theo quý</div>
                        <div class="quick-date-btn" data-val="quynay">Quý này</div>
                        <div class="quick-date-btn" data-val="quytruoc">Quý trước</div>
                    </div>
                    <div class="quick-date-col">
                        <div class="quick-date-col-title">Theo năm</div>
                        <div class="quick-date-btn" data-val="namnay">Năm nay</div>
                        <div class="quick-date-btn" data-val="namtruoc">Năm trước</div>
                    </div>
                </div>
                <button type="button" class="quick-date-pill-all mt-2" data-val="toanthoigian">Toàn thời gian</button>
            </div>

            <div class="form-check">
                <input class="form-check-input" type="radio" name="dm" id="rdCustom" />
                <label class="form-check-label d-flex justify-content-between align-items-center" for="rdCustom" id="labelCustom" style="cursor: pointer;">
                    <span id="customTxt">Tùy chỉnh</span>
                    <i class="bi bi-calendar3 text-muted small" id="btnOpenCalendar"></i>
                </label>
            </div>

            <!-- Popup Lịch 2 tháng cho Tùy chỉnh (Giống hệt Hàng hóa) -->
            <div class="dual-calendar-popup" id="popupCalendar">
                <div class="dual-calendar-header">
                    Từ ngày: <span class="fw-bold text-primary" id="calFromText">--</span> - Đến ngày: <span class="fw-bold text-primary" id="calToText">--</span>
                </div>
                <div class="dual-calendar-body">
                    <div class="dual-cal-month">
                        <div class="dual-cal-nav">
                            <button type="button" class="btn-cal-prev">‹</button>
                            <span id="calMonthTitle1">Tháng 10 2026</span>
                            <button type="button" class="btn-cal-next">›</button>
                        </div>
                        <table class="dual-cal-table">
                            <thead><tr><th>T2</th><th>T3</th><th>T4</th><th>T5</th><th>T6</th><th>T7</th><th>CN</th></tr></thead>
                            <tbody id="calBody1"></tbody>
                        </table>
                    </div>
                    <div class="dual-cal-month">
                        <div class="dual-cal-nav">
                            <button type="button" class="btn-cal-prev">‹</button>
                            <span id="calMonthTitle2">Tháng 11 2026</span>
                            <button type="button" class="btn-cal-next">›</button>
                        </div>
                        <table class="dual-cal-table">
                            <thead><tr><th>T2</th><th>T3</th><th>T4</th><th>T5</th><th>T6</th><th>T7</th><th>CN</th></tr></thead>
                            <tbody id="calBody2"></tbody>
                        </table>
                    </div>
                </div>
                <div class="dual-calendar-footer">
                    <a href="javascript:void(0)" class="text-primary small text-decoration-none fw-bold btn-cal-today">Hôm nay</a>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-3 btn-close-popup">Bỏ qua</button>
                        <button type="button" class="btn btn-primary btn-sm py-1 px-3 btn-apply-calendar">Áp dụng</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Trạng thái chứng từ -->
        <div class="f-block position-relative">
            <h6>Trạng thái <span class="filter-dot" id="dotSt"></span></h6>
            <div class="d-flex flex-column gap-2 small">
                <label class="form-check-label d-flex align-items-center gap-2">
                    <input class="form-check-input mt-0" type="checkbox" data-s="NHAP" @(Model.Filter.Statuses.Contains("NHAP") ? "checked" : "")> 
                    <span>Phiếu tạm</span>
                </label>
                <label class="form-check-label d-flex align-items-center gap-2">
                    <input class="form-check-input mt-0" type="checkbox" data-s="DA_DIEU_CHINH" @(Model.Filter.Statuses.Contains("DA_DIEU_CHINH") ? "checked" : "")> 
                    <span>Đã cân bằng kho</span>
                </label>
                <label class="form-check-label d-flex align-items-center gap-2">
                    <input class="form-check-input mt-0" type="checkbox" data-s="HUY" @(Model.Filter.Statuses.Contains("HUY") ? "checked" : "")> 
                    <span>Đã hủy</span>
                </label>
            </div>
        </div>

        <!-- 3. Người tạo -->
        <div class="f-block position-relative">
            <h6>Người tạo <span class="filter-dot" id="dotUser"></span></h6>
            <div class="position-relative">
                <div class="kiot-multiselect-box" id="boxNguoiTao" data-filter="nguoitao">
                    <span class="kiot-ms-placeholder">Chọn người tạo</span>
                </div>
                <div class="kiot-ms-dropdown shadow" id="dropdownNguoiTao">
                    <div class="kiot-ms-search">
                        <input type="text" placeholder="Tìm người tạo..." autocomplete="off" />
                    </div>
                    @foreach (var c in Model.Creators)
                    {
                        <div class="kiot-ms-item" data-val="@c.MaNv" data-name="@c.TenNv">
                            <input type="checkbox" class="form-check-input" />
                            <span>@c.TenNv</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</aside>
