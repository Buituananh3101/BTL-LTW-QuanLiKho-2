@model BTL_LTW_QuanLiKho_2.ViewModels.PhieuKiemKeIndexVM
@{
    ViewData["Title"] = "Phiếu kiểm kho";
}

<link href="~/css/kiem-kho.css" rel="stylesheet" asp-append-version="true" />

<div class="kiot-container position-relative" id="kiotContainer"
     data-filter-url="@Url.Action("Filter", "PhieuKiemKe")"
     data-details-url="@Url.Action("GetItemDetails", "PhieuKiemKe")"
     data-note-url="@Url.Action("SaveNote", "PhieuKiemKe")"
     data-cancel-url="@Url.Action("HuyPhieu", "PhieuKiemKe")"
     data-export-url="@Url.Action("Export", "PhieuKiemKe")"
     data-toggle-star-url="@Url.Action("ToggleFavorite", "PhieuKiemKe")"
     data-is-starred="@(Model.DaDanhDauFilter ? "true" : "false")"
     data-warehouse-id="@Model.CurrentWarehouseId"
     data-sort-by="@Model.SortBy"
     data-sort-dir="@Model.SortDir">

    <!-- 1. CỘT BÊN TRÁI: TIÊU ĐỀ + BỘ LỌC KIOTVIET (PARTIAL VIEW) -->
    <partial name="_PhieuKiemKeFilterSidebar" model="Model" />

    <!-- Backdrop che mờ khi mở bộ lọc trên mobile/zoom in -->
    <div class="kiot-sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Nút tròn thu gọn / mở rộng ở ranh giới giữa sidebar và bảng (Phím tắt F4) -->
    <button type="button" class="kiot-sidebar-toggle-btn d-none d-lg-flex" id="btnToggleSidebar" title="Thu gọn bộ lọc (F4)">
        <i class="bi bi-chevron-left" id="sidebarToggleIcon"></i>
    </button>

    <!-- 2. CỘT BÊN PHẢI: THANH TÌM KIẾM + TOOLBAR + BẢNG PHIẾU KIỂM KHO -->
    <main class="kiot-main-col">
        <!-- Toolbar trên cùng: Thanh tìm kiếm thẳng hàng với bảng bên dưới -->
        <div class="kiot-toolbar-row">
            <!-- Tiêu đề + Nút phễu bộ lọc trên mobile / zoom in -->
            <div class="kiot-mobile-title-wrap d-lg-none d-flex align-items-center gap-2">
                <span class="kiot-mobile-title fw-bold fs-6 text-dark">Phiếu kiểm kho</span>
                <button type="button" class="btn btn-sm btn-outline-primary kiot-btn-funnel" id="btnMobileFilter" title="Mở bộ lọc phiếu kiểm kho">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>

            <!-- Ô tìm kiếm theo mã phiếu -->
            <div class="kiot-search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="keywordSearch" class="form-control" placeholder="Theo mã phiếu kiểm (F3)" value="@Model.Filter.Q" autocomplete="off" />
            </div>

            <!-- Nhóm nút hành động KiotViet -->
            <div class="kiot-actions-group">
                <!-- Nút + Kiểm kho -->
                <a href="@Url.Action("Create", "PhieuKiemKe")" class="btn btn-primary d-inline-flex align-items-center" id="btnNew" title="Lập phiếu kiểm kho mới">
                    <i class="bi bi-plus-lg me-1"></i><span>Kiểm kho</span>
                </a>

                <!-- Dropdown Xuất file -->
                <div class="dropdown">
                    <button class="btn btn-tool dropdown-toggle" type="button" id="btnExportDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Xuất file">
                        <i class="bi bi-box-arrow-up me-1"></i>Xuất file
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="btnExportDropdown">
                        <li>
                            <a class="dropdown-item py-2" href="javascript:void(0)" id="btnExpList" data-x="list">
                                <i class="bi bi-file-earmark-spreadsheet me-2 text-success"></i>Xuất danh sách phiếu kiểm
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" href="javascript:void(0)" id="btnExpDetail" data-x="detail">
                                <i class="bi bi-file-earmark-text me-2 text-primary"></i>Xuất chi tiết (từng dòng hàng)
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Dropdown Tùy chọn hiển thị cột -->
                <div class="dropdown">
                    <button class="btn btn-tool" type="button" id="btnColsDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Tùy chọn hiển thị cột">
                        <i class="bi bi-view-list"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow p-3" id="colMenu" style="min-width: 210px;">
                        <h6 class="dropdown-header px-0 pt-0 text-dark fw-bold">Hiển thị cột</h6>
                        <div class="d-flex flex-column gap-2 small">
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="ma" checked> Mã kiểm kho</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="tg" checked> Thời gian</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="tt" checked> Tổng thực tế</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="cl" checked> Tổng chênh lệch</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="tang" checked> SL lệch tăng</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="giam" checked> SL lệch giảm</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="cb" checked> Ngày cân bằng</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="slt" checked> SL thực tế</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="ghi" checked> Ghi chú</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="st" checked> Trạng thái</label>
                            <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" data-c="kho" checked> Kho</label>
                        </div>
                    </div>
                </div>

                <!-- Tải lại bảng -->
                <button type="button" class="btn btn-tool d-none d-sm-inline-flex" title="Tải lại bảng" id="btnReloadTable">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <!-- Trợ giúp -->
                <button type="button" class="btn btn-tool" title="Trợ giúp" id="btnHelp" onclick="alert('Hướng dẫn: Màn hình Quản lý phiếu kiểm kho KiotViet');">
                    <i class="bi bi-question-circle"></i>
                </button>
            </div>
        </div>

        <!-- Bảng danh sách phiếu kiểm kho (Partial View AJAX) -->
        <section id="content">
            <div id="tableWrapper" class="kiot-table-wrapper">
                <partial name="_PhieuKiemKeTable" model="Model" />
            </div>
        </section>
    </main>
</div>

<!-- Modal xác nhận chung -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content shadow border-0">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold" id="mTitle">Xác nhận</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body py-3 small text-secondary" id="mBody">
            </div>
            <div class="modal-footer border-0 pt-0 d-flex justify-content-end gap-2" id="mFoot">
            </div>
        </div>
    </div>
</div>

<!-- Toast thông báo -->
<div class="toast-box" id="toast"></div>

@section Scripts {
    <script src="~/js/kiot-filter.js" asp-append-version="true"></script>
    <script src="~/js/phieu-kiem-ke-index.js" asp-append-version="true"></script>
}
