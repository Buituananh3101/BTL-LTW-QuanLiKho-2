@model BTL_LTW_QuanLiKho_2.ViewModels.PhieuKiemKeIndexVM
@{
    ViewData["Title"] = "Kiểm kho";
}

<link href="~/css/kiem-kho.css" rel="stylesheet" asp-append-version="true" />

