  <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
  <symbol id="i-export" viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8M17 8l4 4-4 4M21 12H10"/></symbol>
  <symbol id="i-cols" viewBox="0 0 24 24"><path d="M4 6h3M10 6h10M4 12h3M10 12h10M4 18h3M10 18h10"/></symbol>
  <symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3h.1a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8v.1a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></symbol>
  <symbol id="i-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 .5c0 1.7-2.5 2-2.5 3.5M12 17h.01"/></symbol>
  <symbol id="i-star" viewBox="0 0 24 24"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></symbol>
  <symbol id="i-chev-d" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></symbol>
  <symbol id="i-chev-r" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></symbol>
  <symbol id="i-chev-l" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></symbol>
  <symbol id="i-cal" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M8 14h2M12 14h2"/></symbol>
  <symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M4 12l5 5L20 6"/></symbol>
  <symbol id="i-back" viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></symbol>
  <symbol id="i-grid" viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></symbol>
  <symbol id="i-print" viewBox="0 0 24 24"><path d="M7 9V3h10v6M7 17H4v-7h16v7h-3M7 14h10v7H7z"/></symbol>
  <symbol id="i-eye" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></symbol>
  <symbol id="i-excl" viewBox="0 0 24 24"><path d="M12 5v9M12 18h.01"/></symbol>
  <symbol id="i-import" viewBox="0 0 24 24"><path d="M4 6h8M4 10h5M4 14h5M4 18h8M20 12H11M15 8l-4 4 4 4" /></symbol>
  <symbol id="i-sheet" viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></symbol>
  <symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 10v7M14 10v7"/></symbol>
  <symbol id="i-copy" viewBox="0 0 24 24"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h8"/></symbol>
  <symbol id="i-save" viewBox="0 0 24 24"><path d="M5 3h11l4 4v14H5z"/><path d="M8 3v6h7V3M8 21v-7h8v7"/></symbol>
  <symbol id="i-inbox" viewBox="0 0 24 24"><path d="M3 13l3-8h12l3 8v6H3z"/><path d="M3 13h5l1 3h6l1-3h5"/></symbol>
  <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></symbol>
  <symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 9a6 6 0 0 1 12 0c0 6 2 7 2 8H4c0-1 2-2 2-8zM10 21h4"/></symbol>
  <symbol id="i-chat" viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.7 7L4 20l1.2-4.6A8 8 0 1 1 21 12z"/></symbol>
  <symbol id="i-pencil" viewBox="0 0 24 24"><path d="M4 20h4L19 9l-4-4L4 16z"/></symbol>
</svg>

<div class="kk-container" id="kkIndexApp" 
     data-filter-url="@Url.Action("Filter", "PhieuKiemKe")"
     data-details-url="@Url.Action("GetItemDetails", "PhieuKiemKe")"
     data-note-url="@Url.Action("SaveNote", "PhieuKiemKe")"
     data-cancel-url="@Url.Action("HuyPhieu", "PhieuKiemKe")"
     data-export-url="@Url.Action("Export", "PhieuKiemKe")"
     data-warehouse-id="@Model.CurrentWarehouseId">

    <!-- Thanh công cụ trên cùng (List Top) -->
    <div class="list-top">
        <h1 class="page-title">Phiếu kiểm kho</h1>
        <div class="searchbox focus-w">
            <svg class="ic"><use href="#i-search"/></svg>
            <input id="q" placeholder="Theo mã phiếu kiểm" value="@Model.Filter.Q" autocomplete="off">
            <span class="tail">
                <button type="button" title="Tìm nâng cao">
                    <svg class="ic"><use href="#i-sliders"/></svg>
                </button>
            </span>
        </div>
        <span class="sp"></span>
        <a href="@Url.Action("Create", "PhieuKiemKe")" class="btn primary" id="btnNew">
            <svg class="ic"><use href="#i-plus"/></svg> Kiểm kho
        </a>
        <div class="relw">
            <button type="button" class="btn" id="btnExp">
                <svg class="ic"><use href="#i-export"/></svg> Xuất file 
                <svg class="ic"><use href="#i-chev-d"/></svg>
            </button>
            <div class="pop menu" id="expMenu">
                <button type="button" data-x="list">Xuất danh sách phiếu kiểm</button>
                <button type="button" data-x="detail">Xuất chi tiết (từng dòng hàng)</button>
            </div>
        </div>
        <div class="relw">
            <button type="button" class="btn icon" id="btnCols" title="Hiển thị cột">
                <svg class="ic"><use href="#i-cols"/></svg>
            </button>
            <div class="pop colmenu" id="colMenu">
                <label><input type="checkbox" data-c="ma" checked> Mã kiểm kho</label>
                <label><input type="checkbox" data-c="tg" checked> Thời gian</label>
                <label><input type="checkbox" data-c="tt" checked> Tổng thực tế</label>
                <label><input type="checkbox" data-c="cl" checked> Tổng chênh lệch</label>
                <label><input type="checkbox" data-c="tang" checked> SL lệch tăng</label>
                <label><input type="checkbox" data-c="giam" checked> SL lệch giảm</label>
                <label><input type="checkbox" data-c="cb" checked> Ngày cân bằng</label>
                <label><input type="checkbox" data-c="slt" checked> SL thực tế</label>
                <label><input type="checkbox" data-c="ghi" checked> Ghi chú</label>
                <label><input type="checkbox" data-c="st" checked> Trạng thái</label>
                <label><input type="checkbox" data-c="kho" checked> Kho</label>
            </div>
        </div>
        <button type="button" class="btn icon" title="Cài đặt">
            <svg class="ic"><use href="#i-gear"/></svg>
        </button>
        <button type="button" class="btn icon" title="Trợ giúp">
            <svg class="ic"><use href="#i-help"/></svg>
        </button>
    </div>

    <!-- Khối thân trang: Sidebar bộ lọc + Bảng dữ liệu -->
    <div class="list-wrap">
        @await Html.PartialAsync("_PhieuKiemKeFilterSidebar", Model)
        <section class="tbl-card-wrapper" id="tableWrapper" style="flex: 1; min-width: 0;">
            @await Html.PartialAsync("_PhieuKiemKeTable", Model)
        </section>
    </div>
</div>

<!-- Modal xác nhận chung -->
<div class="ov" id="ov">
    <div class="modal-box" role="dialog" aria-modal="true">
        <h3 id="mTitle"></h3>
        <div class="mb" id="mBody"></div>
        <div class="mf" id="mFoot"></div>
    </div>
</div>

<!-- Toast thông báo -->
<div class="toast-box" id="toast"></div>

@section Scripts {
    <script src="~/js/phieu-kiem-ke-index.js" asp-append-version="true"></script>
}
