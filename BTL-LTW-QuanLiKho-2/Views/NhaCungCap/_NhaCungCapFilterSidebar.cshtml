@model BTL_LTW_QuanLiKho_2.ViewModels.NhaCungCap.NhaCungCapIndexVM
@using BTL_LTW_QuanLiKho_2.ViewModels.Common

<!-- CỘT BÊN TRÁI: TIÊU ĐỀ "NHÀ CUNG CẤP" + BỘ LỌC 5 KHỐI LEGO CHUẨN KIOTVIET -->
<aside class="kiot-sidebar-col" id="sidebarFilterCol">
    <!-- Header cho sidebar khi mở ở chế độ mobile -->
    <div class="kiot-sidebar-mobile-header d-lg-none d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
        <div class="fw-bold fs-6 text-dark"><i class="bi bi-funnel me-1 text-primary"></i> Bộ lọc nhà cung cấp</div>
        <button type="button" class="btn-close" id="btnCloseSidebarMobile" aria-label="Đóng"></button>
    </div>

    <div class="kiot-sidebar-title d-none d-lg-flex">
        Nhà cung cấp
    </div>

    <div class="kiot-filter-box">
        <!-- 1. Nhóm nhà cung cấp -->
        <partial name="_KiotMultiSelectFilter" model='new KiotMultiSelectVM("NhomNcc", "nhom", "Nhóm nhà cung cấp", "Tất cả các nhóm", true) {
            HeaderActionText = "Tạo mới",
            HeaderActionId = "btnOpenQuickGroupNcc",
            AllowEdit = true,
            Items = Model.NhomNccList.Select(g => new KiotMultiSelectItemVM(g.MaNhomNcc.ToString(), g.TenNhom)).ToList()
        }' />

        <!-- 2. Tổng mua -->
        <div class="f-block position-relative">
            <h6>Tổng mua <span class="filter-dot" id="dotTongMua"></span></h6>
            <div class="text-muted small mb-1">Giá trị</div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <input type="text" id="filterTongMuaTu" class="form-control form-control-sm kiot-num text-end" placeholder="Từ" />
                <span class="text-muted">-</span>
                <input type="text" id="filterTongMuaDen" class="form-control form-control-sm kiot-num text-end" placeholder="Tới" />
            </div>
        </div>

        <!-- 3. Thời gian tạo -->
        <partial name="_KiotDateFilter" model='new KiotDateFilterVM("date", "Thời gian", false)' />

        <!-- 4. Nợ hiện tại -->
        <div class="f-block position-relative">
            <h6>Nợ hiện tại <span class="filter-dot" id="dotNo"></span></h6>
            <div class="text-muted small mb-1">Giá trị</div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <input type="text" id="filterNoTu" class="form-control form-control-sm kiot-num text-end" placeholder="Từ" />
                <span class="text-muted">-</span>
                <input type="text" id="filterNoDen" class="form-control form-control-sm kiot-num text-end" placeholder="Tới" />
            </div>
        </div>

        <!-- 5. Trạng thái -->
        <partial name="_KiotStatusFilter" model='new KiotStatusFilterVM("TrangThai", "Trạng thái", new List<KiotStatusOptionVM> {
            new("Tất cả", ""),
            new("Đang hoạt động", "HOAT_DONG", true),
            new("Ngừng hoạt động", "NGUNG_HOAT_DONG")
        })' />
    </div>
</aside>
