@model BTL_LTW_QuanLiKho_2.ViewModels.LoginVM
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Đăng nhập";
}

<main class="login-card">
    <form id="loginForm" class="login-body" novalidate autocomplete="on" asp-controller="Account" asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="brand">
            <img src="~/images/logo.svg" alt="KhoPro" class="brand-mark" />
            <span class="brand-name">KhoPro</span>
        </div>

        <div class="field @(!ViewData.ModelState.IsValid && ViewData.ModelState["TenDangNhap"]?.Errors.Count > 0 ? "invalid" : "")" id="fUser">
            <input type="text" id="TenDangNhap" asp-for="TenDangNhap" placeholder="Tên đăng nhập" autocomplete="username" autofocus />
        </div>

        <div class="field @(!ViewData.ModelState.IsValid && ViewData.ModelState["MatKhau"]?.Errors.Count > 0 ? "invalid" : "")" id="fPass">
            <input type="password" id="MatKhau" asp-for="MatKhau" placeholder="Mật khẩu" autocomplete="current-password" />
            <button type="button" class="toggle-pw" id="togglePw" aria-label="Hiện mật khẩu" title="Hiện/ẩn mật khẩu">
                <!-- Mắt gạch chéo = đang ẩn -->
                <svg id="iconHide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20C5 20 1 12 1 12a18.5 18.5 0 0 1 5.06-5.94"/>
                    <path d="M9.9 4.24A9.1 9.1 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                    <path d="M14.12 14.12A3 3 0 1 1 9.88 9.88"/><path d="M1 1l22 22"/>
                </svg>
                <svg id="iconShow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
            </button>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-box show" id="errorBox" role="alert">
                @Html.ValidationSummary(true, "")
                <span asp-validation-for="TenDangNhap"></span>
                <span asp-validation-for="MatKhau"></span>
            </div>
        }
        else
        {
            <div class="error-box" id="errorBox" role="alert"></div>
        }

        <div class="options">
            <label><input type="checkbox" asp-for="GhiNho" /> Duy trì đăng nhập</label>
            <span class="sep"></span>
            <a href="#" id="forgot">Quên mật khẩu?</a>
        </div>

        <!-- Tài khoản mẫu để kiểm thử -->
        <div class="demo-hint">
            <div class="demo-hint-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                Tài khoản mẫu thử nghiệm (mật khẩu: 123456):
            </div>
            <div class="demo-tags">
                <button type="button" class="demo-tag" onclick="quickFill('quanly', '123456')">Quản lý (quanly)</button>
                <button type="button" class="demo-tag" onclick="quickFill('thukho', '123456')">Thủ kho (thukho)</button>
                <button type="button" class="demo-tag" onclick="quickFill('banhang', '123456')">Bán hàng (banhang)</button>
            </div>
        </div>
    </form>

    <div class="actions">
        <button type="submit" form="loginForm" class="btn-manage" id="btnSubmit">
            <svg viewBox="0 0 24 24"><path d="M3 3h2v16h16v2H3zM7 14l4-4 3 3 5-6 1.5 1.2L14.2 15.4 11 12.2 8.4 15z"/></svg>
            Quản lý
        </button>
    </div>
</main>
