@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container py-5 text-center">
    <div class="py-5">
        <i class="bi bi-shield-slash-fill text-danger display-1 mb-3"></i>
        <h2 class="fw-bold text-danger">Từ chối truy cập</h2>
        <p class="text-muted lead">Tài khoản của bạn không có đủ quyền hạn để truy cập vào chức năng hoặc kho hàng này.</p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 me-2">
                <i class="bi bi-house me-1"></i>Về Trang chủ
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4">
                <i class="bi bi-person me-1"></i>Đăng nhập tài khoản khác
            </a>
        </div>
    </div>
</div>
