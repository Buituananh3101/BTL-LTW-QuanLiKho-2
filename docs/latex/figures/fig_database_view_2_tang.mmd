    %% Định nghĩa Style
    classDef plus fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,rx:6px,ry:6px,font-size:14px;
    classDef minus fill:#ffebee,stroke:#c62828,stroke-width:2px,rx:6px,ry:6px,font-size:14px;
    classDef balance fill:#fff8e1,stroke:#f57f17,stroke-width:2px,rx:6px,ry:6px,font-size:14px;
    classDef tier1 fill:#e3f2fd,stroke:#1565c0,stroke-width:2.5px,rx:8px,ry:8px,font-size:15px;
