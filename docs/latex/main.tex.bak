\centering
\small
\renewcommand{\arraystretch}{1.3}
\begin{tabularx}{\textwidth}{|p{3.5cm}|Y|}
\hline
\rowcolor{gray!20}
\multicolumn{2}{|c|}{\textbf{Đặc tả Use Case UC-02: Chuyển kho nội bộ liên chi nhánh}} \\
\hline
\textbf{Tác nhân (Actor)} & Thủ kho, Quản lý \\
\hline
\textbf{Tiền điều kiện} & Hệ thống có ít nhất 2 chi nhánh kho đang hoạt động; mặt hàng chuyển còn tồn kho tại kho xuất. \\
\hline
\textbf{Luồng sự kiện chính} & 
1. Người dùng chọn 'Chuyển kho' $\rightarrow$ 'Tạo phiếu chuyển'.\newline
2. Chọn Kho chuyển (kho nguồn) và Kho nhận (kho đích).\newline
3. Thêm danh sách mặt hàng và số lượng chuyển.\newline
4. Hệ thống kiểm tra ràng buộc: Số lượng chuyển không được vượt quá số tồn hiện tại của kho nguồn.\newline
5. Người dùng bấm 'Hoàn thành'.\newline
6. Hệ thống thực thi Transaction: Trừ tồn kho nguồn, cộng tồn kho đích, sinh 2 dòng thẻ kho (chuyển xuất \& chuyển nhập) và cập nhật trạng thái \texttt{DA\_CHUYEN}. \\
\hline
\textbf{Luồng ngoại lệ} & 4a. Nếu số lượng chuyển > số lượng tồn kho nguồn: Hệ thống báo lỗi và chặn thao tác hoàn thành. \\
\hline
\textbf{Hậu điều kiện} & Tồn kho nguồn giảm, tồn kho đích tăng; tổng tồn toàn hệ thống không đổi. \\
\hline
\end{tabularx}
