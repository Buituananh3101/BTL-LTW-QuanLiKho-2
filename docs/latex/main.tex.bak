% ==========================================
% CHƯƠNG 1: TỔNG QUAN VỀ ĐỀ TÀI (MỤC 4.1)
% ==========================================
\chapter{TỔNG QUAN VỀ ĐỀ TÀI}

\section{Mô tả về hệ thống, các nghiệp vụ cơ bản}

\subsection{Bối cảnh thực tiễn của bài toán quản lý kho đa chi nhánh}
Trong mô hình kinh doanh phân phối và bán lẻ hiện đại, hệ thống kho bãi không chỉ đóng vai trò lưu trữ mà là trung tâm điều phối dòng chảy hàng hóa của toàn bộ doanh nghiệp. Việc quản lý thủ công qua sổ sách hoặc các file Excel rời rạc bộc lộ hàng loạt nhược điểm chí mạng:
\begin{itemize}
    \item \textbf{Lệch số liệu tồn kho:} Khi nhiều nhân viên tại các chi nhánh cùng thực hiện nhập, xuất hoặc điều chuyển hàng hóa đồng thời, file Excel rất dễ bị ghi đè, dẫn đến sai lệch nghiêm trọng giữa tồn kho sổ sách và tồn kho thực tế ngoài kệ.
    \item \textbf{Khó khăn trong kiểm soát thất thoát:} Không có cơ chế lưu vết (Audit Trail) chặt chẽ xem ai là người tạo phiếu, duyệt phiếu, sửa đổi vào thời gian nào.
    \item \textbf{Chậm trễ trong điều chuyển hàng hóa:} Thủ kho tại chi nhánh A không nắm được số lượng hàng sẵn có tại chi nhánh B để kịp thời đề xuất chuyển hàng khi khách có nhu cầu cấp bách.
\end{itemize}

\subsection{Triết lý thiết kế hệ thống theo mô hình KiotViet}
Để giải quyết triệt để những bất cập trên, hệ thống \textbf{``Website Quản Lý Kho Hàng Đa Chi Nhánh''} được thiết kế mô phỏng sát với thực tế vận hành của phần mềm KiotViet -- giải pháp quản trị bán hàng và kho phổ biến nhất tại Việt Nam.

Hệ thống được xây dựng trên 3 nguyên lý kiến trúc cốt lõi:
\begin{enumerate}
    \item \textbf{Trải nghiệm người dùng tinh gọn, tốc độ cao (Lego UI):} Tái sử dụng tối đa các khối giao diện dùng chung (\texttt{\_Pagination}, \texttt{\_KiotDateFilter}, \texttt{\_KiotMultiSelectFilter}), hỗ trợ phím tắt chuyên nghiệp (F1 trợ giúp, F3 tìm kiếm nhanh, F4 thu gọn bộ lọc, Esc đóng nhanh popup).
    \item \textbf{Tính toán tồn kho động theo thời gian thực:} Tuyệt đối không lưu cột tồn kho tĩnh trên bảng vật lý để tránh lỗi bất đồng bộ (Race Condition). Mọi số liệu tồn kho đều được tính toán theo thời gian thực qua Database View.
    \item \textbf{Toàn vẹn và bất biến chứng từ:} Mọi giao dịch nhập, xuất, chuyển, cân bằng đều được bọc trong \texttt{Database.BeginTransactionAsync()}. Chứng từ đã hoàn thành bị khóa vĩnh viễn, không cho sửa/xóa tùy tiện.
\end{enumerate}

\subsection{Các nghiệp vụ cơ bản của hệ thống}
Hệ thống cung cấp 8 khối chức năng nghiệp vụ khép kín:
\begin{enumerate}
    \item \textbf{Quản lý danh mục hàng hóa:} Theo dõi mã hàng, mã vạch (Barcode), tên hàng, nhóm hàng, đơn vị tính, giá vốn, giá bán, vị trí kho, trọng lượng, thuộc tính phân loại và thiết lập định mức tồn tối thiểu -- tối đa để hệ thống tự động phát cảnh báo.
    \item \textbf{Quản lý chi nhánh kho:} Quản lý danh sách các điểm kho trong chuỗi, phân quyền nhân sự phụ trách từng kho và chuyển đổi ngữ cảnh làm việc tức thời qua Cookie \texttt{CurrentBranch}.
    \item \textbf{Giao dịch Nhập hàng từ Nhà cung cấp:} Lập phiếu nhập, quét mã vạch, tự động tính tổng tiền, chiết khấu và thuế VAT. Tự động cập nhật giá vốn bình quân gia quyền và tăng tồn kho ngay lập tức.
    \item \textbf{Giao dịch Trả hàng nhập:} Lập phiếu hoàn trả hàng lỗi/hỏng cho nhà cung cấp, tự động giảm trừ tồn kho và ghi nhận giảm công nợ.
    \item \textbf{Giao dịch Xuất hủy hàng hóa:} Xử lý hàng hóa hư hỏng, hết hạn, hao hụt trong quá trình bảo quản; ghi rõ lý do xuất hủy và giảm trừ tồn kho chi nhánh.
    \item \textbf{Nghiệp vụ Chuyển kho nội bộ:} Hỗ trợ điều chuyển hàng hóa giữa 2 chi nhánh kho trong hệ thống. Tự động kiểm tra tồn kho nguồn trước khi cho phép xuất và cập nhật tồn kho 2 đầu an toàn.
    \item \textbf{Nghiệp vụ Kiểm kho \& Cân bằng kho tự động (Trọng tâm):} Kiểm đếm thực tế so với tồn sổ sách. Khi thực hiện Cân bằng kho, hệ thống tự sinh phiếu điều chỉnh kho tương ứng, cập nhật số tồn thực tế và khóa vĩnh viễn phiếu kiểm kê.
    \item \textbf{Báo cáo Tồn kho \& Thẻ kho chuyên sâu:} Cung cấp Báo cáo Tồn kho dạng Pivot đa chi nhánh và Báo cáo Thẻ kho tịnh tiến lũy kế chi tiết từng dòng phát sinh, hỗ trợ xuất file Excel ClosedXML.
\end{enumerate}

\section{Khảo sát, phân tích yêu cầu để xác định các chức năng cho các lớp người dùng}

\subsection{Phương pháp khảo sát hiện trạng}
Nhóm đã tiến hành khảo sát thực tế quy trình tác nghiệp tại các chuỗi cửa hàng và kho vận phân phối. Kết quả khảo sát chỉ ra rằng để đảm bảo an toàn số liệu và tối ưu hóa năng suất lao động, hệ thống bắt buộc phải phân tách quyền hạn thành 3 lớp người dùng độc lập:

\begin{itemize}
    \item \textbf{Lớp 1 -- Quản lý (Admin / Branch Director):} Chủ doanh nghiệp hoặc người quản lý cấp cao. Có toàn quyền trên tất cả các chi nhánh kho trong hệ thống; quản lý danh mục nhân viên, cấu hình kho, duyệt điều chỉnh kiểm kho, xem toàn bộ báo cáo và xuất Excel.
    \item \textbf{Lớp 2 -- Thủ kho (Warehouse Manager):} Phụ trách trực tiếp tại một hoặc một số chi nhánh kho được giao. Thao tác lập và hoàn tất phiếu nhập hàng, trả hàng, xuất hủy, chuyển kho; theo dõi thẻ kho và tồn kho thuộc chi nhánh mình quản lý.
    \item \textbf{Lớp 3 -- Nhân viên kho (Warehouse Staff):} Nhân sự làm việc trực tiếp tại mặt bằng kho. Có nhiệm vụ kiểm đếm hàng hóa thực tế để lập phiếu kiểm kê kho; xem số lượng tồn kho hiện tại để đối chiếu. Bị ẩn thông tin giá vốn nhằm bảo mật tài chính doanh nghiệp.
\end{itemize}

\subsection{Ma trận phân quyền chức năng}
Bảng~\ref{tab:ma_tran_quyen} thể hiện chi tiết ma trận phân quyền giữa 3 lớp người dùng:

