{
  "latex-workshop.latex.tools": [
    {
      "name": "xelatex",
      "command": "D:/MiKTeX/miktex/bin/x64/xelatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "pdflatex",
      "command": "D:/MiKTeX/miktex/bin/x64/pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "XeLaTeX ➔ View PDF",
      "tools": [
        "xelatex",
        "xelatex"
      ]
    },
    {
      "name": "pdfLaTeX ➔ View PDF",
      "tools": [
        "pdflatex",
        "pdflatex"
      ]
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.clean.subfolder.enabled": true
}
